description="Play the classic two-player boardgame of chess."
url="https://wiki.gnome.org/App/Chess"

license="GPL-3.0-or-later"

packager="spiky <spiky@nutyx.org>"
contributors="Fanch,Jayce,Tnut"

set=(gnome-extra)

makedepends=(meson ninja hicolor-icon-theme gtk4 librsvg libadwaita)
run=(gsettings-desktop-schemas desktop-file-utils gtk-update-icon-cache gnuchess)

name=gnome-chess
version=50.1

source=(https://gitlab.gnome.org/GNOME/$name/-/archive/$version/$name-$version.tar.bz2)

build=meson

package() {
 install -Dm644 $name-$version/COPYING \
 $PKG/usr/share/licenses/$name/COPYING
}
