description="Web content engine for GTK"
url="https://webkitgtk.org"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(openjpeg ninja enchant cmake gstreamer gstreamer-plugins-base
             gstreamer-plugins-bad xorg-libxt gtk3 gtk-doc
             hunspell hyphen icu libgudev libsecret libsoup3 sysprof
             libwebp mesa ruby sqlite enchant geoclue2 libavif libmanette
             gobject-introspection hicolor-icon-theme llvm wpebackend-fdo
             harfbuzz gtk-doc libnotify wayland woff2 unifdef)

name=webkit2gtk-4
version=2.50.5

source=(https://webkitgtk.org/releases/webkitgtk-$version.tar.xz)

export NINJAJOBS=15

prepare() {
cd webkitgtk-$version

sed '/U_SHOW_CPLUSPLUS_API/a#define U_SHOW_CPLUSPLUS_HEADER_API 0' \
    -i Source/WTF/wtf/Platform.h
}

build() {
cd webkitgtk-$version

mkdir -p build
cd       build

CFLAGS=-Wno-expansion-to-defined   \
CXXFLAGS=-Wno-expansion-to-defined \
cmake -G Ninja                     \
      -DCMAKE_BUILD_TYPE=Release   \
      -DCMAKE_INSTALL_PREFIX=/usr  \
      -DCMAKE_SKIP_RPATH=ON        \
      -DPORT=GTK                   \
      -DLIB_INSTALL_DIR=/usr/lib   \
      -DUSE_LIBHYPHEN=OFF          \
      -DENABLE_MINIBROWSER=ON      \
      -DUSE_WOFF2=ON               \
      -DUSE_GTK4=OFF               \
      -DUSE_soup2=OFF              \
      -DUSE_LIBBACKTRACE=OFF       \
      -DUSE_JPEGXL=OFF             \
      -DENABLE_GTKDOC=ON           \
      -D ENABLE_DOCUMENTATION=OFF  \
      -DUSE_WPE_RENDERER=OFF       \
      -DENABLE_BUBBLEWRAP_SANDBOX=OFF \
      -DUSE_GSTREAMER_TRANSCODER=OFF \
      -D ENABLE_GAMEPAD=OFF        \
      -D ENABLE_SPEECH_SYNTHESIS=OFF \
      -Wno-dev ..

ninja || ninja -j1
DESTDIR=$PKG ninja install || DESTDIR=$PKG ninja -j1 install

install -vdm755 $PKG/usr/share/gtk-doc/html/webkit{2,web-process-extension}gtk-6.0
install -vm644  ../Documentation/webkitgtk-6.0/* \
$PKG/usr/share/gtk-doc/html/webkit2gtk-6.0
install -vm644  ../Documentation/webkitgtk-web-process-extension-6.0/* \
$PKG/usr/share/gtk-doc/html/webkit2gtk-6.0

# Binaries belongs to webkitgtk package
# No conflics please !!! :)
rm -rf $PKG/usr/bin
}
