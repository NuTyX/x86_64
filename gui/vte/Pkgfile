description="Vte is a library (libvte) implementing a terminal emulator widget for GTK+ 3"
url="https://wiki.gnome.org/Apps/Terminal/VTE"

license="GPL-3.0-or-later, LGPL-3.0-or-later"

packager="spiky <spiky@nutyx.org>"
contributors="Greg,Pierre,Jayce,Skythrew,Tnut"

makedepends=(pcre2 gnutls vala gtk3 gtk4 perl-xml-parser gobject-introspection fast_float)

name=vte
version=0.80.3

prepare() {
git clone https://gitlab.gnome.org/GNOME/vte.git
cd $name
git checkout $version
}

build() {
cd $name
mkdir build
cd    build

meson  --prefix=/usr \
--sysconfdir=/etc \
-Dfribidi=false   \
-Dgtk4=true

ninja

DESTDIR=$PKG ninja install
}
