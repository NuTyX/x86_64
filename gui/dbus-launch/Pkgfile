description="Freedesktop.org message bus system"
url="https://www.freedesktop.org/wiki/Software/dbus/"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Jayce,Tnut"

makedepends=(expat xorg-libx11)

name=dbus-launch
_name=dbus
version=1.14.10
release=3

source=(http://dbus.freedesktop.org/releases/dbus/${_name}-$version.tar.xz)

build() {
	cd ${_name}-$version
	./configure --prefix=/usr                     \
            --sysconfdir=/etc                     \
            --localstatedir=/var                  \
            --disable-doxygen-docs                \
            --disable-xml-docs                    \
            --disable-static                      \
            --docdir=/usr/share/doc/dbus-$version \
            --with-console-auth-dir=/run/console  \
            --with-system-pid-file=/run/dbus/pid  \
	    --with-system-socket=/run/dbus/system_bus_socket \
	    --with-systemdsystemunitdir=/lib/systemd/system  \
	    --disable-systemd
	make -C dbus
	make -C tools dbus-launch
	mkdir -p $PKG/usr/bin
	/usr/bin/install -c tools/.libs/dbus-launch $PKG/usr/bin/dbus-launch
}
