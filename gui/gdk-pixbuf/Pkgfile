description="Toolkit for image loading and pixel buffer manipulation."
url="https://wiki.gnome.org/Projects/GdkPixbuf"

contributors="Greg,Pierre,Jayce,Spiky"
packager="tnut <tnut@nutyx.org>"

makedepends=(gobject-introspection meson ninja
            lcms2 xorg-fontconfig libseccomp libglycin)
run=(shared-mime-info)

name=gdk-pixbuf
version=2.44.4
release=3

source=(https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz)

PKGMK_MESON_OPTIONS="-Dbuiltin_loaders=glycin -Dthumbnailer=disabled \
-Dpng=disabled -Dtiff=disabled -Djpeg=disabled -Dgif=disabled -D installed_tests=false \
-Dothers=enabled --wrap-mode=nofallback"

build=meson
