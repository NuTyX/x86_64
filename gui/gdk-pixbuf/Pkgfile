description="Toolkit for image loading and pixel buffer manipulation."
url="https://wiki.gnome.org/Projects/GdkPixbuf"

contributors="Greg,Pierre,Jayce,Tnut"
packager="spiky <spiky@nutyx.org>"

makedepends=(gobject-introspection meson ninja libtiff libjpeg-turbo
            lcms2 xorg-fontconfig libseccomp libpng)
run=(shared-mime-info)

name=gdk-pixbuf
version=2.44.7

source=(https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz)

PKGMK_MESON_OPTIONS="-D installed_tests=false -Dothers=enabled --wrap-mode=nofallback \
-D glycin=disabled"

build=meson
