description="GNOME standard icons"
url="https://gitlab.gnome.org/GNOME/adwaita-icon-theme"

license="LGPL3 CCPL:by-sa"

maintainer="https://linuxfromscratch.org/"
packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(meson ninja)
run=(hicolor-icon-theme gtk-update-icon-cache icon-naming-utils librsvg)
set=(gnome-base)

name=adwaita-icon-theme
version=50.0
release=3

source=(https://gitlab.gnome.org/GNOME/$name/-/archive/$version/$name-$version.tar.gz)

build=meson

package() {
install -Dm644 $name-$version/COPYING_LGPL $PKG/usr/share/licenses/$name/COPYING_LGPL
install -Dm644 $name-$version/COPYING_CCBYSA3 $PKG/usr/share/licenses/$name/COPYING_CCBYSA3
}
