description='Official Telegram Desktop client'
url="https://desktop.telegram.org"

license="GPL-3.0-or-later"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

name=telegram-desktop
version=7.2.9

makedepends=(python-setuptools abseil-cpp ada ffmpeg glib hunspell kcoreaddons
             libavif libjpeg-turbo libjxl pipewire libsrtp gperf qt6-base
             qt6-imageformats mesa expat libelf libglvnd libxcb wayland
             xorg-libdrm xorg-libx11 xorg-libxext xorg-libxshmfence xorg-libxxf86vm
             qt6-svg vulkan-headers boost pcre2 libffi protobuf libtg_owt
             openexr tlottie xxhash minizip openal openh264 opus rnnoise)
run=(tlottie hicolor-icon-theme shared-mime-info gtk-update-icon-cache desktop-file-utils)
source=(https://github.com/telegramdesktop/tdesktop/releases/download/v$version/tdesktop-$version-full.tar.gz)

prepare() {
  git clone https://github.com/tdlib/td.git
}   

build() {
  cmake -S td -B td/build \
   -DCMAKE_INSTALL_PREFIX=$PWD/td/install \
   -Wno-author -DTD_E2E_ONLY=ON
  cmake --build td/build
  cmake --install td/build

# API_HD and API_HASH are for the NuTyX Linux distribution
# Reserve. It's forbiden to pass thoses values to third parties

  cmake -B build -S tdesktop-$version-full \
   -G Ninja -DCMAKE_VERBOSE_MAKEFILE=ON \
   -DCMAKE_INSTALL_PREFIX="/usr" \
   -Dtde2e_DIR=$PWD/td/install/lib/cmake/tde2e \
   -DCMAKE_BUILD_TYPE=None \
   -DTDESKTOP_API_ID=35243569 \
   -DTDESKTOP_API_HASH=defb47b8d978d662206d1790be8655a9
 cmake --build build

 DESTDIR=$PKG cmake --install build
}
