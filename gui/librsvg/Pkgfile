description="Library and tools used to manipulate, convert and view Scalable Vector Graphic images."
url="https://gitlab.gnome.org/GNOME/librsvg"

liense="GPL2"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Tnut"

makedepends=(gdk-pixbuf pango vala rustc cargo-c
             gi-docgen python-docutils python-smartypants)

name=librsvg
version=2.62.3
release=2

source=($url.git)

PKGMK_MESON_OPTIONS="-Dtests=false -Ddocs=disabled -Dpixbuf-loader=enabled"
build=meson

package() {
install -Dm644 $name-$version/COPYING.LIB $PKG/usr/share/licenses/$name/COPYING.LIB
}
