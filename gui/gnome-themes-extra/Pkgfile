description="Default themes for the GNOME desktop"
url="https://git.gnome.org/browse/gnome-themes-standard/"

packager="tnut <tnut@nutyx.org>"
contributors="Fanch,Spiky"

makedepends=(gtk3 intltool librsvg)

set=(gnome)

name=gnome-themes-extra
version=3.28
release=7

source=(https://download.gnome.org/sources/$name/${version}/$name-$version.tar.xz)

build() {
  cd $name-$version
  ./configure --prefix=/usr  \
        --sysconfdir=/etc    \
        --localstatedir=/var \
        --disable-gtk2-engine
  make
  make DESTDIR=$PKG install
  make -C themes/HighContrast/gtk-2.0 DESTDIR=$PKG uninstall
  rm -d $PKG/usr/share/themes/HighContrast/gtk-2.0
}
