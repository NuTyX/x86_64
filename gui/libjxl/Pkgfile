description='JPEG XL image format reference implementation'
url='https://jpeg.org/jpegxl/'

license="BSD-3-Clause"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

name=libjxl
version=0.11.1

makedepends=(cmake brotli giflib highway lcms2 libjpeg-turbo libpng highway)

source=(https://github.com/$name/$name/archive/v$version/$name-$version.tar.gz)
build() {

  mkdir build
  cd    build

  cmake -D CMAKE_INSTALL_PREFIX=/usr             \
        -D CMAKE_BUILD_TYPE=Release              \
        -D BUILD_TESTING=OFF                     \
        -D BUILD_SHARED_LIBS=ON                  \
        -D JPEGXL_ENABLE_SKCMS=OFF               \
        -D JPEGXL_ENABLE_SJPEG=OFF               \
        -D JPEGXL_ENABLE_PLUGINS=OFF             \
        -D JPEGXL_INSTALL_JARDIR=/usr/share/java \
        -G Ninja ../$name-$version

  ninja

  DESTDIR=$PKG ninja install
}
