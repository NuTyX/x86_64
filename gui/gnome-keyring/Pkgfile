description="GNOME Password Management daemon"
url="https://gitlab.gnome.org/GNOME/gnome-keyring"

license="GPL2.0"
license="LGPL2.1"

packager="tnut <tnut@nutyx.org>"
contributors="Fanch,Jayce,Spiky"

makedepends=(dbus gcr pam libxslt libcap-ng gnupg openssh valgrind)

name=gnome-keyring
version=50.0

set=(gnome)

source=($url/-/archive/$version/$name-$version.tar.gz)
PKGMK_MESON_OPTIONS="-Dssh-agent=true"

prepare() {
 sed -i 's:"/desktop:"/org:' $name-$version/schema/*.xml
}
build=meson

package() {
 install -Dm644 $name-$version/COPYING $PKG/usr/share/licenses/$name/COPYING
 install -Dm644 $name-$version/COPYING.LIB $PKG/usr/share/licenses/$name/COPYING.LIB
}
