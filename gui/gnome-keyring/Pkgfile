description="GNOME Password Management daemon"
url="http://www.gnome.org/"

license="GPL2.0"
license="LGPL2.1"

packager="spiky <spiky@nutyx.org>"
contributors="Fanch,Jayce,Tnut"

makedepends=(dbus gcr pam libxslt libcap-ng gnupg openssh valgrind)

name=gnome-keyring
version=48.0

set=(gnome)

source=(https://gitlab.gnome.org/GNOME/gnome-keyring/-/archive/$version/$name-$version.tar.gz)


build() {
cd $name-$version

sed -i 's:"/desktop:"/org:' schema/*.xml

mkdir build-gkr
cd    build-gkr

meson setup .. \
     --prefix=/usr \
     --buildtype=release \
     -D ssh-agent=true

ninja

DESTDIR=$PKG ninja install

install -Dm644 ../COPYING $PKG/usr/share/licenses/$name/COPYING
install -Dm644 ../COPYING.LIB $PKG/usr/share/licenses/$name/COPYING.LIB
}
