description="A simple, fast, cross-platform, and object-oriented multimedia API"
url="https://www.sfml-dev.org/"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(mesa cmake doxygen systemd libsndfile xorg-xrandr
             openal glew freetype xorg-libx11 ninja)

name=sfml
version=3.0.2
release=2

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/SFML/SFML/archive/$version.tar.gz)

build() {
  cmake -B build       \
      -S SFML-$version \
      -G Ninja         \
      -DCMAKE_INSTALL_PREFIX=/usr       \
      -DSFML_USE_SYSTEM_DEPS=ON         \
      -DSFML_BUILD_EXAMPLES=ON          \
      -DSFML_BUILD_DOC=ON               \
      -DSFML_INSTALL_PKGCONFIG_FILES=ON \
      -DBUILD_SHARED_LIBS=ON            \
      -DSFML_PKGCONFIG_INSTALL_DIR=/usr/lib/pkgconfig
  ninja -C build
  ninja -C build doc
  
  DESTDIR=$PKG/ ninja -C build install
  install -Dm644 SFML-$version/license.md \
  $PKG/usr/share/licenses/$name/LICENSE
}
