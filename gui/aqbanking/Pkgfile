description="A library for online banking and financial applications"
url="https://www.aquamaniac.de/rdm/projects/aqbanking"

license="GPL"

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"

makedepends=(tar gwenhywfar xmlsec)

name=aqbanking
version=6.9.2

source=(https://www.aquamaniac.de/rdm/attachments/download/654/$name-$version.tar.gz)

build() {
cd $name-$version
export PKG_CONFIG=/usr/bin/pkg-config
./configure --prefix=/usr --enable-gwenhywfar
make
make DESTDIR=$PKG install
}
