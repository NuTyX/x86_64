. lib/lsb/init-functions
systemctl enable cups
if [ ! -f /etc/cups/client.conf ]; then
  echo "ServerName /run/cups/cups.sock" > /etc/cups/client.conf
  log_success_msg "${WARNING} /etc/cups/client.conf created ${NORMAL}"
  log_warning_msg "${WARNING} Double check /etc/cups/client.conf and adapted to your needs ${NORMAL}"
fi
