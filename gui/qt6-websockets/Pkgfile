description='A cross-platform application and UI framework, QtWebsokets files'
url='https://www.qt.io/'

license="GPL3, LGPL3, FDL, Custom"

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"

makedepends=(qt6-base cmake qt6-declarative)

set=(qt6)

name=qt6-websockets
version=6.10.1

source=(
https://download.qt.io/official_releases/qt/${version%.*}/$version/submodules/qtwebsockets-everywhere-src-$version.tar.xz)

build() {

cmake -S qtwebsockets-everywhere-src-$version -B build -G Ninja
 cmake --build build
 DESTDIR=$PKG cmake --install build
}
