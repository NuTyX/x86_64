description='A C++ library to decode QRCode'
url='https://github.com/nu-book/zxing-cpp'

license="Apache"

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"

name=zxing-cpp
version=3.0.2

makedepends=(cmake opencv stb zint)

source=(https://github.com/nu-book/zxing-cpp/archive/v$version/$name-$version.tar.gz
        system-stb.patch)

prepare() {
cd $name-$version
patch -Np1 -i ../system-stb.patch
}


build() {
  cmake -B build -S $name-$version \
   -DCMAKE_INSTALL_PREFIX=/usr \
   -D CMAKE_INSTALL_LIBDIR=lib \
   -DCMAKE_BUILD_TYPE=Release \
   -D ZXING_USE_BUNDLED_ZINT=OFF \
   -DBUILD_EXAMPLES=OFF \
   -DBUILD_UNIT_TESTS=OFF
  cmake --build build

  DESTDIR=$PKG cmake --install build
}
