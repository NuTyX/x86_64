description='Barcode encoding library supporting over 50 symbologies'
url='https://zint.org.uk/'

packager="spiky <spiky@nutyx.org>"
contributors=""

makedepends=(cmake qt6-tools qt6-svg libpng)

name=zint
version=2.16.0

source=(https://github.com/zint/zint/archive/$version/$name-$version.tar.gz)

build() {
cmake -B build -S $name-$version \
   -DCMAKE_INSTALL_PREFIX=/usr \
   -D CMAKE_INSTALL_LIBDIR=lib \
   -DCMAKE_BUILD_TYPE=Release \
   -DZINT_QT6=ON
  cmake --build build

  DESTDIR=$PKG cmake --install build

  install -Dm644 $name-$version/zint-qt.png $PKG/usr/share/icons/hicolor/48x48/apps/zint-qt.png
  install -Dm644 $name-$version/zint-qt.desktop $PKG/usr/share/applications/zint-qt.desktop
}
