description="A help browser for viewing help files."
url="http://www.gnome.org/"

license="GPL2"

packager="spiky <spiky@nutyx.org>"
contributors="Greg,Tnut"

makedepends=(meson
itstool intltool gtk-doc libxslt webkit2gtk-4 yelp-xsl gsettings-desktop-schemas libhandy)
run=(desktop-file-utils hicolor-icon-theme )

name=yelp
version=42.3

source=(https://gitlab.gnome.org/GNOME/yelp/-/archive/$version/yelp-$version.tar.gz)

build() {

cd $name-$version

mkdir build
cd    build

meson setup .. \
     --prefix=/usr          \
     --buildtype=release

ninja

DESTDIR=$PKG ninja install

install -Dm644 ../COPYING $PKG/usr/share/licenses/$name/COPYING

}
