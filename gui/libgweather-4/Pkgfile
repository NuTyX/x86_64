description="Location and timezone database and weather-lookup library"
url="https://wiki.gnome.org/Projects/LibGWeather"

license="GPL2"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(geocode-glib gobject-introspection libsoup3 meson ninja
             vala python-gobject gi-docgen)
run=(gtk-update-icon-cache gweather-locations)

name=libgweather-4
version=4.6.0
release=2

source=(https://gitlab.gnome.org/GNOME/libgweather/-/archive/$version/libgweather-$version.tar.gz)
PKGMK_MESON_OPTIONS="-Dgtk_doc=false"


prepare() {
mv libgweather-$version $name-$version
}

build=meson

package() {
 install -Dm644 $name-$version/COPYING \
 $PKG/usr/share/licenses/$name/COPYING
}
