description="GStreamer Multimedia Framework Bad Plugins"
url="http://gstreamer.freedesktop.org/modules/gst-plugins-base.html"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Tnut"

license="LGPL"

makedepends=(pkgconf meson ninja gstreamer-plugins-base libdvdread libdvdnav
             faac faad2 libexif libmpeg2 mpg123 libnice libsoup3 soundtouch webrtc-audio-processing)

name=gstreamer-plugins-bad
version=1.28.4
release=1
_name=gst-plugins-bad

source=(https://gstreamer.freedesktop.org/src/${_name}/${_name}-$version.tar.xz )

PKGMK_MESON_OPTION="-Dgpl=enabled \
-Dpackage-origin=http://downloads.nutyx.org/"

prepare() {
 mv ${_name}-$version $name-$version
}
build=meson

package() {
 install -Dm644 $name-$version/COPYING \
 $PKG/usr/share/licenses/$name/COPYING
}
