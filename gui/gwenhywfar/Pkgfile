description="OS abstraction functions for various projects"
url="https://www.aquamaniac.de/rdm/"

license="LGPL"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(gnutls libgcrypt openssl gtk3)

name=gwenhywfar
version=5.12.1

source=(https://www.aquamaniac.de/rdm/attachments/download/533/$name-$version.tar.gz)

build() {
cd $name-$version 
GPGRT_CONFIG="/usr/bin/gpgrt-config" \
./configure --prefix=/usr \
--sysconfdir=/etc \
--enable-system-certs \
--with-guis="gtk3"
make
make DESTDIR=$PKG install

install -Dm644 COPYING $PKG/usr/share/licenses/$name/COPYING
}
