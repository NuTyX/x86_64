description="OS abstraction functions for various projects"
url="https://www.aquamaniac.de/rdm/"

license="LGPL"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(gnutls libgcrypt openssl gtk3)

name=gwenhywfar
version=5.12.0

source=(0001-Prepare-.pc-and-.cmake-for-static-builds.patch
        https://www.aquamaniac.de/rdm/attachments/download/501/$name-$version.tar.gz)
prepare() {
  cd $name-$version
  patch -Np1 -i ../0001-Prepare-.pc-and-.cmake-for-static-builds.patch
  autoreconf -fiv
}
build() {
cd $name-$version 
./configure --prefix=/usr \
--sysconfdir=/etc \
--enable-system-certs \
--with-guis="gtk3"
make
make DESTDIR=$PKG install

install -Dm644 COPYING $PKG/usr/share/licenses/$name/COPYING
}
