description='Allows Qt Quick to operate on Vulkan, Metal, and Direct3D, in addition to OpenGL'
url='https://www.qt.io/'

license="GPL3, LGPL3, FDL, Custom"

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"

set=(qt6)

name=qt6-shadertools
version=6.10.1

makedepends=(cmake ninja qt6-base)

source=(https://download.qt.io/official_releases/qt/${version:0:4}/$version/submodules/qtshadertools-everywhere-src-$version.tar.xz)

build() {
 cmake -S qtshadertools-everywhere-src-$version -B build -G Ninja
 cmake --build build
 DESTDIR=$PKG cmake --install build
}
devel() {
  cd $PKG
  bsdtar -cf \
  $PKGMK_PACKAGE_DIR/$name.devel${PKGMK_PACKAGE_EXT}$version-$release \
  usr/include \
  usr/lib/qt6/mkspecs \
  usr/lib/cmake/
  
  rm -r usr/include usr/lib/qt6/mkspecs \
  usr/lib/cmake
}
