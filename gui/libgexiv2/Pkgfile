description="GObject-based Wrapper around Exiv2 library."
url="https://exiv2.org"

license="GPL2"

packager="spiky <spiky@nutyx.org>"
contributor="Jayce, Spiky"

makedepends=(meson ninja exiv2 vala gobject-introspection python-gobject)

name=libgexiv2
version=0.14.7

source=(https://download.gnome.org/sources/${name/lib/}/${version%.*}/${name/lib/}-$version.tar.xz)

prepare() {
 mv gexiv2-$version $name-$version
}

build=meson

package() {
 install -Dm644 $name-$version/COPYING \
 $PKG/usr/share/licenses/$name/COPYING
}
