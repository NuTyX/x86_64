description="Python CUPS Bindings"
url="http://cyberelk.net/tim/software/pycups/"

packager="spiky <spiky@nutyx.org>"
contributors="Alienus,Tnut"

makedepends=(cups python-setuptools)
run=(python python-requests)

name=python-cups
_name=pycups

version=2.0.4

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/OpenPrinting/pycups/releases/download/v$version/${_name}-$version.tar.gz)

build() {

      cd ${_name}-$version

  pip3 wheel -w dist \
    --no-build-isolation \
    --no-deps $PWD
  pip3 install --no-index \
    --find-links dist \
    --no-cache-dir    \
    --no-user         \
    --root=$PKG       \
    ${_name}

 find $PKG -type d -name vendor -o -name tests |xargs rm -rf 
}
