description="Utility for network discovery and security auditing"
url="http://insecure.org/nmap/"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Tnut"

makedepends=(python-setuptools python-build 
             python-gobject pcre2 lua libpcap liblinear)
run=()

name=nmap
version=7.99

source=(http://download.insecure.org/nmap/dist/$name-$version.tgz)

prepare() {
cd $name-$version

sed -ri Makefile.in \
    -e 's#-m build#& --no-isolation#'  \
    -e '/pip install/s#(ZENMAP|NDIFF)DIR\)/#&dist/*.whl#'
sed 's/, "setuptools-gettext"//' -i zenmap/pyproject.toml
sed '/py-modules/s/f"/&, "Version"/' -i ndiff/pyproject.toml
}

build() {
cd $name-$version
./configure --prefix=/usr \
--mandir=/usr/share/man \
--localedir=/usr/share/locale \
--docdir=/usr/share/doc/$name-$version \
--with-liblua=included \
--infodir=/usr/share/info
make || make -j1
make DESTDIR=$PKG install
}
