description='Qt speech support'
url='https://www.qt.io/'

license="GPL3, LGPL3, FDL, Custom"

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"

set=(qt6)

name=qt6-speech
version=6.9.1

makedepends=(cmake ninja qt6-base qt6-declarative qt6-multimedia
             speech-dispatcher)

source=(
https://download.qt.io/official_releases/qt/${version:0:3}/$version/submodules/qtspeech-everywhere-src-$version.tar.xz)

build() {
 cmake -S qtspeech-everywhere-src-$version -B build -G Ninja
 cmake --build build
 DESTDIR=$PKG cmake --install build
}
devel() {
  cd $PKG
  bsdtar -cf \
  $PKGMK_PACKAGE_DIR/$name.devel${PKGMK_PACKAGE_EXT}$version-$release \
  usr/include \
  usr/lib/qt6/mkspecs \
  usr/lib/cmake/
  
  rm -r usr/include usr/lib/qt6/mkspecs \
  usr/lib/cmake
}
