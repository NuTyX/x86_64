description="libSM, library X11 Session Management client"
url="https://xorg.freedesktop.org"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre,Greg,Spiky"

name=xorg-libsm
version=1.2.6
release=1

_name=libSM
alias=(libSM libsm)

makedepends=(xorgproto xorg-libice xorg-xtrans)

source=($url/releases/individual/lib/${_name}-$version.tar.xz)

build=xorg

package() {
rm $PKG/usr/lib/${_name}.la
}

uptodate() {
local ext url name LINX
LYNX="lynx -read_timeout=20 -dump -listonly -nonumbers "
ext=".tar.bz2"
url="https://ftp.x.org/archive//individual//lib"
name="libSM-"
$LYNX $url/?C=M\;O=D|grep "$ext$"|grep "$url/$name"|sed "s@$ext\$@@"|sed "s@$url/$name@@"|head -1
}
