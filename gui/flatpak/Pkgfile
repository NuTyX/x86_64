description='Next generation technology for building and distributing desktop applications'
url='https://flatpak.org/'

license="LGPL"

packager="tnut <tnut@nutyx.org>"
contributors="Fabienwang,Spiky"

makedepends=(glib libsoup3 gpgme polkit fuse2 libostree json-glib
             appstream libseccomp python-parsing socat)
run=(make-ca bubblewrap gnupg xdg-dbus-proxy)

name=flatpak
version=1.16.3
release=3

PKGMK_GROUPS=(devel doc man)

source=(https://dl.flathub.org/repo/flathub.flatpakrepo flatpak-bindir.sh
        https://github.com/flatpak/flatpak/releases/download/$version/flatpak-$version.tar.xz)

PKGMK_MESON_OPTIONS="-Dsystem_bubblewrap=bwrap -Dsystem_dbus_proxy=xdg-dbus-proxy \
-Dtests=false -Ddbus_config_dir=/usr/share/dbus-1/system.d -Dselinux_module=disabled"

build=meson

prepare() {
  localedef -i C -f UTF-8 /usr/lib/locale/C.UTF-8 #Never complain, never explain
}

package() {
install -Dm644 flathub.flatpakrepo \
  $PKG/etc/flatpak/remotes.d/flathub.flatpakrepo
install -Dm644 flatpak-bindir.sh \
  $PKG/etc/profile.d/flatpak-bindir.sh
}
