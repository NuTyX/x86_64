description="X11 Screen Saver extension library"
url="https://gitlab.freedesktop.org/xorg/lib/libxscrnsaver"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre,Greg,Spiky"

name=xorg-libxscrnsaver
version=1.2.5
release=1

alias=(libXScrnSaver libxscrnsaver libxss)

_name=libXScrnSaver

makedepends=(xorgproto xorg-libx11 xorg-libxext)

source=(https://xorg.freedesktop.org/releases/individual/lib/libXScrnSaver-$version.tar.xz)

build=xorg

package() {
rm $PKG/usr/lib/libXss.la
}
uptodate() {
local ext url name LINX
LYNX="lynx -read_timeout=20 -dump -listonly -nonumbers "
ext=".tar.bz2"
url="https://ftp.x.org/archive//individual//lib"
name="libXScrnSaver-"
$LYNX $url/?C=M\;O=D|grep "$ext$"|grep "$url/$name"|sed "s@$ext\$@@"|sed "s@$url/$name@@"|head -1
}
