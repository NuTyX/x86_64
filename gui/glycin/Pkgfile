description="Sandboxed and extendable image loading framework loaders. "
url="https://gnome.pages.gitlab.gnome.org/glycin/"

license="MPL-2.0 OR LGPL-2.1-or-later"

packager="tnut <tnut@nutyx.org>"
contributors=""

makedepends=(meson ninja xorg-fontconfig gobject-introspection
             rustc libseccomp lcms2 libheif libjxl vala gtk4)

run=(libglycin)

name=glycin
version=2.0.7

source=(https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz)

build=meson

package() {
 # part of libglycin
 rm -r $PKG/usr/lib/libglycin-2.so*
 rm -r $PKG/usr/include/glycin-2
 rm -r $PKG/usr/lib/pkgconfig/glycin-2.pc
}
