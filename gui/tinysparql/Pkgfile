description='Tinysparql is a low-footprint RDF triple store with a SPARQL 1.1 interface'
url='https://gitlab.gnome.org/GNOME/tinysparql'

license="LGPLv2.1+"

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"

makedepends=(git json-glib vala icu libsoup3 python-gobject asciidoc gi-docgen)
run=()

name=tinysparql
version=3.11.1
release=2

source=($url.git)
PKGMK_GROUPS=(devel doc man)

build=meson

package() {
 install -Dm644 $name-$version/COPYING \
 $PKG/usr/share/licenses/$name/COPYING
 install -Dm644 $name-$version/COPYING.LGPL \
 $PKG/usr/share/licenses/$name/COPYING.LGPL
 install -Dm644 $name-$version/COPYING.GPL \
 $PKG/usr/share/licenses/$name/COPYING.GPL
}
