description='Tinysparql is a low-footprint RDF triple store with a SPARQL 1.1 interface'
url='https://download.gnome.org/sources/tinysparql'

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(json-glib vala icu libsoup3 python-gobject asciidoc gi-docgen)
run=()

name=tinysparql
version=3.10.1

source=(https://download.gnome.org/sources/$name/${version:0:4}/$name-$version.tar.xz)

prepare() {
cd $name-$version

rm -fv /usr/lib/systemd/user/tracker-xdg-portal-3.service

sed -e "s/'generate'/&, '--no-namespace-dir'/"         \
    -e "/--output-dir/s/@OUTPUT@/&\/$name-$version/" \
    -i docs/reference/meson.build
}

build() {
cd $name-$version

mkdir build
cd    build

    meson setup --prefix /usr \
    --buildtype  release      \
    -D man=false              \
    -D systemd_user_services=false

ninja

DESTDIR=$PKG ninja install
}
