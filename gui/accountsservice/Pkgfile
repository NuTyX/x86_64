description="Accessing the list of user accounts and information attached to those accounts." 
url="https://gitlab.freedesktop.org/accountsservice/accountsservice"

packager="tnut <tnut@nutyx.org>"
contributors="Pierrei,Jayce,Spiky"

makedepends=(meson ninja xmlto libxslt polkit libxcrypt
             gobject-introspection vala json-c)

set=(gnome kde6)

name=accountsservice
version=26.12.8
release=2

PKGMK_GROUPS=(devel)
PKGMK_MESON_OPTIONS="-D admin_group=wheel"

source=($url/-/archive/$version/$name-$version.tar.bz2)

build=meson

package() { 
 install -d  $PKG/var/{lib,run}/polkit-1
 install -d $PKG/usr/share/accountsservice/interfaces
}
