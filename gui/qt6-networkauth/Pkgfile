description='Network authentication module'
url='https://www.qt.io/'

license="FDL,GPL3,LGPL3,custom"

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"

set=(qt6)

name=qt6-networkauth
version=6.11.2
release=1

makedepends=(cmake ninja qt6-base)

source=(
https://download.qt.io/official_releases/qt/${version:0:4}/$version/submodules/qtnetworkauth-everywhere-src-$version.tar.xz)

build() {
 cmake -S qtnetworkauth-everywhere-src-$version -B build -G Ninja
 cmake --build build
 DESTDIR=$PKG cmake --install build
}
