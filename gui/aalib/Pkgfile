description="AAlib is an portable ascii art GFX library."
url="https://aa-project.sourceforge.net/aalib"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre B"

makedepends=(autoconf m4 slang gpm xorg-libx11)

name=aalib
version=1.4rc5
release=6

source=(consolidate-1.patch
        https://downloads.sourceforge.net/aa-project/aalib-1.4rc5.tar.gz)

prepare() {
 cd $name-*
 patch -Np1 -i ../consolidate-1.patch
 autoreconf -fi
}
build() {
cd aalib-*
sed -i -e '/AM_PATH_AALIB,/s/AM_PATH_AALIB/[&]/' aalib.m4

./configure --prefix=/usr \
 --mandir=/usr/share/man \
--infodir=/usr/share/info --disable-static
make
make  DESTDIR=$PKG install
# Obsolet lib
rm $PKG/usr/lib/libaa.la
}
