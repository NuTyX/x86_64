description="X11 RandR, resize and rotate extension client library"
url="https://xorg.freedesktop.org"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Greg,Tnut"

name=xorg-libxrandr
alias=(libXrandr libxrandr)
version=1.5.5

_name=libXrandr
makedepends=(xorgproto xorg-libx11 xorg-libxext xorg-libxrender)

source=($url/releases/individual/lib/${_name}-$version.tar.xz)

build=xorg

package() {
rm $PKG/usr/lib/${_name}.la
}
uptodate() {
local ext url name LINX
LYNX="lynx -read_timeout=20 -dump -listonly -nonumbers "
ext=".tar.bz2"
url="https://ftp.x.org/archive//individual//lib"
name="libXrandr-"
$LYNX $url/?C=M\;O=D|grep "$ext$"|grep "$url/$name"|sed "s@$ext\$@@"|sed "s@$url/$name@@"|head -1
}
