description="Library for generating documents in Open Document Format"
url="https://sourceforge.net/p/libwpd/wiki/libodfgen/"

license="LGPL-2.1-or-later OR MPL-2.0"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

name=libodfgen
version=0.1.8
release=1

makedepends=(librevenge libxml2)

source=(https://sourceforge.net/projects/libwpd/files/$name/$name-$version/$name-$version.tar.xz)

prepare() {
 sed -i "s/#include <math.h>/#include <math.h>\n#include <cstdint>/" \
 $name-$version/src/OdfGenerator.cxx
}

build() {
 cd $name-$version
 ./configure --prefix=/usr --disable-werror
 sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
 make
 make DESTDIR=$PKG install
}
