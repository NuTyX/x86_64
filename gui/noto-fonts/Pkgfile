description="Google Noto TTF fonts"
url="https://www.google.com/get/noto/"

license="Apache 2.0"

packager="spiky <spiky@nutyx.org>"
contributors="Fabien,Pierre,Tnut"

makedepends=(xorg-fontconfig)

name=noto-fonts
version=2025.04.01

source=(https://github.com/notofonts/notofonts.github.io/archive/refs/tags/noto-monthly-release-$version.tar.gz)

build() {
  cd notofonts.github.io-noto-monthly-release-$version

  mkdir -p $PKG/usr/share/fonts/noto
  install -Dm644 fonts/*/unhinted/ttf/Noto*.tt[fc] -t $PKG/usr/share/fonts/noto
  install -m644 fonts/*/hinted/ttf/Noto*.tt[fc] -t $PKG/usr/share/fonts/noto
}
