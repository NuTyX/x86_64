description='Provides access to position, satellite and area monitoring classes'
url='http://qt-project.org/'

license="GPL3, LGPL3, FDL, Custom"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(qt6-declarative qt6-serialport)

set=(qt6)

name=qt6-positioning
version=6.10.0

_name=${name/6-/}-everywhere-src

source=(
https://download.qt.io/official_releases/qt/${version:0:4}/$version/submodules/${_name}-$version.tar.xz)

build() {
 cmake -S ${_name}-$version -B build -G Ninja
 cmake --build build
 DESTDIR=$PKG cmake --install build
}

devel() {
  cd $PKG
  bsdtar -cf \
  $PKGMK_PACKAGE_DIR/$name.devel${PKGMK_PACKAGE_EXT}$version-$release \
  usr/include \
  usr/lib/qt6/mkspecs \
  usr/lib/cmake/

  rm -r usr/include usr/lib/qt6/mkspecs \
  usr/lib/cmake
}
