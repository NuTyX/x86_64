description="X11 keyboard file manipulation library"
url="https://gitlab.freedesktop.org/xorg/lib/libxkbfile"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre,Greg,Spiky"

name=xorg-libxkbfile
version=1.1.3
release=1

alias=(libxkbfile)

_name=libxkbfile
makedepends=(xorgproto xorg-libx11)

source=(https://xorg.freedesktop.org/releases/individual/lib/${_name}-$version.tar.xz)

build=xorg

package() {
rm $PKG/usr/lib/${_name}.la
}

uptodate() {
local ext url name LINX
LYNX="lynx -read_timeout=20 -dump -listonly -nonumbers "
ext=".tar.bz2"
url="https://ftp.x.org/archive//individual//lib"
name="libxkbfile-"
$LYNX $url/?C=M\;O=D|grep "$ext$"|grep "$url/$name"|sed "s@$ext\$@@"|sed "s@$url/$name@@"|head -1
}
