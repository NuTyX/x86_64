description='Plugins for additional image formats: TIFF, MNG, TGA, WBMP'
url='https://www.qt.io/'

license="GPL3 LGPL3 FDL Custom"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

set=(qt6)

name=qt6-imageformats
version=6.10.2

makedepends=(cmake ninja qt6-base
             jasper libmng libwebp )

source=(
https://download.qt.io/official_releases/qt/${version:0:4}/$version/submodules/qtimageformats-everywhere-src-$version.tar.xz)

build() {
 cmake -S qtimageformats-everywhere-src-$version -B build -G Ninja
 cmake --build build
 DESTDIR=$PKG cmake --install build
}
devel() {
  cd $PKG
  bsdtar -cf \
  $PKGMK_PACKAGE_DIR/$name.devel${PKGMK_PACKAGE_EXT}$version-$release \
  usr/lib/cmake
  
  rm -r usr/lib/cmake
}
