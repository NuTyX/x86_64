description="For creating and utilizing caches to speed up the manipulation for freedesktop.org defined application menus."
url="http://lxde.org/"

packager="spiky <spiky@nutyx.org>"
contributors="Geantbrun,Tnut"

makedepends=(libfm-extra gtk-doc)

name=menu-cache
version=1.1.1

source=(https://github.com/lxde/menu-cache/archive/$version/$name-$version.tar.gz)

build() {

cd $name-$version

 ./autogen.sh
./configure --prefix=/usr  --disable-static
make
make DESTDIR=$PKG install

# Obsolet lib
rm $PKG/usr/lib/libmenu-cache.la
}
