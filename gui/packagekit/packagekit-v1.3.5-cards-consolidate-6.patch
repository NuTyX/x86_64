+#include "job.h"
+
+#include <iostream>
+#include <sstream>
+#include <memory>
+#include <fstream>
+#include <dirent.h>
+
+Job::Job(PkBackendJob *job) :
+	m_cache(nullptr),
+	m_job(job),
+	m_cancel(false)
+{
+}
+Job::~Job()
+{
+	delete m_cache;
+	for (auto pkg : m_packagesSet) {
+		if (pkg)
+			delete pkg;
+	}
+}
+bool Job::init()
+{
+	m_cache = new cards::pkgrepo("/etc/cards.conf");
+	m_mapPackages = m_cache->getListOfPackages();
+
+	if (m_mapPackages.size() > 0)
+		return true;
+	return false;
+}
+void Job::cancel()
+{
+	if (!m_cancel) {
+		m_cancel = true;
+		pk_backend_job_set_status(m_job, PK_STATUS_ENUM_CANCEL);
+	}
+
+	if (m_child_pid > 0) {
+		kill(m_child_pid, SIGTERM);
+	}
+}
+
+bool Job::cancelled() const
+{
+	return m_cancel;
+}
+
+PkBackendJob *Job::pkJob() const
+{
+	return m_job;
+}
+PkGroupEnum
+Job::group_to_enum (const std::string& p)
+{
+	if (p.compare("doc"))
+		return PK_GROUP_ENUM_DOCUMENTATION;
+	else if ( p.compare("fr") ||
+			p.compare("de") ||
+			p.compare("es") ||
+			p.compare("it") ||
+			p.compare("pt") ||
+			p.compare("nl") ) // TODO find another solution not completed ATM
+		return PK_GROUP_ENUM_LOCALIZATION;
+	else if (p.compare("devel"))
+		return PK_GROUP_ENUM_PROGRAMMING;
+	else if (p.compare("kde6"))
+		return PK_GROUP_ENUM_DESKTOP_KDE;
+	else if (p.compare("xfce4") ||
+		p.compare("xfce4-extra"))
+		return PK_GROUP_ENUM_DESKTOP_XFCE;
+	else if (p.compare("gnome-base") ||
+		p.compare("gnome") ||
+		p.compare("gnome-extra"))
+		return PK_GROUP_ENUM_DESKTOP_GNOME;
+	else if (p.compare("service"))
+		return PK_GROUP_ENUM_SERVERS;
+	else if (p.compare("base"))
+		return PK_GROUP_ENUM_SYSTEM;
+	else
+		return PK_GROUP_ENUM_DESKTOP_OTHER;
+}
+
+void Job::resolvePackages()
+{
+	g_debug("resolvePackges Started");
+
+	pk_backend_job_set_status (m_job, PK_STATUS_ENUM_QUERY);
+
+	for (auto p : m_mapPackages) {
+		cards::cache* pkg = new cards::cache;
+		pkg->name(p.first);
+		pkg->description(p.second.description());
+		pkg->arch(p.second.arch());
+		pkg->version(p.second.version());
+		pkg->collection(p.second.collection());
+		if (p.second.group().empty()) {
+			if ( ! p.second.sets().empty()) {
+				for (auto s : p.second.sets()) {
+					pkg->group(s);
+					break;
+				}
+			} else
+				pkg->group(p.second.collection());
+		} else
+			pkg->group(p.second.group());
+		pkg->license("GPL2");
+		if ( ! p.second.license().empty())
+			pkg->license(p.second.license());
+		pkg->url(p.second.url());
+		pkg->space(p.second.space());
+		m_packagesSet.insert(pkg);
+
+	}
+}
+void Job::resolvePackageIds(gchar **package_ids)
+{
+	g_debug("resolvePackgesIds started");
+
+	pk_backend_job_set_status (m_job, PK_STATUS_ENUM_QUERY);
+
+	if (package_ids == NULL)
+		return;
+
+
+	for (uint i = 0; i < g_strv_length(package_ids); ++i) {
+		if (m_cancel)
+			break;
+		std::string pi;
+		if (pk_package_id_check(package_ids[i])) {
+			g_auto(GStrv) parts = pk_package_id_split(package_ids[i]);
+			pi = parts[PK_PACKAGE_ID_NAME];
+		} else {
+			pi = package_ids[i];
+		}
+		g_debug(package_ids[i]);
+		for (auto p : m_mapPackages) {
+
+			cards::cache* pkg = new cards::cache;
+
+			std::string::size_type pos;
+			pos = convertToLowerCase(p.second.collection()).find(convertToLowerCase(pi));
+			if (pos == std::string::npos)
+				pos = convertToLowerCase(p.first).find(convertToLowerCase(pi));
+			if (pos == std::string::npos)
+				pos = convertToLowerCase(p.second.description()).find(convertToLowerCase(pi));
+			if (pos == std::string::npos)
+				pos = convertToLowerCase(p.second.version()).find(convertToLowerCase(pi));
+			if (pos != std::string::npos){
+				pkg->name(p.first);
+				pkg->description(p.second.description());
+				pkg->arch(p.second.arch());
+				pkg->version(p.second.version());
+				pkg->collection(p.second.collection());
+				if (p.second.group().empty()) {
+					if ( ! p.second.sets().empty()) {
+						for (auto s : p.second.sets()) {
+							pkg->group(s);
+							break;
+						}
+					} else
+						pkg->group(p.second.collection());
+				} else
+					pkg->group(p.second.group());
+				pkg->license("GPL2");
+				if (!p.second.license().empty())
+					pkg->license(p.second.license());
+				pkg->url(p.second.url());
+				pkg->space(p.second.space());
+				pkg->size(p.second.size());
+				m_packagesSet.insert(pkg);
+			}
+		}
+	}
+}
+void Job::refreshCache()
+{
+	pk_backend_job_set_status(m_job, PK_STATUS_ENUM_REFRESH_CACHE);
+}
+void Job::emitPackageFiles(const gchar *pi)
+{
+	using namespace std;
+	GPtrArray *files;
+	string line;
+
+	g_auto(GStrv) parts = pk_package_id_split(pi);
+	string fName;
+	fName = "/var/lib/pkg/DB/" + string(parts[PK_PACKAGE_ID_NAME]) + "/files";
+
+	if (checkFileExist(fName)) {
+		ifstream in(fName.c_str());
+		if (!in != 0) {
+			return;
+		}
+
+		files = g_ptr_array_new_with_free_func(g_free);
+		while (in.eof() == false) {
+			getline(in, line);
+			if (!line.empty()) {
+				g_ptr_array_add(files, g_strdup(line.c_str()));
+			}
+		}
+
+		if (files->len) {
+			g_ptr_array_add(files, NULL);
+			pk_backend_job_files(m_job, pi, (gchar **) files->pdata);
+		}
+		g_ptr_array_unref(files);
+	}
+}
+void Job::emitPackages(PkBitfield filters, PkInfoEnum state)
+{
+	g_debug("emitPackages started");
+	pkgdbh dbh;
+	dbh.buildDatabase(false);
+
+	for (auto p : m_packagesSet) {
+		if(m_cancel)
+			break;
+
+		std::string c = p->collection();
+
+		if (state == PK_INFO_ENUM_UNKNOWN) {
+			state = PK_INFO_ENUM_AVAILABLE;
+			if (dbh.checkPackageNameExist(p->name())) {
+				state = PK_INFO_ENUM_INSTALLED;
+			}
+		}
+		if (dbh.checkPackageNameExist(p->name()))
+			c = "installed";
+
+		std::string pi = p->name() + ";" + p->version()
+			+ ";" + p->arch() + ";"
+			+ p->description().c_str();
+		pk_backend_job_package(m_job, state, pi.c_str(), p->description().c_str());
+	}
+}
+void Job::emitDetails()
+{
+
+	g_debug("emitDetails started");
+
+	for (auto p : m_packagesSet) {
+		if(m_cancel)
+			break;
+
+		std::string pi = p->name() + ";"
+			+ p->version() + ";" + p->arch()
+			+ ";" + p->collection();
+
+		pk_backend_job_details (m_job, pi.c_str(),
+			p->description().c_str(),
+			p->license().c_str(),
+			group_to_enum(p->group()),
+			"",
+			p->url().c_str(),
+			p->space(),
+			p->size());
+	}
+}
