description='A system designed to make installation and updates of packages easier'
url='https://www.freedesktop.org/software/PackageKit/'

name=packagekit
version=1.3.4
release=2

packager="tnut <tnut@nutyx.org>"
contributors=""

makedepends=(sqlite gobject-introspection vala polkit intltool gtk3
             meson ninja cards.lib git jansson python-setuptools
             bash-completion) 

source=(https://github.com/NuTyX/packagekit.git
        config.patch $name-$version-cards-1.tar.xz)
PKGMK_KEEP_SOURCES="no"
PKGMK_GROUPS=(devel man)
PKGMK_MESON_OPTIONS="-Dsystemd=true -Dpackaging_backend=cards \
-Dgstreamer_plugin=false -Dcron=false -Dgtk_doc=false \
-Dgtk_module=false -Dman_pages=false"

prepare() {
  cd $name-$version
  patch -Np1 -i ../config.patch
  mv ../backends/cards backends
}
build=meson
