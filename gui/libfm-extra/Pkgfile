description="contains a library and other files required by menu-cache-gen libexec of menu-cache"
url="http://pcmanfm.sourceforge.net/"

maintainer="git.lxde.org/gitweb/?p=debian/libfm.git;a=summary"
packager="spiky <spiky@nutyx.org>"
contributors="Geantbrun, tnut"

makedepends=(glib intltool perl-xml-parser gtk-doc)

name=libfm-extra
_name=libfm
version=1.4.0

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/lxde/libfm/archive/refs/tags/$version.tar.gz)

build() {
cd ${_name}-$version

./autogen.sh
./configure --prefix=/usr     \
            --sysconfdir=/etc \
            --with-extra-only \
            --with-gtk=no     \
            --disable-static
make 
make DESTDIR=$PKG install
rm $PKG/usr/lib/$name.la
}
