description="Blu-Ray access library."
url="https://www.videolan.org/developers/libbluray.html"

packager="tnut <tnut@nutyx.org>"
contributors="Greg,Spiky"

makedepends=(rsync python meson libxml2 freetype xorg-fontconfig apache-ant)

name=libbluray
version=1.4.0
release=1

source=(https://code.videolan.org/videolan/libbluray/-/archive/$version/$name-$version.tar.bz2
        https://code.videolan.org/videolan/libudfread/-/archive/1.2.0/libudfread-1.2.0.tar.bz2)

prepare() {
 rsync -av --delete libudfread-1.2.0/ libbluray-$version/contrib/libudfread/
}
build() {
    meson setup --prefix /usr \
    --buildtype plain -D bdj_jar=disabled \
    libbluray-$version builddir
    meson compile -C builddir
    DESTDIR=$PKG \
    meson install -C   builddir
}
