description="GLib bindings for the Telepathy D-Bus protocol"
url="http://telepathy.freedesktop.org/"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Greg,Tnut"

makedepends=(diffutils dbus-glib libxslt)
run=(gobject-introspection vala)

name=telepathy-glib
version=0.24.2
release=2

source=(http://${name%-*}.freedesktop.org/releases/$name/$name-$version.tar.gz
        telepathy-glib.patch)

prepare() {
cd $name-$version

patch -Np1 -i ../telepathy-glib.patch
}

build() {

cd $name-$version
./configure --prefix=/usr                   \
            --enable-vala-bindings          \
            --libexecdir=/usr/lib/telepathy \
            --disable-static
make
make DESTDIR=$PKG install

# Obsolet lib
rm $PKG/usr/lib/libtelepathy-glib.la
}
