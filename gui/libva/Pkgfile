description="Video Acceleration (VA) API for Linux"
url="https://github.com/intel/libva"

packager="tnut <tnut@nutyx.org>"
contributors="Greg,Remy,Spiky"
license="MIT"
name=libva
version=2.23.0
release=1

makedepends=(xorg-libdrm xorg-libxfixes wayland xorg-libx11
             xorg-libxext libglvnd)

source=(https://github.com/intel/libva/archive/$version/$name-$version.tar.gz)

build() {
cd $name-$version

mkdir libva-build
cd    libva-build

meson setup ..  \
       --prefix=/usr          \
       --buildtype=release

ninja

DESTDIR=$PKG ninja install

# Obsolets libs
#rm $PKG/usr/lib/libva-drm.la
#rm $PKG/usr/lib/libva-x11.la
#rm $PKG/usr/lib/libva.la

install -Dm644 ../COPYING $PKG/usr/share/licenses/$name/COPYING
}
