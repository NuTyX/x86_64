description='Reusable library for GPU-accelerated video/image rendering primitives'
url='https://github.com/haasn/libplacebo'

license="LGPL2.2"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(glad ffmpeg glslang vulkan-icd-loader lcms2)

name=libplacebo
version=7.360.1

source=(fix_glslang_linking.patch
        https://github.com/haasn/libplacebo/archive/refs/tags/v$version/$name-$version.tar.gz)
PKGMK_MESON_OPTIONS="-Dtests=true -Ddemos=false"

prepare() {
 cd $name-$version
 patch -Np1 < $SRC/fix_glslang_linking.patch
}
build=meson

package() {
 install -Dm644 $name-$version/LICENSE $PKG/usr/share/licenses/$name/LICENSE
}
