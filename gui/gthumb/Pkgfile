description='Image browser and viewer for the GNOME Desktop'
url='https://wiki.gnome.org/Apps/Gthumb'

license="GPL2"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(dconf gsettings-desktop-schemas gstreamer-plugins-base
             json-glib librsvg libsecret libsoup3 libwebp webkit2gtk-4 brasero
             docbook-xsl exiv2 liboauth meson yelp-tools)

name=gthumb
version=3.12.12
release=1

source=(https://gitlab.gnome.org/GNOME/gthumb/-/archive/$version/$name-$version.tar.gz)

build=meson

package() {
 install -Dm644 $name-$version/COPYING $PKG/usr/share/licenses/$name/COPYING
}
