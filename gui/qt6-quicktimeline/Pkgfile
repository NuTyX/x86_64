description='Qt module for keyframe-based timeline construction'
url='https://www.qt.io/'

license="GPL3, LGPL3, FDL, Custom"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

set=(qt6)

name=qt6-quicktimeline
version=6.11.0
release=2

_name=${name/6-/}-everywhere-src

makedepends=(cmake ninja qt6-base qt6-declarative)

source=(
https://download.qt.io/official_releases/qt/${version:0:4}/$version/submodules/${_name}-$version.tar.xz)

build() {
 cmake -S ${_name}-$version -B build -G Ninja
 cmake --build build
 DESTDIR=$PKG cmake --install build
}
