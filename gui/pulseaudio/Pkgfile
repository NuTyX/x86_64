description="A featureful, general-purpose sound server"
url="https://www.freedesktop.org/wiki/Software/PulseAudio/"

license="LGPL-2.1-or-later"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Rems,Tnut"

makedepends=(python meson ninja doxygen gdbm check
             fftw intltool json-c libsndfile vala
             alsa-lib dbus glib libcap xorg-libxtst
             openssl speex speexdsp libsamplerate
             webrtc-audio-processing jack xmltoman
             gstreamer-plugins-base)

run=(bluez sbc rtkit)

name=pulseaudio
version=17.0
release=7

source=(https://freedesktop.org/software/$name/releases/$name-$version.tar.xz)

PKGMK_MESON_OPTIONS="-Ddatabase=gdbm -Dudevrulesdir=/usr/lib/udev/rules.d"
PKGMK_GROUPS=(devel service lib man)
unset MAKEFLAGS

build=meson

package() {
cd $name-$version
mkdir -p $PKG/usr/share/icons/hicolor/scalable/devices
for size in 16 22 32 48 64 128; do
    mkdir -p $PKG/usr/share/icons/hicolor/${size}x${size}/{apps,devices}
    ln -s ../apps/pulseaudio.png $PKG/usr/share/icons/hicolor/${size}x${size}/devices/audio-backend-pulseaudio.png
done
mkdir -p $PKG/etc/pulse/default.pa.d
sed '/autospawn/iautospawn = no' -i $PKG/etc/pulse/client.conf
}


devel () {
cd $PKG
bsdtar -cf \
$PKGMK_PACKAGE_DIR/$name.devel${PKGMK_PACKAGE_EXT}$version-$release \
usr/lib/pkgconfig \
usr/include \
usr/lib/cmake
rm -r usr/{lib/{pkgconfig,cmake},include}
}

lib() {
cd $PKG

 mv usr/lib/udev \
 udev
bsdtar -cf \
$PKGMK_PACKAGE_DIR/$name.lib${PKGMK_PACKAGE_EXT}$version-$release \
usr/lib
rm -r usr/lib
mkdir -p usr/lib
mv udev  usr/lib
}
