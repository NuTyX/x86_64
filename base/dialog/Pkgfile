url="https://hightek.org/dialog/"
description="To create nice user interfaces to shell scripts or other scripting languages."

packager="spiky <spiky@nutyx.org>"
contributors="Rems,Tnut"
maintainer="Thomas E. Dickey dickey at invisible-island dot net"

makedepends=(ncurses)

set=(core)

name=dialog
version=1.3-20260107

PKGMK_LOCALES=()
PKGMK_GROUPS=(devel man)

source=(https://invisible-mirror.net/archives/$name/$name-${version}.tgz)

build() {
cd $name-$version
./configure --prefix=/usr   \
            --enable-nls    \
            --with-ncursesw \
            --mandir=/usr/share/man
make
make DESTDIR=$PKG install
}
devel() {
cd $PKG
bsdtar -cf \
$PKGMK_PACKAGE_DIR/$name.devel${PKGMK_PACKAGE_EXT}$version-$release \
usr/lib

rm -r usr/lib
}
