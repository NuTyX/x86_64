description="Unpacks .zip archives such as those made by PKZIP"
url="http://www.info-zip.org"
packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Tnut"

name=unzip
version=6.0
release=2

source=(http://downloads.sourceforge.net/infozip/unzip60.tar.gz
        cumulative.patch
        28-cve-2022-0529-and-cve-2022-0530.patch)

prepare() {
cd $name${version/./}
#    patch -Np1 -i $SRC/cumulative.patch
#    patch -p1 -F3 -i $SRC/28-cve-2022-0529-and-cve-2022-0530.patch
}

build() {
	cd ${name}${version//./}
    export CFLAGS="$CFLAGS -std=gnu17 -D_FILE_OFFSET_BITS=64 -DACORN_FTYPE_NFS \
  -DWILD_STOP_AT_DIR -DLARGE_FILE_SUPPORT -DUNICODE_SUPPORT \
  -DUNICODE_WCHAR -DUTF8_MAYBE_NATIVE -DNO_LCHMOD -DDATE_FORMAT=DF_YMD \
  -DUSE_BZIP2 -DNATIVE"
	case `uname -m` in
		x86_64)
			make -f unix/Makefile LOCAL_UNZIP="$CFLAGS" prefix=/usr \
			LF2="" D_USE_BZ2=-DUSE_BZIP2 L_BZ2=-lbz2 unzips;;
		i?86)
			make -f unix/Makefile \
			LOCAL_UNZIP=-D_FILE_OFFSET_BITS=64 linux;;
	esac
	make -f unix/Makefile prefix=$PKG/usr MANDIR=$PKG/usr/share/man/man1 install
}
