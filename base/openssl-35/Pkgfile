description="The Open Source toolkit for Secure Sockets Layer and Transport Layer Security LTS version 3.5"
url="http://www.openssl.org/"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(sed)

name=openssl-35
version=3.5.7

set=(chroot)

source=(https://github.com/openssl/openssl/releases/download/openssl-$version/openssl-$version.tar.gz)

build() {

cd openssl-${version}

./config --prefix=/usr --libdir=lib/openssl-3.5 \
	--openssldir=/etc/ssl \
	shared zlib-dynamic

make

make DESTDIR=$PKG MANDIR=/usr/share/man \
MANSUFFIX=ssl install

mv -v $PKG/usr/include/openssl{,-3.5}

mv -v $PKG/usr/lib/openssl-3.5/lib{crypto,ssl}.so.3 \
$PKG/usr/lib

ln -sv ../libssl.so.3 \
$PKG/usr/lib/openssl-3.5/

ln -sv ../libcrypto.so.3 \
$PKG/usr/lib/openssl-3.5

sed -e 's@/include$@/include/openssl-3.5@' -i \
$PKG/usr/lib/openssl-3.5/pkgconfig/*.pc

mv $PKG/usr/bin/openssl{,-3.5}

for FILE in $PKG/usr/include/openssl-3.5/*.h
do
  sed -i 's@<openssl/@<openssl-3.5/@' $FILE
done

#Already in openssl
rm -r $PKG/{etc,usr/bin/c_rehash,usr/share/man}
}
devel()
{
cd $PKG
bsdtar -cf \
$PKGMK_PACKAGE_DIR/${name}.devel${PKGMK_PACKAGE_EXT}$version-$release \
usr/lib/openssl-3.5/pkgconfig usr/include

rm -r usr/lib/openssl-3.5/pkgconfig usr/include
}
