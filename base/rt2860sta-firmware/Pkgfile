description="rt2860sta - Ralink RT3090 wireless MACs"
url='https://git.kernel.org/?p=linux/kernel/git/firmware/linux-firmware.git;a=summary'

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

license="Custom"

set=(linux-firmware)

run=(rt2800usb-firmware)

name=rt2860sta-firmware
version=20251125

makedepends=(rdfind)
source=(WHENCE
        https://gitlab.com/kernel-firmware/linux-firmware/-/archive/$version/linux-firmware-$version.tar.bz2)

build() {

cd linux-firmware-$version

# delete this python check as long we don't know what's missing here
sed -i /check_whence.py/d copy-firmware.sh

cp ../WHENCE .
install -d $PKG/lib/firmware
ln -sv rt2860.bin $PKG/lib/firmware/rt3090.bin
install -Dt $PKG/usr/share/licenses/$name -m644 WHENCE
install -Dt $PKG/usr/share/licenses/$name -m644 LICENCE.ralink-firmware.txt
}
