description="The Kmod package contains libraries and utilities for loading kernel modules."
url="https://www.kernel.org/pub/linux/kernel/people/rusty/modules"

license="LGPL2.1"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Tnut"

set=(core)

makedepends=(meson ninja glibc zlib xz zstd openssl)
PKGMK_GROUPS=(devel doc man)

name=kmod
version=34.2
release=2

source=(http://www.kernel.org/pub/linux/utils/kernel/kmod/kmod-$version.tar.xz )

build()
{

cd $name-$version

mkdir build
cd    build

meson setup .. \
            --prefix=/usr                 \
            --sbindir=/usr/sbin           \
            --buildtype=release           \
            -D moduledir=/usr/lib/modules \
            -D docs=false                 \
            -D manpages=false

ninja

DESTDIR=$PKG ninja install

install -Dm644 ../COPYING $PKG/usr/share/licenses/$name/COPYING

mkdir $PKG/bin
ln -sv /usr/sbin/modprobe $PKG/bin/modprobe 
}
devel()
{
cd $PKG
bsdtar -cf \
$PKGMK_PACKAGE_DIR/$name.devel${PKGMK_PACKAGE_EXT}$version-$release \
usr/lib/pkgconfig \
usr/include \
usr/share/bash-completion
rm -r usr/lib/pkgconfig \
usr/include \
usr/share/bash-completion
}
