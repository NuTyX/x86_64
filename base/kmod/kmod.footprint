drwxr-xr-x	root/root	etc/
drwxr-xr-x	root/root	etc/depmod.d/
drwxr-xr-x	root/root	etc/modprobe.d/
drwxr-xr-x	root/root	usr/
drwxr-xr-x	root/root	usr/bin/
-rwxr-xr-x	root/root	usr/bin/kmod
drwxr-xr-x	root/root	usr/sbin/
lrwxrwxrwx	root/root	usr/sbin/depmod -> ../bin/kmod
lrwxrwxrwx	root/root	usr/sbin/insmod -> ../bin/kmod
lrwxrwxrwx	root/root	usr/sbin/lsmod -> ../bin/kmod
lrwxrwxrwx	root/root	usr/sbin/modinfo -> ../bin/kmod
lrwxrwxrwx	root/root	usr/sbin/modprobe -> ../bin/kmod
lrwxrwxrwx	root/root	usr/sbin/rmmod -> ../bin/kmod
drwxr-xr-x	root/root	usr/share/
drwxr-xr-x	root/root	usr/share/fish/
drwxr-xr-x	root/root	usr/share/fish/vendor_functions.d/
-rw-r--r--	root/root	usr/share/fish/vendor_functions.d/insmod.fish
-rw-r--r--	root/root	usr/share/fish/vendor_functions.d/lsmod.fish
-rw-r--r--	root/root	usr/share/fish/vendor_functions.d/rmmod.fish
drwxr-xr-x	root/root	usr/share/licenses/
drwxr-xr-x	root/root	usr/share/licenses/kmod/
-rw-r--r--	root/root	usr/share/licenses/kmod/COPYING
drwxr-xr-x	root/root	usr/share/pkgconfig/
-rw-r--r--	root/root	usr/share/pkgconfig/kmod.pc
drwxr-xr-x	root/root	usr/share/zsh/
drwxr-xr-x	root/root	usr/share/zsh/site-functions/
-rw-r--r--	root/root	usr/share/zsh/site-functions/_insmod
-rw-r--r--	root/root	usr/share/zsh/site-functions/_lsmod
-rw-r--r--	root/root	usr/share/zsh/site-functions/_rmmod
