description="Python module that implements a XML/HTML/XHTML Markup safe string."
url="https://pypi.org/project/MarkupSafe/"

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"

makedepends=(python-setuptools python-wheel)

name=python-markupsafe
_name="markupsafe"
alias=(${_name})

version=3.0.2
release=2

source=(https://pypi.io/packages/source/m/markupsafe/markupsafe-$version.tar.gz)

build() {

cd ${_name}-$version

  pip3 wheel -w dist \
    --no-build-isolation \
    --no-deps $PWD
  pip3 install --no-index \
    --find-links dist \
    --no-cache-dir    \
    --no-user         \
    --root=$PKG       \
    ${_name}
}
