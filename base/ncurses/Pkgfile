description="Libraries for terminal-independent handling of character screens."
url="http://www.gnu.org/software/ncurses/ncurses.html"

license="MIT"

maintainer="Thomas E. Dickey TD,Juergen Pfeifer JPF,Eric S Raymond ESR,Alexander V Lukyanov,Philippe Blain PB,Sven Verdoolaege SV"
packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

name=ncurses
version=6.5-20250809
release=1

set=(chroot)

source=(https://invisible-mirror.net/archives/$name/current/$name-$version.tgz)
build()
{
cd ncurses-$version

./configure --prefix=/usr   \
  --mandir=/usr/share/man   \
  --infodir=/usr/share/info \
  --without-normal          \
  --with-cxx-shared         \
  --without-debug           \
  --enable-pc-files         \
  --with-install-prefix=$PKG\
  --with-pkg-config-libdir=/usr/lib/pkgconfig 

make

make install

sed -e 's/^#if.*XOPEN.*$/#if 1/' \
    -i $PKG/usr/include/curses.h

for lib in ncurses form panel menu ; do
    ln -sfv lib${lib}w.so $PKG/usr/lib/lib${lib}.so
    ln -sfv ${lib}w.pc    $PKG/usr/lib/pkgconfig/${lib}.pc
done

ln -sfv libncursesw.so $PKG/usr/lib/libcurses.so

mkdir -vp   $PKG/usr/share/doc/$name
cp -R doc/* $PKG/usr/share/doc/$name

make distclean

./configure --prefix=/usr --with-shared --without-normal \
--mandir=/usr/share/man --infodir=/usr/share/info \
--without-debug --without-cxx-binding \
--with-abi-version=5 \
--with-install-prefix=$PKG

make sources libs
mkdir -p $PKG/usr/lib
cp -av lib/lib*.so.5* $PKG/usr/lib
}
