description="The Expat package contains a stream oriented C library for parsing XML."
url="https://expat.sourceforge.net/"

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"

set=(core)

name=expat
version=2.7.1
_version=2_7_1

source=(https://github.com/libexpat/libexpat/releases/download/R_${_version}/$name-$version.tar.xz)

build() {
cd $name-$version

./configure --prefix=/usr \
	--disable-static \
	--docdir=/usr/share/doc/$name-$version

make
make DESTDIR=$PKG install

install -v -m755 -d $PKG/usr/share/doc/$name-$version
install -v -m644 doc/*.{html,css} $PKG/usr/share/doc/$name-$version
# Obsolet lib
rm $PKG/usr/lib/libexpat.la
}
