description='Virtualbox Host modules for the latest stable Linux Kernel version'
url='http://www.virtualbox.org'

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"

license="GPL, CDDL"

run=(kernel)
name=vboxhost-kernel
version=7.1.8
release=2

buildr=168469
_VBARCH=amd64
KERNELNAME="${name#vboxhost-}"

source=(http://download.virtualbox.org/virtualbox/${version}/VirtualBox-${version}-${buildr}-Linux_${_VBARCH}.run)

build(){

sh VirtualBox-${version}-${buildr}-Linux_${_VBARCH}.run --target vb --keep --noexec
cd vb
tar xfj VirtualBox.tar.bz2
cd src/vboxhost
sed -i "s/netif_rx_ni/netif_rx/" vboxnetflt/linux/VBoxNetFlt-linux.c
KERN_DIR=/usr/lib/modules/kernel/build KERN_VER=kernel make

for i in *.ko
do
	install -D -m0644 $i \
	$PKG/usr/lib/modules/$KERNELNAME/kernel/drivers/virt/vboxhost/$i
done

echo "depmod -a $(basename /usr/lib/modules/6*)" > $PKGMK_ROOT/$name.post-install
}
