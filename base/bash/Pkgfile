description="The Bash package contains the Bourne-Again SHell."
url='https://www.gnu.org/software/bash/'

maintainer="Brian Fox,Chet Ramey and many more"
packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(ncurses readline sed)

name=bash
version=5.3.9
_version=5.3
release=1

set=(chroot)
PKGMK_IGNORE_RUNTIMEDEPS="yes"
PKGMK_LOCALES=()

source=($name-$version-consolidate-1.patch
        https://ftp.gnu.org/gnu/bash/bash-${_version}.tar.gz)

prepare() {
 cd $name-${_version}
 patch -Np1 -i ../$name-$version-consolidate-1.patch
}
build()
{
cd bash-${_version}

./configure --prefix=/usr \
--htmldir=/usr/share/doc/bash \
--docdir=/usr/share/doc/bash \
--without-bash-malloc \
--with-installed-readline

make
make DESTDIR=$PKG install

ln -sv bash $PKG/usr/bin/sh

mkdir -p $PKG/bin
ln -sv ../usr/bin/bash $PKG/bin/bash
ln -sv ../usr/bin/sh   $PKG/bin/sh
}
