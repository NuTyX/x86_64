description="Freedesktop.org message bus system"
url="https://www.freedesktop.org/wiki/Software/dbus/"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre,Jayce,Spiky"

# In case of rebuild systemd
# dbus needs do be build once without systemd
# in order to build systemd
# 1/ dbus without systemd with following makedepends
# makedepends=(python meson expat)
# 2/ build systemd with dbus
# 3/ build dbus with systemd with following makedepends
# makedepends=(python meson systemd expat)

makedepends=(python meson systemd expat)

set=(core)

name=dbus
version=1.16.2
release=3

PKGMK_GROUPS=(doc devel)
PKGMK_MESON_OPTIONS="--wrap-mode=nofallback"

source=(http://dbus.freedesktop.org/releases/dbus/$name-$version.tar.xz)

build=meson

package(){
  chown -v root:messagebus $PKG/usr/libexec/dbus-daemon-launch-helper
  chmod -v      4750       $PKG/usr/libexec/dbus-daemon-launch-helper

  ln -sfv /etc/machine-id $PKG/var/lib/dbus
  rm $PKG/usr/bin/dbus-launch
}
