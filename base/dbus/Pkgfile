description="Freedesktop.org message bus system"
url="https://www.freedesktop.org/wiki/Software/dbus/"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Jayce,Tnut"

makedepends=(expat)

name=dbus
version=1.14.10
release=3
scriptsversion=20241218

PKGMK_GROUPS=(doc devel)
source=(https://download.tuxfamily.org/nutyx/sources/nutyx-scripts/nutyx-scripts-$scriptsversion.tar.xz
        http://dbus.freedesktop.org/releases/dbus/$name-$version.tar.xz)

build() {
    cd $name-$version
    ./configure --prefix=/usr               \
    --sysconfdir=/etc                     \
    --localstatedir=/var                  \
    --disable-doxygen-docs                \
    --disable-xml-docs                    \
    --disable-static                      \
    --with-systemduserunitdir=no          \
    --with-systemdsystemunitdir=no        \
    --docdir=/usr/share/doc/dbus-$version \
    --with-system-socket=/run/dbus/system_bus_socket
    make
    make DESTDIR=$PKG install

    chown -v root:messagebus $PKG/usr/libexec/dbus-daemon-launch-helper
    chmod -v      4750       $PKG/usr/libexec/dbus-daemon-launch-helper
    ln -sfv /var/lib/dbus/machine-id $PKG/etc
    # service
    cd ../nutyx-scripts-$scriptsversion
    make DESTDIR=$PKG install-sysv-dbus

    # part of dbus-launch
    rm $PKG/usr/bin/dbus-launch
}
