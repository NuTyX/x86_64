description="The Open Source toolkit for Secure Sockets Layer and Transport Layer Security."
url="https://openssl-library.org/"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(perl)

name=openssl
version=4.0.2
_ltsversion=3.5.8
set=(chroot)

source=(https://github.com/openssl/openssl/releases/download/$name-$version/$name-$version.tar.gz
        https://github.com/openssl/openssl/releases/download/$name-${_ltsversion}/$name-${_ltsversion}.tar.gz)

PKGMK_GROUPS=(devel man doc)

build() {
unset MAKEFLAGS

cd $name-${version}

./config --prefix=/usr --libdir=lib \
         --openssldir=/etc/ssl \
         shared zlib-dynamic

make

# sed -i '/INSTALL_LIBS/s/libcrypto.a libssl.a//' Makefile

make DESTDIR=$PKG MANDIR=/usr/share/man \
MANSUFFIX=ssl install

cp -vfr doc/*     $PKG/usr/share/doc/openssl

cd ../$name-${_ltsversion}

./config --prefix=/usr --libdir=lib \
         shared zlib-dynamic

make build_libs

make DESTDIR=$PKG install_runtime_libs

}

devel()
{
cd $PKG
bsdtar -cf \
$PKGMK_PACKAGE_DIR/${name}.devel${PKGMK_PACKAGE_EXT}$version-$release \
usr/lib/pkgconfig usr/include

rm -r usr/lib/pkgconfig usr/include
}
