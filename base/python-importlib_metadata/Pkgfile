description='Read metadata from Python packages'
url='https://pypi.org/project/importlib-metadata/'

packager="spiky <spiky@nutyx.org>"
contributors=""

makedepends=(python-setuptools python-wheel python-zipp)

name=python-importlib_metadata
_name="importlib_metadata"
alias=(${_name})

version=9.0.0

source=(https://pypi.python.org/packages/source/i/importlib_metadata/importlib_metadata-$version.tar.gz)

build() {

 cd ${_name}-$version

  pip3 wheel -w dist \
    --no-build-isolation \
    --no-deps $PWD
  pip3 install --no-index \
    --find-links dist \
    --no-cache-dir    \
    --no-user         \
    --root=$PKG       \
    ${_name}

 find $PKG -type d -name vendor -o -name tests |xargs rm -rf 
}
