description='the blessed package to manage your versions by vcs metadata'
url='https://github.com/pypa/setuptools-scm'

packager="spiky <spiky@nutyx.org>"
contributors=""

makedepends=(python-wheel python-build python-setuptools)

name=python-vcs-versioning
_name="vcs_versioning"
alias=(${_name})

version=2.2.2

source=(https://pypi.org/packages/source/v/vcs_versioning/vcs_versioning-$version.tar.gz)

build() {

  cd ${_name}-$version

  pip3 wheel -w dist \
    --no-build-isolation \
    --no-deps $PWD
  pip3 install --no-index \
    --find-links dist \
    --no-cache-dir    \
    --no-user         \
    --root=$PKG       \
    ${_name}

 find $PKG -type d -name vendor -o -name tests |xargs rm -rf 
}
