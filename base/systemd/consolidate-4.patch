diff -Naur a/src/kernel-install/50-depmod.install b/src/kernel-install/50-depmod.install
--- a/src/kernel-install/50-depmod.install	2025-03-06 15:38:30.000000000 +0100
+++ b/src/kernel-install/50-depmod.install	2025-03-29 20:49:23.646939867 +0100
@@ -23,30 +23,30 @@
 COMMAND="${1:?}"
 KERNEL_VERSION="${2:?}"
 
-[ -w "/lib/modules" ] || exit 0
+[ -w "/usr/lib/modules" ] || exit 0
 
 case "$COMMAND" in
     add)
-        [ -d "/lib/modules/$KERNEL_VERSION/kernel" ] || exit 0
+        [ -d "/usr/lib/modules/$KERNEL_VERSION/kernel" ] || exit 0
         command -v depmod >/dev/null || exit 0
         [ "$KERNEL_INSTALL_VERBOSE" -gt 0 ] && echo "+depmod -a $KERNEL_VERSION"
         exec depmod -a "$KERNEL_VERSION"
         ;;
     remove)
         [ "$KERNEL_INSTALL_VERBOSE" -gt 0 ] && \
-            echo "Removing /lib/modules/${KERNEL_VERSION}/modules.dep and associated files"
+            echo "Removing /usr/lib/modules/${KERNEL_VERSION}/modules.dep and associated files"
         exec rm -f \
-            "/lib/modules/$KERNEL_VERSION/modules.alias" \
-            "/lib/modules/$KERNEL_VERSION/modules.alias.bin" \
-            "/lib/modules/$KERNEL_VERSION/modules.builtin.bin" \
-            "/lib/modules/$KERNEL_VERSION/modules.builtin.alias.bin" \
-            "/lib/modules/$KERNEL_VERSION/modules.dep" \
-            "/lib/modules/$KERNEL_VERSION/modules.dep.bin" \
-            "/lib/modules/$KERNEL_VERSION/modules.devname" \
-            "/lib/modules/$KERNEL_VERSION/modules.softdep" \
-            "/lib/modules/$KERNEL_VERSION/modules.weakdep" \
-            "/lib/modules/$KERNEL_VERSION/modules.symbols" \
-            "/lib/modules/$KERNEL_VERSION/modules.symbols.bin"
+            "/usr/lib/modules/$KERNEL_VERSION/modules.alias" \
+            "/usr/lib/modules/$KERNEL_VERSION/modules.alias.bin" \
+            "/usr/lib/modules/$KERNEL_VERSION/modules.builtin.bin" \
+            "/usr/lib/modules/$KERNEL_VERSION/modules.builtin.alias.bin" \
+            "/usr/lib/modules/$KERNEL_VERSION/modules.dep" \
+            "/usr/lib/modules/$KERNEL_VERSION/modules.dep.bin" \
+            "/usr/lib/modules/$KERNEL_VERSION/modules.devname" \
+            "/usr/lib/modules/$KERNEL_VERSION/modules.softdep" \
+            "/usr/lib/modules/$KERNEL_VERSION/modules.weakdep" \
+            "/usr/lib/modules/$KERNEL_VERSION/modules.symbols" \
+            "/usr/lib/modules/$KERNEL_VERSION/modules.symbols.bin"
         ;;
     *)
         exit 0
