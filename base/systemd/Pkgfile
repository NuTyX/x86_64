description="Programs for controlling the startup, running, and shutdown of the system."
url="https://www.freedesktop.org/wiki/Software/systemd/"

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"

# Those dependencies are need to compile the package
# but not listed to avoid circular dependencies:
# When rebuild systemd:
# 1/ rebuild dbus first without systemd  in dbus package by removing systemd dependency
# 2/ build systemd with dbus that has no systemd libs
# 3/ rebuild dbus with systemd as dependency so that dbus gets links to systemd

PKGMK_DEPENDS=(python python-markupsafe python-jinja meson ninja)

makedepends=(acl libcap kmod m4 gperf kbd pam libxcrypt util-linux)
run=(shadow)

set=(core)

name=systemd
version=258.1

source=(https://anduin.linuxfromscratch.org/LFS/systemd-man-pages-$version.tar.xz
        https://github.com/systemd/systemd/archive/v$version/systemd-$version.tar.gz)

build() {
cd $name-$version

mkdir build
cd    build

meson --prefix=/usr           \
--buildtype=release           \
-D default-dnssec=no          \
-D firstboot=false            \
-D install-tests=false        \
-D ldconfig=false             \
-D sysusers=false             \
-D homed=disabled             \
-D rpmmacrosdir=no            \
-D man=disabled               \
-D userdb=false               \
-D pam=enabled                \
-D pamconfdir=/etc/pam.d      \
-D nobody-group=nogroup       \
-D mode=release               \
..

ninja

DESTDIR=$PKG ninja install

mkdir -p $PKG/usr/share/man
for i in 1 3 5 7 8
do
  mv ../../$name-man-pages-$version/man$i \
   $PKG/usr/share/man
done
mkdir $PKG/sbin

ln -s ../usr/lib/systemd/systemd \
$PKG/sbin/init
rm $PKG/usr/share/factory/etc/vconsole.conf
}
