description="Programs for controlling the startup, running, and shutdown of the system."
url="https://www.freedesktop.org/wiki/Software/systemd/"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

# Those dependencies are need to compile the package
# but not listed to avoid circular dependencies:
# When rebuild systemd:
# 1/ rebuild dbus first without systemd  in dbus package by removing systemd dependency
# 2/ build systemd with dbus that has no systemd libs
# 3/ rebuild dbus with systemd as dependency so that dbus gets links to systemd

PKGMK_DEPENDS=(python python-markupsafe python-jinja meson ninja)

makedepends=(acl libcap kmod m4 gperf kbd pam libxcrypt util-linux)
run=(shadow)

set=(core)

name=systemd
version=259.1
release=1

source=($name-$version-consolidate-1.patch
        https://anduin.linuxfromscratch.org/LFS/systemd-man-pages-$version.tar.xz
        https://github.com/systemd/systemd/archive/v$version/systemd-$version.tar.gz)

PKGMK_MESON_OPTIONS="-Ddefault-dnssec=no -Ddev-kvm-mode=0660 \
-Dfirstboot=false -Dldconfig=false -Dhomed=disabled -Dmode=release \
-Dnobody-group=nogroup -Dpam=enabled -Dpamconfdir=/etc/pam.d \
-Drpmmacrosdir=no -Dsysusers=false -Dmount-path=/usr/bin/mount \
-Dumount-path=/usr/bin/umount -Dswapon-path=/usr/sbin/swapon \
-Dswapoff-path=/usr/sbin/swapoff -Dagetty-path=/usr/sbin/agetty \
-Dkmod-path=/usr/bin/kmod"

prepare() {
  cd $name-$version
  patch -Np1 -i ../$name-$version-consolidate-1.patch

  sed -e 's/GROUP="render"/GROUP="video"/' \
  -e 's/GROUP="sgx", //'                   \
  -i rules.d/50-udev-default.rules.in
}

build=meson

package() {
  mkdir -p $PKG/usr/share/man
  for i in 1 3 5 7 8
  do
    mv $name-man-pages-$version/man$i \
     $PKG/usr/share/man
  done
  mkdir $PKG/sbin

  ln -s ../usr/lib/systemd/systemd \
  $PKG/sbin/init

  rm $PKG/usr/share/factory/etc/vconsole.conf

  cat > $PKG/etc/pam.d/systemd-user << "EOF"
# Begin /etc/pam.d/systemd-user

account  required    pam_access.so
account  include     system-account

session  required    pam_env.so
session  required    pam_limits.so
session  required    pam_loginuid.so
session  optional    pam_keyinit.so force revoke
session  optional    pam_systemd.so

auth     required    pam_deny.so
password required    pam_deny.so

# End /etc/pam.d/systemd-user
EOF
}
