description="Programs for controlling the startup, running, and shutdown of the system."
url="https://www.freedesktop.org/wiki/Software/systemd/"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

# Those dependencies are need to compile the package
# but not listed to avoid circular dependencies:
# When rebuild systemd:
# 1/ rebuild dbus first without systemd --disable-systemd in dbus package
# 2/ build systemd with dbus that has no systemd libs
# 3/ rebuild dbus with systemd so that dbus gets links to systemd

PKGMK_DEPENDS=(python python-markupsafe python-jinja meson ninja dbus)

makedepends=(acl libcap kmod m4 gperf kbd pam libxcrypt util-linux)
run=(shadow)

set=(core)

name=systemd
version=257
release=2

source=(consolidate-2.patch
        https://download.tuxfamily.org/nutyx/sources/$name/$name-man-pages-$version.tar.xz
        https://github.com/systemd/systemd/archive/v$version/systemd-$version.tar.gz)
prepare() {
cd $name-$version
patch -Np1 -i ../consolidate-2.patch
}


build() {
cd $name-$version

mkdir build
cd    build

meson --prefix=/usr           \
--buildtype=release           \
-D firstboot=false            \
-D install-tests=false        \
-D ldconfig=false             \
-D sysusers=false             \
-D homed=disabled             \
-D split-usr=false            \
-D rpmmacrosdir=no            \
-D man=disabled               \
-D userdb=false               \
-D pam=enabled                \
-D pamconfdir=/etc/pam.d      \
-D mode=release               \
..

ninja

DESTDIR=$PKG ninja install

mkdir -p $PKG/usr/share/man
for i in 1 3 5 7 8
do
  mv ../../$name-man-pages-$version/man$i \
   $PKG/usr/share/man
done
mkdir $PKG/sbin

ln -s ../usr/lib/systemd/systemd \
$PKG/sbin/init
}
