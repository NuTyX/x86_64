description='A built-package format for Python'
url='https://pypi.python.org/pypi/wheel'

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(python)

name=python-pip
_name="pip"
alias=(${_name})

version=25.3
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://bootstrap.pypa.io/get-pip.py)

build() {

  python get-pip.py \
  --no-setuptools   \
  --no-wheel        \
  --no-warn-script-location \
  --root=$PKG
}
