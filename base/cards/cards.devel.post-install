INFO="\033[1;36m"
NORMAL="\033[0;39m"

if [ ! -f /etc/pkgmk.conf ]; then
   if [ -f /etc/pkgmk.conf.example ]; then
	cp /etc/pkgmk.conf.example /etc/pkgmk.conf
	printf "${INFO} /etc/pkgmk.conf.example copied as /etc/pkgmk.conf ${NORMAL}\n"
	printf "${INFO} Double check /etc/pkgmk.conf and adapted to your needs ${NORMAL}\n"
   fi
fi
