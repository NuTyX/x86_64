description="A set of utilities to manage software packages on NuTyX distribution."
url="https://github.com/NuTyX/cards"

maintainer="tnut at nutyx dot org"
packager="tnut <tnut@nutyx.org>"

alias=(card)


PKGMK_IGNORE_RUNTIMEDEPS="no"
makedepends=(curl git bzip2 gettext xz util-linux)
run_devel=(curl.devel gcc.devel glibc.devel libarchive.devel \
openssl.devel zlib.devel bzip2.devel xz.devel zstd.devel)

PKGMK_GROUPS=(devel doc man lib)
PKGMK_LOCALES=()

name=cards
version=3.4.0
release=1

set=(chroot)

[ "$release" != "1" ] &&  patchname="$name-$version-consolidate-$release.patch"

source=(https://sourceforge.net/projects/nutyx/files/sources/$name/$name-$version.tar.gz)

[ -z "$patchname" ] || source+=" $patchname"

build () {

unset MAKEFLAGS

cd $name-$version
[ -z "$patchname" ] || patch -Np1 -i ../$patchname


make all
make DESTDIR=$PKG install

mkdir -p $PKG/usr/share/doc/cards-$version
install -m644 ChangeLog \
$PKG/usr/share/doc/cards-$version/ChangeLog

}
lib() {
cd $PKG
bsdtar -cf \
$PKGMK_PACKAGE_DIR/$name.lib${PKGMK_PACKAGE_EXT}$version-$release \
usr/lib

rm usr/lib/libcards*
rm -d usr/lib || true
}
devel()
{
cd $PKG
bsdtar -cf \
$PKGMK_PACKAGE_DIR/$name.devel${PKGMK_PACKAGE_EXT}$version-$release \
usr/include \
usr/bin/pkgmk \
etc/pkgmk.conf.example \
usr/lib/pkgconfig

rm -rf usr/bin/pkgmk usr/lib/pkgconfig \
usr/include etc/pkgmk.conf.example
}
