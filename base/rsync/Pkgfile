description="Synchronizing files over a network by sending just the differences in the files."
url="https://samba.anu.edu.au/rsync/"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"
run=(shadow)

name=rsync
version=3.4.1
release=5

scriptsversion=20260315

source=(https://sourceforge.net/projects/nutyx/files/sources/nutyx-scripts/nutyx-scripts-${scriptsversion}.tar.xz
        https://www.samba.org/ftp/$name/$name-$version.tar.gz rsync-3.4.1-security_fix-2.patch)

prepare(){
UN=rsyncd
if ! (getent group $UN > /dev/null); then
   groupadd -g 48 $UN
fi
if ! (getent passwd $UN > /dev/null); then
   useradd  -c "rsyncd Daemon" -d /home/rsync \
   -g $UN -s /usr/bin/false -u 48 $UN
fi
cd $name-$version
patch -Np1 -i ../rsync-3.4.1-security_fix-2.patch
}
build() {

cd $name-$version
./configure --prefix=/usr \
-mandir=/usr/share/man \
--disable-xxhash \
--disable-lz4    \
--disable-zstd   \
--without-included-zlib \
--infodir=/usr/share/info
make
make DESTDIR=$PKG install


# Service
cd ../nutyx-scripts-${scriptsversion}
make DESTDIR=$PKG install-sysd-rsyncd
}
service() {
cd $PKG
bsdtar -r -f \
$PKGMK_PACKAGE_DIR/${name}.${group}${PKGMK_PACKAGE_EXT}$version-$release \
usr/lib/systemd
rm -r usr/lib/systemd
}

