SN="rsyncd"
IDN="48"
INFO="\033[1;36m"
NORMAL="\033[0;39m"
if ! (getent group $SN > /dev/null); then
	printf "${INFO}Creating $SN group${NORMAL}\n"
	groupadd -g $IDN $SN
fi
if ! (getent passwd $SN > /dev/null); then
	printf "${INFO}Creating $SN user${NORMAL}\n"
	useradd  -c "$SN Daemon" -d /home/rsync \
	-g $SN -s /bin/false -u $IDN $SN
fi
