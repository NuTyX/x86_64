description="Pluggable Authentication Modules to choose how applications authenticate users."
url="https://www.kernel.org/pub/libs/pam"

license="GPL-2.0-only"

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"

set=(core)

PKGMK_DEPENDS=(python meson ninja)
makedepends=(intltool texinfo libxcrypt)

name=pam
version=1.7.1

PKGMK_LOCALES=()

source=(https://github.com/linux-pam/linux-pam/releases/download/v$version/Linux-PAM-$version.tar.xz)
prepare() {

mv Linux-PAM-$version \
   $name-$version
}

build() {

 meson setup --prefix    /usr    \
             --buildtype plain   \
             --libdir    lib     \
             -D docdir=/usr/share/doc/Linux-PAM-$version \
 $name-$version                builddir

 meson compile -C              builddir

 DESTDIR=$PKG meson install -C builddir


chmod -v 4755 $PKG/usr/sbin/unix_chkpwd

}
