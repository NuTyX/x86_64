description="rtl8192ee - Realtek 802.11n WLAN driver for RTL8192EE"
url='https://git.kernel.org/?p=linux/kernel/git/firmware/linux-firmware.git;a=summary'

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

license="Custom"

set=(linux-firmware)

name=rtl8192ee-firmware
version=20251125

run=(rtl8xxxu-firmware)

makedepends=(rdfind)
source=(WHENCE
        https://gitlab.com/kernel-firmware/linux-firmware/-/archive/$version/linux-firmware-$version.tar.bz2)

build() {

cd linux-firmware-$version

# delete this python check as long we don't know what's missing here
sed -i /check_whence.py/d copy-firmware.sh

cp ../WHENCE .

install -d  $PKG/$FIRMWAREDIR/rtlwifi
ln -sv rtl8192eu_nic.bin $PKG/$FIRMWAREDIR/rtlwifi/rtl8192eefw.bin

install -Dt $PKG/usr/share/licenses/$name -m644 WHENCE
install -Dt $PKG/usr/share/licenses/$name -m644 LICENCE.rtlwifi_firmware.txt
}
