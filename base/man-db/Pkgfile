description="The Man-DB package contains programs for finding and viewing man pages."
url="https://savannah.nongnu.org/projects/man-db"

license="GPL-2.0-or-later AND GPL-3.0-or-later"

maintainer="Colin Watson cjwatson at debian dot org"
contributors="Pierre,Spiky"
packager="tnut <tnut@nutyx.org>"

set=(core)

name=man-db
version=2.13.0
release=3

makedepends=(gdbm libpipeline)
run=(groff less)

PKGMK_GROUPS=(man locale)
PKGMK_LOCALES=()
source=(https://download.savannah.gnu.org/releases/$name/$name-$version.tar.xz)

build()
{
cd man-db-$version
PKG_CONFIG_PATH="/usr/lib/pkgconfig" \
./configure --prefix=/usr            \
   --libexecdir=/usr/lib             \
   --docdir=/usr/share/doc/man-$version \
   --sysconfdir=/etc --disable-setuid \
   --with-browser=/usr/bin/lynx       \
   --with-vgrind=/usr/bin/vgrind      \
   --with-grap=/usr/bin/grap          \
   --with-systemdtmpfilesdir=         \
   --with-systemdsystemunitdir=

make

# Somes test fails
make -k check || true

make DESTDIR=$PKG install

}
