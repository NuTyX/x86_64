description='A log-structured file system supporting continuous snapshotting (userspace utils)'
url='https://nilfs.sourceforge.net/'

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"

makedepends=(sed util-linux)
run=()
set=()

name=nilfs-utils
version=2.3.1

source=(http://nilfs.sourceforge.net/download/$name-$version.tar.bz2)

build() {
cd $name-$version

./configure --prefix=/usr \
            --sbindir=/usr/bin \
            --with-libmount
make
make DESTDIR=$PKG sbindir=/usr/bin core_sbindir=/usr/bin install LDCONFIG=/usr/bin/true
}
