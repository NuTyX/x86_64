description='v4l2loopback driver for kernel stable'
url='https://github.com/umlaeute/v4l2loopback'

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

name=v4l2loopback-kernel
version=0.13.2
release=6

run=(kernel)
KERNELNAME="${name#v4l2loopback-}"

source=($url/archive/v$version/v4l2loopback-$version.tar.gz)

build() {
KERNEL_VERSION="$(basename /usr/lib/modules/*)"
cd v4l2loopback-${version}

make -C /usr/lib/modules/${KERNEL_VERSION}/build M=$(pwd)

install -Dm755 v4l2loopback.ko \
$PKG/usr/lib/modules/$KERNELNAME/kernel/drivers/media/common/v4l2loopback.ko

xz \
$PKG/usr/lib/modules/$KERNELNAME/kernel/drivers/media/common/v4l2loopback.ko

echo "depmod -a ${KERNEL_VERSION}" > $PKGMK_ROOT/$name.post-install
}
