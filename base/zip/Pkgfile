description="Creates PKZIP-compatible .zip files"
url="https://infozip.sourceforge.net/Zip.html"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre, Spiky"

name=zip
version=3.0
release=3

source=(https://downloads.sourceforge.net/infozip/zip30.tar.gz)

build() {
    cd ${name}30

    make -f unix/Makefile prefix=/usr generic CC="gcc -std=gnu89"
    make prefix=$PKG/usr MANDIR=$PKG/usr/share/man/man1 -f unix/Makefile install    
}
