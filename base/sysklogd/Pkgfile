description="Logging system messages, such as those given by the kernel."
url="https://www.infodrom.org/projects/sysklogd/"

name=sysklogd
version=2.6.2
release=3

set=(core)

contributors="Pierre B"
packager="tnut <tnut@nutyx.org>"
maintainer="Dr. Greg Wettstein, greg at wind dot enjellic dot com"

source=(https://github.com/troglobit/$name/releases/download/v$version/sysklogd-$version.tar.gz)

build()
{
cd sysklogd-$version

mkdir -p $PKG/{usr/sbin,etc,usr/share/man/man{5,8}}

./configure --prefix=/usr        \
            --sysconfdir=/etc    \
            --localstatedir=/var \
            --runstatedir=/run   \
            --without-logger
make

make DESTDIR=$PKG install

cat > $PKG/etc/syslog.conf << "EOF"
# Begin /etc/syslog.conf

auth,authpriv.* -/var/log/auth.log
*.*;auth,authpriv.none -/var/log/sys.log
daemon.* -/var/log/daemon.log
kern.* -/var/log/kern.log
mail.* -/var/log/mail.log
user.* -/var/log/user.log
local7.* -/var/log/install.log
cron.* -/var/log/cron.log
*.emerg *

# End /etc/syslog.conf
EOF
}
