description="S-Lang is a powerful interpreted language"
url="https://gd.tuwien.ac.at/editors/davis/slang"

license="GPL-2.0-or-higher"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre,Spiky"

name=slang
version=2.3.3
release=3

source=(https://www.jedsoft.org/releases/$name/$name-$version.tar.bz2)

build() {
    unset MAKEFLAGS
    cd $name-$version
    ./configure --prefix=/usr \
    --sysconfdir=/etc \
    --mandir=/usr/share/man \
    --infodir=/usr/share/info

    make
    make DESTDIR=$PKG install

    chmod -v 755 $PKG/usr/lib/libslang.so.${version/a/} \
    $PKG/usr/lib/slang/v2/modules/*.so
}
