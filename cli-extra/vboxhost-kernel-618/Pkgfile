description="Virtualbox Host modules for the 6.18 LTS Linux Kernel version"
url="https://www.virtualbox.org"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

license="GPL, CDDL"

run=(kernel-618)
name=vboxhost-kernel-618
version=7.2.6
release=3

buildr=172322
_VBARCH=amd64
KERNELNAME="${name#vboxhost-}"

source=(http://download.virtualbox.org/virtualbox/${version}/VirtualBox-${version}-${buildr}-Linux_${_VBARCH}.run)

build(){

sh VirtualBox-${version}-${buildr}-Linux_${_VBARCH}.run --target vb --keep --noexec
cd vb
tar xfj VirtualBox.tar.bz2
cd src/vboxhost
sed -i "s/netif_rx_ni/netif_rx/" vboxnetflt/linux/VBoxNetFlt-linux.c
KERN_VER=$KERNELNAME KERN_DIR=/usr/lib/modules/$KERNELNAME/build make

for i in *.ko
do
	install -D -m0644 $i \
	$PKG/usr/lib/modules/$KERNELNAME/kernel/drivers/virt/vboxhost/$i
done

echo "depmod -a $(basename /usr/lib/modules/6.18.*)" > $PKGMK_ROOT/$name.post-install
}
