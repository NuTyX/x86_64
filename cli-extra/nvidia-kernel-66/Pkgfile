description='NVIDIA modules for the 6.6 longterm support Linux Kernel version.'
url='https://www.nvidia.com/en-us/drivers/unix/'

packager="tnut <tnut@nutyx.org>"

license="custom"

name=nvidia-kernel-66
version=570.144
release=1

run=(kernel-66)
KERNELNAME="${name#nvidia-}"

source=(https://download.nvidia.com/XFree86/Linux-x86_64/$version/NVIDIA-Linux-x86_64-$version.run)

build()
{
 sh NVIDIA-Linux-x86_64-$version.run --extract-only
 cd NVIDIA-Linux-x86_64-$version/kernel

 modules_dir="$(basename /usr/lib/modules/6.6.*)"

 SYSSRC="/usr/src/kernel-66" make modules
 install -dm0755 $PKG/usr/lib/modules/$KERNELNAME/kernel/drivers/video
 install -m0644 *.ko $PKG/usr/lib/modules/$KERNELNAME/kernel/drivers/video
 echo "depmod -a ${modules_dir}" > $PKGMK_ROOT/$name.post-install
}
