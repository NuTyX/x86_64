description='Broadcom Wireless driver for the 6.12 LTS Linux kernel version'
url='https://docs.broadcom.com/docs/12358410'

packager="spiky <spiky@nutyx.org>"
contributors="Skythrew,Tnut"


name=broadcom-wl-kernel-612
version=6.30.223.271
release=9

run=(kernel-612)
KERNELNAME="${name#broadcom-wl-}"

source=(kernel-6.12.patch
        https://sourceforge.net/projects/nutyx/files/sources/broadcom-wl/broadcom-wl-$version.tar.xz)

prepare() {
cd broadcom-wl-$version
patch -Np1 -i ../kernel-6.12.patch
}

build() {
KERNEL_VERSION="$(basename /usr/lib/modules/6.12.*)"
cd broadcom-wl-${version}

make -C /usr/lib/modules/${KERNEL_VERSION}/build M=$(pwd)

install -Dm755 wl.ko \
$PKG/usr/lib/modules/$KERNELNAME/kernel/drivers/net/wireless/wl.ko

xz $PKG/usr/lib/modules/$KERNELNAME/kernel/drivers/net/wireless/wl.ko

#Blacklist some kernel modules
mkdir -pv $PKG/etc/modprobe.d

cat > $PKG/etc/modprobe.d/broadcom-wl-kernel.conf << EOF
# wireless drivers (conflict with Broadcom hybrid wireless driver 'wl')
blacklist ssb
blacklist bcma
blacklist b43
blacklist brcmsmac
EOF
echo "depmod -a ${KERNEL_VERSION}" > $PKGMK_ROOT/$name.post-install
}
