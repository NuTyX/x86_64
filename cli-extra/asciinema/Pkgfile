description="Record and share terminal sessions"
url="https://asciinema.org/"

packager="tnut <tnut@nutyx.org>"
contributors="Delta,Spiky"

makedepends=(cargo-c)

name=asciinema
version=3.0.1
release=1


PKGMK_KEEP_SOURCES="no"

source=(https://github.com/asciinema/asciinema/archive/refs/tags/v$version.tar.gz)

build() {
cd $name-$version
env ASCIINEMA_GEN_DIR="." \
cargo build --release

install -Dm755 -t $PKG/usr/bin/ target/release/$name
install -Dm644 -t $PKG/usr/share/licenses/$name/ LICENSE
install -Dm644 -t $PKG/usr/share/doc/$name/ README.md
install -Dm644 -t $PKG/usr/share/man/man1/ man/*.1

install -Dm644 -t $PKG/usr/share/bash-completion/completions/ \
completion/$name.bash
unset ASCIINEMA_GEN_DIR
}
