description="A system and process level monitor."
url="http://www.atoptool.nl/"

contributors="Rems,Spiky"
packager="tnut <tnut@nutyx.org>"

makedepends=(ncurses glib zlib)

name=atop
version=2.11.0
release=2

source=(http://www.atoptool.nl/download/atop-${version/_/-}.tar.gz)

prepare() {
  mkdir -p $PKG/etc/default
}

build() {
  cd $name-$version
  make DESTDIR=$PKG install SBINPATH=/usr/bin \
  SYSDPATH=/usr/lib/systemd/system
}

package() {

cat  > $PKG/etc/default/atop << EOF
## default options
#LOGOPTS="-R"
## default interval in seconds
#LOGINTERVAL=600
## default number of days
#LOGGENERATIONS=28
EOF
}
