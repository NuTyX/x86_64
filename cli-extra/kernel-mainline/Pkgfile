url="https://www.kernel.org"
description="The latest development kernel version"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(gmp mpc bison flex perl libelf diffutils tar)
run=(nutyx kmod)

alias=(linux-mainline)

PKGMK_IGNORE_UNPACK="yes"
PKGMK_NO_STRIP="yes"
PKGMK_GROUPS=(devel doc)
PKGMK_KEEP_SOURCES="no"

name=kernel-mainline
version=6.19-rc8
SUFFIX="${name/*-/}"
INITRD="initrd-$SUFFIX"
KERNEL="$name"

_version=${version}

# Linux patch version
[ "${_version}" != "${version}" ] && patchname="patch-$version.xz"

## Download all the sources
#

source=(https://git.kernel.org/torvalds/t/linux-${_version}.tar.gz config)

[ -z $patchname ] || source+=" $url/pub/linux/kernel/v6.x/$patchname"
## Time to build everything
#

prepare() {
mkdir -p $PKG/{boot,usr/{share/doc,src,lib/modules}}
bsdtar -p -o -C $SRC -xf linux-${_version}.tar.gz
cd linux-${_version}

[ -f $SRC/patch-$version.xz ] && \
xz -d -c  $SRC/patch-$version.xz | patch -Np1

echo "-$release-nutyx" > localversion

cp ../config .config
make olddefconfig
diff -u ../config .config || true
}

build() {

cd linux-${_version}
KERNELRELEASE=$(make -s kernelrelease)
IMAGENAME=$(make -s image_name)
#make menuconfig
make
cp .config ${PKGMK_ROOT}/config
ZSTD_CLEVEL=19                 \
make INSTALL_MOD_PATH=$PKG/usr \
INSTALL_MOD_STRIP="-s"         \
DEPMOD=/dev/null modules_install
depmod -b $PKG -a $KERNELRELEASE

cp System.map $PKG/boot/System.map-$KERNELRELEASE
cp .config $PKG/boot/config-$KERNELRELEASE
cp $IMAGENAME $PKG/boot/$name

mv $SRC/linux-${_version} $PKG/usr/src/$name
ln -sv $name $PKG/usr/src/linux-${_version}
mv $PKG/usr/src/$name/Documentation \
$PKG/usr/share/doc/$name

# Reorganise files
cd $PKG/usr/lib/modules
mv $KERNELRELEASE $name
ln -sv $name $KERNELRELEASE

rm $KERNELRELEASE/build
ln -sv /usr/src/$name $KERNELRELEASE/build

# Firmware are in linux-firmware
rm -rf $PKG/lib/firmware

# post-install autogen
echo "if [ -f boot/$INITRD ]; then
    mkinitramfs $KERNELRELEASE
    rm boot/$INITRD
    mv boot/initrd-$KERNELRELEASE boot/$INITRD
fi" > $PKGMK_ROOT/$name.post-install

}
devel() {
cd $PKG
rm -r usr/src/linux-${_version}/{block,drivers,fs,ipc,init,net,mm,samples,security,sound,virt}
find  usr/src/linux-${_version}/ -type f -name "*.o"  \
-o -name "*.ko" -o -name "*.cmd" -o -name "*.gcno" -delete
mv usr/src/linux-${_version}/arch/x86 usr/src/linux-${_version}/arch/.x86
rm -rf usr/src/linux-${_version}/arch/*
mv usr/src/linux-${_version}/arch/.x86 usr/src/linux-${_version}/arch/x86

bsdtar -cf \
$PKGMK_PACKAGE_DIR/$name.devel${PKGMK_PACKAGE_EXT}$version-$release \
usr/src
rm -r usr/src
}

doc() {
cd $PKG
bsdtar -cf \
$PKGMK_PACKAGE_DIR/$name.doc${PKGMK_PACKAGE_EXT}$version-$release \
usr/share/doc/$name
rm -r usr/share
}
