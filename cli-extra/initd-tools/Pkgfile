description="The initd-tools package contains programs to install and remove LSB based bootscripts." 
url="https://people.freedesktop.org/~dbn/initd-tools/"

contributors="Berlius, Greg"
packager="tnut <tnut@nutyx.org>"

name=initd-tools
version=0.1.3	
release=3

source=(https://people.freedesktop.org/~dbn/initd-tools/releases/$name-$version.tar.gz)
 
build() {

	cd $name-$version
	./configure --prefix=/ --mandir=/usr/share/man \
          --sbindir=/usr/sbin
	make
	make DESTDIR=$PKG install	
}
