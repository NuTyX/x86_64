drwxr-xr-x	root/root	lib/
drwxr-xr-x	root/root	lib/lsb/
-rwxr-xr-x	root/root	lib/lsb/install_initd
-rwxr-xr-x	root/root	lib/lsb/remove_initd
drwxr-xr-x	root/root	sbin/
lrwxrwxrwx	root/root	sbin/install_initd -> ../lib/lsb/install_initd
lrwxrwxrwx	root/root	sbin/remove_initd -> ../lib/lsb/remove_initd
drwxr-xr-x	root/root	usr/
drwxr-xr-x	root/root	usr/share/
