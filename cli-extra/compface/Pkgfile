description="Utils & libs to convert from/to X-Face format."
url="http://ftp.xemacs.org/pub/xemacs/aux/"
packager="spiky <spiky@nutyx.org>"
contributors="Tnut,Greg"

makedepends=(autoconf)

name=compface
version=1.5.2
release=2

source=(http://mirrors.ibiblio.org/xemacs/aux/$name-$version.tar.gz
		compface-1.5.2-build.patch
         compface-c99.patch
         compface-modern-c-porting.patch)

prepare() {

  cd $name-$version
  patch -Np0 -i $SRC/compface-1.5.2-build.patch
  patch -Np1 -i ../compface-c99.patch
  patch -Np1 -i ../compface-modern-c-porting.patch

  autoreconf -vfi
  
}

build() {

  cd $name-$version
  CFLAGS="$CFLAGS -fPIC"
  ./configure --prefix=/usr --mandir=/usr/share/man
  make
  
}

package() {

  cd $name-$version
  make DESTDIR=$PKG STRIP=/bin/true install

}
