description="Alternate menu for Xfce4"
url="https://gottcode.org/xfce4-whiskermenu-plugin/"

license="GPL2"

packager="tnut <tnut@nutyx.org>"
contributors="Greg,Spiky"

makedepends=(libxfce4util libxfce4ui
             cmake xfce4-panel accountsservice gtk-layer-shell)
set=(xfce4-extra)

name=xfce4-whiskermenu-plugin
version=2.10.1

source=(https://archive.xfce.org/src/panel-plugins/$name/${version%.*}/$name-$version.tar.xz)

build() {

cd $name-$version

cmake \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib

make
make DESTDIR=$PKG install

install -Dm644 COPYING $PKG/usr/share/licenses/$name/COPYING

}
