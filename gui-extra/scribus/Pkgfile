description='Desktop publishing software'
url='https://www.scribus.net'

packager="tnut <tnut@nutyx.org>"
contributors="Pierre, Spiky"

makedepends=(git icu cmake boost aspell cups qt6-tools qt6-declarative qt6-5compat
             qt6-svg gnutls kerberos hunspell
             podofo librevenge boost ghostscript lcms2 libxml2 cairo poppler)

run=(shared-mime-info desktop-file-utils)

name=scribus
version=2b9405a
release=1

source=(https://github.com/scribusproject/scribus.git)


build() {
    cd $name-$version
    mkdir build
    cd build
    cmake ../ -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_SKIP_RPATH=ON \
        -DWANT_CPP17=ON \
        -DLIB_SUFFIX=""

    make
    make DESTDIR=$PKG install
    install -Dm644 ../scribus.desktop \
        $PKG/usr/share/applications/scribus.desktop
        
}
