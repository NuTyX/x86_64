description="A web browser built for speed, simplicity, and security"
url="https://www.chromium.org/Home"

license="BSD"

packager="spiky <spiky@nutyx.org>"
maintainer="Arch Linux"
contributors="Tnut"

run=(minizip gtk3 ffmpeg flac dbus freetype brotli woff2
     xorg-libxscrnsaver libxslt nss snappy json-glib llvm
     hicolor-icon-theme desktop-file-utils libaom dav1d libavif
     gtk-update-icon-cache shared-mime-info abseil-cpp)

name=chromium
version=135.0.7049.95

icuversion=75.1

re2version=2024-07-02
PKGMK_IGNORE_RUNTIMELIBS="yes"

source=(https://github.com/unicode-org/icu/releases/download/\
release-${icuversion//./-}/icu4c-${icuversion//./_}-src.tgz
        https://mirror.puzzle.ch/archlinux/pool/packages/$name-$version-1-x86_64.pkg.tar.zst)

prepare() {
cd icu/source
./configure
make
}

build() {

mv usr $PKG
mkdir -p $PKG/etc/ld.so.conf.d
# in conflict with the installed one
rm $PKG/usr/lib/chromium/libvulkan.so.1

echo "/usr/lib/chromium" > $PKG/etc/ld.so.conf.d/$name.conf
}

package() {
for LIB in libicui18n.so libicuuc.so libicudata.so
do
   cp icu/source/lib/$LIB.$icuversion \
   $PKG/usr/lib/chromium/$LIB.$icuversion
done
}
