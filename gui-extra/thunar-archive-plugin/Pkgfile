description="Adds archive operations to the Thunar file context menus"
url="https://gitlab.xfce.org/thunar-plugins/thunar-archive-plugin"

license="LGPL2"

packager="spiky <spiky@nutyx.org>"
contributors="Tyrry,Greg,Tnut"

makedepends=(xfce4-dev-tools)
run=(desktop-file-utils thunar)

name=thunar-archive-plugin
version=0.6.0

source=(https://archive.xfce.org/src/thunar-plugins/thunar-archive-plugin/${version%.*}/${name}-${version}.tar.xz)

build() {

cd $name-$version

mkdir build
cd    build

meson setup .. \
     --prefix=/usr          \
     --buildtype=release

ninja

DESTDIR=$PKG ninja install

 install -Dm644 ../COPYING $PKG/usr/share/licenses/$name/COPYING
}
