description="A lm_sensors plugin for the Xfce panel."
url="http://goodies.xfce.org/"

license="GPL2"

packager="spiky <spiky@nutyx.org>"
contributors="Tyrry,Greg,Fabienwang,Tnut"

makedepends=(libxfce4util libxfce4ui xfce4-panel libnotify)
run=(lm-sensors hicolor-icon-theme)

set=(xfce4-extra)

name=xfce4-sensors-plugin
version=1.5.0

source=(https://archive.xfce.org/src/panel-plugins/$name/${version:0:3}/$name-$version.tar.xz)

build() {

cd $name-$version

mkdir build
cd    build

meson setup .. \
     --prefix=/usr          \
     --buildtype=release

ninja

DESTDIR=$PKG ninja install

install -Dm644 ../COPYING $PKG/usr/share/licenses/$name/COPYING
}
