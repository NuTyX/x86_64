description="Extension for GNOME Shell to combine the dash and main panel'"
url='https://github.com/home-sweet-gnome/dash-to-panel'

license="GPL-2.0-or-later"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(meson jq libayatana-appindicator)
run=(gnome-shell)
set=(gnome)

name=gnome-shell-extension-dash-to-panel
version=v73
release=1

source=($name-fix-crash-on-close.patch
        $name-fix-crash-on-shutdown.patch
        https://github.com/home-sweet-gnome/dash-to-panel.git)


prepare() {
 cd $name-$version
 patch -Np1 -i ../$name-fix-crash-on-close.patch
 patch -Np1 -i ../$name-fix-crash-on-shutdown.patch
}

build() {
 cd $name-$version
 make
}

package() {
 cd $name-$version
 make VERSION=$version DESTDIR=$PKG install
 install -Dm644 COPYING \
 $PKG/usr/share/licenses/$name/COPYING
}
