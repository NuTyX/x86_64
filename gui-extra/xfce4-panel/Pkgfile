description="Panel for the Xfce desktop environment."
url="https://www.xfce.org/"

license="GPL2 LGPL2.1"

packager="tnut <tnut@nutyx.org>"
contributors="Tyrry,Greg,Fabienwang,Spiky"

makedepends=(exo garcon libwnck libxfce4ui gtk-doc gtk3 libxfce4windowing)
run=(bazaar)

set=(xfce4)

name=xfce4-panel
version=4.20.7
release=2

source=(default-xml.patch
        http://archive.xfce.org/src/xfce/$name/${version%.*}/$name-$version.tar.bz2)

prepare() {
 cd $name-$version
 patch -Np1 -i ../default-xml.patch
 sed -i "s/org.xfce.panel.applicationsmenu\"/nutyx\"/" \
 plugins/applicationsmenu/applicationsmenu.c
}

build() {

cd $name-$version

./configure --prefix=/usr \
--sysconfdir=/etc
make
make DESTDIR=$PKG install

install -Dm644 COPYING $PKG/usr/share/licenses/$name/COPYING
install -Dm644 COPYING.LIB $PKG/usr/share/licenses/$name/COPYING.LIB
}
