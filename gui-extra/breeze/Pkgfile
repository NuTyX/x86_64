description='Artwork, styles and assets for the Breeze visual style for the Plasma Desktop'
url='https://www.kde.org/plasma-desktop/'

license="GPL-2.0-or-later"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

set=(kde6 kde6-plasma)

name=breeze
version=6.7.2
release=1

makedepends=(qt6-base qt6-svg qt6-declarative extra-cmake-modules frameworkintegration
             kcmutils kcolorscheme kconfig kcoreaddons kdecoration kguiaddons
             ki18n kiconthemes kirigami kwidgetsaddons kwindowsystem)
run=(breeze-icons)

source=(https://download.kde.org/stable/plasma/$version/$name-$version.tar.xz
        https://download.sourceforge.net/nutyx/NuTyX-26.06-1.tar.xz)

build() {
 cmake -B build $name-$version \
  -DCMAKE_INSTALL_PREFIX=/usr  \
  -DCMAKE_BUILD_TYPE=Release   \
  -DCMAKE_INSTALL_LIBDIR=lib   \
  -DBUILD_QT5=OFF              \
  -DBUILD_TESTING=OFF          \
  -Wno-dev

 cmake --build build

 DESTDIR=$PKG cmake --install build

}

package() {
 mv NuTyX-26.06 $PKG/usr/share/wallpapers
}
