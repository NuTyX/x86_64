description="AppIndicator/KStatusNotifierItem support for GNOME Shell"
url="https://github.com/ubuntu/gnome-shell-extension-appindicator"

license="GPL2"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(meson jq libayatana-appindicator)
run=(gnome-shell)
set=(gnome-extra)

name=gnome-shell-extension-appindicator
version=64

source=(https://github.com/ubuntu/$name/archive/refs/tags/v${version}.tar.gz)

build=meson

package() {
 rm $PKG/usr/share/glib-2.0/schemas/gschemas.compiled
 install -Dm644 $name-$version/LICENSE $PKG/usr/share/licenses/$name/LICENSE
}
