description='GNU Image Manipulation Program'
url='https://www.gimp.org/'

license="LGPL3 GPL3"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(gtk3 curl libexif xorg-libxmu xorg-libxpm openexr libgexiv2
             gegl poppler-glib glib-networking libmng alsa-lib libwmf
             babl libmypaint mypaint-brushes lcms2 libgexiv2 aalib appstream
             harfbuzz libjpeg-turbo librsvg libtiff libxml2 appstream-glib)

name=gimp
version=3.2.2

PKGMK_MESON_OPTIONS="-Dgi-docgen=disabled \
-Dbug-report-url=https://github.com/NuTyX/x86_64/issues"

source=(https://download.gimp.org/gimp/v${version:0:3}/gimp-$version.tar.xz)

prepare() {
 localedef -i en_US -f UTF-8 en_US.UTF-8
}
build=meson
packager() {
 cd $name-$version
 install -Dm644 LICENSE $PKG/usr/share/licenses/$name/LICENSE
 install -Dm644 COPYING $PKG/usr/share/licenses/$name/COPYING
 install -Dm644 libgimp/COPYING $PKG/usr/share/licenses/$name/COPYING
}
