description='A framework for searching and managing metadata'
url='https://community.kde.org/Frameworks'

license="LGPL-2.0-only LGPL-3.0-only"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

set=(kde6-frameworks)

name=baloo
version=6.23.0

makedepends=(lmdb kconfig kcoreaddons kcrash
             kdbusaddons kfilemetadata ki18n kidletime
             kio solid qt6-base qt6-declarative qt6-tools)

run=(hicolor-icon-theme xdg-utils)

source=(sys-ioprio-set.patch
        https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz)

prepare() {
 cd $name-$version
 patch -Np1 -i  ../sys-ioprio-set.patch
}

build=kde6
