+++ b/src/plugins/contrib/wxSmith/wxsresourcetree.cpp
@@ -64,7 +64,7 @@ END_EVENT_TABLE()
 
 
 wxsResourceTree::wxsResourceTree(wxWindow* Parent)
-    : wxTreeCtrl(Parent,-1)
