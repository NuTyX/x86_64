description="Many plugins for geany"
url="https://plugins.geany.org/"

contributors="Greg,Spiky"
packager="tnut <tnut@nutyx.org>"

run=(geany)

name=geany-plugins
version=2.1
release=1

source=(https://plugins.geany.org/geany-plugins/$name-$version.tar.bz2)


build() {
  cd $name-$version
  export CFLAGS+=' -Wno-incompatible-pointer-types -w' PYTHON=/usr/bin/python
  ./configure \
    --libexecdir=/usr/lib \
    --prefix=/usr
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make

make DESTDIR=$PKG install
}
