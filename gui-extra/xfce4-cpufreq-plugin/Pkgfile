description="CPU frequency plugin for the Xfce4 panel"
url="http://goodies.xfce.org/projects/panel-plugins/xfce4-cpufreq-plugin"

license="GPL2"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Greg,Fabienwang,Tnut"

makedepends=(libxfce4util libxfce4ui xfce4-panel)

set=(xfce4-extra)

name=xfce4-cpufreq-plugin
version=1.3.0

source=(https://archive.xfce.org/src/panel-plugins/$name/${version%.*}/$name-$version.tar.xz)

build() {
cd $name-$version

mkdir build
cd    build

meson setup .. \
     --prefix=/usr          \
     --buildtype=release

ninja

DESTDIR=$PKG ninja install

install -Dm644 ../COPYING $PKG/usr/share/licenses/$name/COPYING
}
