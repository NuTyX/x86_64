description="plugin Weather for Xfce"
url="http://goodies.xfce.org/projects/panel-plugins/xfce4-weather-plugin"

license="GPL2"

packager="spiky <spiky@nutyx.org>"
contributors="Fabienwang,PierreB,Greg,Tnut"

makedepends=(libxfce4util libxfce4ui libsoup xfce4-panel json-c)

set=(xfce4-extra)

name=xfce4-weather-plugin
version=0.12.0

source=(https://archive.xfce.org/src/panel-plugins/$name/${version:0:4}/$name-$version.tar.xz)

build() {

cd $name-$version

mkdir build
cd    build

meson setup .. \
     --prefix=/usr          \
     --buildtype=plain

ninja

DESTDIR=$PKG ninja install

install -Dm644 ../COPYING $PKG/usr/share/licenses/$name/COPYING

}
