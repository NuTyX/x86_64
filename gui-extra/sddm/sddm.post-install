. lib/lsb/init-functions

if [ ! -L etc/systemd/system/display-manager.service ];then
  systemctl enable sddm
else
  ACTIVE_SERVICE="$(readlink /etc/systemd/system/display-manager.service)"
  log_warning_msg "${WARNING} display-manager already exist: ${ACTIVE_SERVICE}${NORMAL}"
fi
sed -i "s@system-local-login@system-login@" etc/pam.d/sddm-autologin
