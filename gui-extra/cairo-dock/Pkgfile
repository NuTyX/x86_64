description="Light eye-candy fully themable animated dock"
url="https://github.com/Cairo-Dock/cairo-dock-core"

license="GPL-3.0-or-later"

packager="tnut <tnut@nutyx.org>"
contributors="Dania,Spiky"

makedepends=(cairo cmake curl dbus-glib xorg-glu gtk3)

name=cairo-dock
version=3.6.1

source=($url/archive/refs/tags/$version.tar.gz)

build() {

  cmake -B build                   \
    -S $name-core-$version         \
    -D CMAKE_BUILD_TYPE=None       \
    -D enable-desktop-manager=True \
    -D enable-systemd-service=True \
    -D CMAKE_INSTALL_PREFIX='/usr'
  cmake --build build
  DESTDIR=$PKG cmake --install build
}
