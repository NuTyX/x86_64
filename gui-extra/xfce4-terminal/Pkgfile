url="http://www.os-cillation.com/index.php?id=42&L=5"
description="Terminal emulator from Xfce4."

license="GPL2"

packager="spiky <spiky@nutyx.org>"

makedepends=(libxfce4util libxfce4ui exo vte)
set=(xfce4-extra)

name=xfce4-terminal
version=1.1.5

source=(https://archive.xfce.org/src/apps/${name}/${version:0:3}/$name-$version.tar.xz)

build() {
cd $name-$version

    mkdir build
cd    build

meson setup .. \
     --prefix=/usr          \
     --buildtype=release

ninja

DESTDIR=$PKG ninja install

install -Dm644 ../COPYING $PKG/usr/share/licenses/$name/COPYING
}
