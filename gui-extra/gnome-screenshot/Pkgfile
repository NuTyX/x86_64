description="Take pictures of your screen"
url="http://www.gnome.org/"

packager="spiky <spiky@nutyx.org>"
contributors="Remy, Jayce, tnut"

makedepends=(meson ninja gtk3 libcanberra libhandy)
run=(gsettings-desktop-schemas desktop-file-utils gtk-update-icon-cache)

set=(gnome)

name=gnome-screenshot
version=41.0
release=2

source=(https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz)

prepare() {
cd $name-$version
sed -i '/merge_file/{n;d}' data/meson.build
}

build() {

    meson setup --prefix /usr \
    --buildtype  release      \
    $name-$version            builddir

    meson compile -C          builddir

DESTDIR=$PKG meson install -C builddir
}
