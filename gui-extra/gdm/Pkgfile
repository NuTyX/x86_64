description="Library for Graphical logins and managing local and remote displays."
url="https://gitlab.gnome.org/GNOME/gdm"

license="GPL2"

packager="tnut <tnut@nutyx.org>"
contributors="Fanch,Schrodinger72,Spiky"

makedepends=(pam accountsservice nss libcanberra
             gnome-session gnome-shell libdaemon
             libhandy gtk3 systemd)
run=(xorg-xinit xorg-xhost xorg-xrdb upower iso-codes)

set=(gnome)

name=gdm
version=49.1
release=2

PKGMK_MESON_OPTIONS="-Dgdm-xsession=true \
-Ddefault-pam-config=lfs \
-Drun-dir=/run/gdm  \
--localstatedir=/var \
--libdir=/usr/lib"

source=($url/-/archive/$version/$name-$version.tar.bz2)

prepare() {
getent group gdm || groupadd -g 21 gdm
getent passwd gdm || ( useradd -c "GDM Daemon Owner" \
        -d /var/lib/gdm -u 21 \
        -g gdm -s /bin/false gdm )
passwd -ql gdm
}
build=meson

package() {
  install -Dm644 $name-$version/COPYING $PKG/usr/share/licenses/$name/COPYING
}
