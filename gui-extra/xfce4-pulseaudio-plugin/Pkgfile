description="Pulseaudio plugin for Xfce4 panel"
url="https://goodies.xfce.org/projects/panel-plugins/xfce4-pulseaudio-plugin"

license="GPL2"

packager="spiky <spiky@nutyx.org>"
makedepends=(git pulseaudio dbus-glib pavucontrol keybinder3
             libnotify xfce4-dev-tools libxfce4util libxfce4ui
             xfce4-panel)
run=(gtk-update-icon-cache pavucontrol)
set=(xfce4-extra)

name=xfce4-pulseaudio-plugin
version=0.5.1

source=(http://archive.xfce.org/src/panel-plugins/$name/${version:0:3}/$name-$version.tar.xz)

build() {
cd $name-$version

mkdir build
cd    build

meson setup .. \
     --prefix=/usr          \
     --buildtype=release

ninja

DESTDIR=$PKG ninja install

install -Dm644 ../COPYING $PKG/usr/share/licenses/$name/COPYING
}
