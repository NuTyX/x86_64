description="Brasero is an application used to burn CD/DVD on the GNOME Desktop"
url="https://www.gnome.org"

packager="tnut <tnut@nutyx.org>"
contributors="Jayce,Spiky"

makedepends=(icu gstreamer-plugins-base itstool
             libcanberra libnotify gobject-introspection libburn
             libisofs gvfs dvd+rw-tools libdvdcss cdrdao
             json-glib)
run=(shared-mime-info)

name=brasero
version=3.12.3
release=6

source=(https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz
        brasero-3.12.3-upstream_fixes-1.patch)

prepare() {
cd $name-$version

patch -Np1 -i ../brasero-3.12.3-upstream_fixes-1.patch
}

build() {
cd $name-$version

./configure --prefix=/usr                \
            --enable-compile-warnings=no \
            --enable-cxx-warnings=no     \
            --disable-nautilus

make

make DESTDIR=$PKG install
}
