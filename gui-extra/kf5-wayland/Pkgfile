description="Qt-style Client and Server library wrapper for the Wayland libraries"
url="https://www.kde.org/"

license="LGPL"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

set=(kde5-frameworks)

name=kf5-wayland
version=5.116.0
release=1

_name=kwayland

makedepends=(patch qtbase qtwayland qttools extra-cmake-modules
             plasma-wayland-protocols wayland-protocols)

source=(0954a179.patch
        https://download.kde.org/stable/frameworks/${version%.*}/${_name}-$version.tar.xz)

prepare() {
 mv ${_name}-$version $name-$version
 cd $name-$version
 patch -Np1 -i ../0954a179.patch
}
build=kde5
