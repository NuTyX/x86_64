description="The GNOME Terminal Emulator"
url="https://wiki.gnome.org/Apps/Terminal"

license="GPL-3.0-or-later"

packager="tnut <tnut@nutyx.org>"
contributors="Jayce,Fanch,Rems,Skythrew,Spiky"

makedepends=(dconf gtk3 vte nautilus gnome-shell yelp-tools)
run=(gsettings-desktop-schemas desktop-file-utils gtk-update-icon-cache)

set=(cinnamon)

name=gnome-terminal
version=3.58.0

source=(https://gitlab.gnome.org/GNOME/$name/-/archive/$version/$name-$version.tar.bz2)

prepare() {
cd $name-$version
sed -i -r 's:"(/system):"/org/gnome\1:g' src/external.gschema.xml
}

build() {
cd $name-$version

mkdir build
cd    build

      meson setup         \
      --prefix=/usr       \
      --buildtype=release \
      ..

ninja

DESTDIR=$PKG ninja install

install -Dm644 ../COPYING $PKG/usr/share/licenses/$name/COPYING
}
