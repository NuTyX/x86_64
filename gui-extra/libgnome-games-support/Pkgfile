description='Code shared between GNOME games'
url='https://gitlab.gnome.org/GNOME/libgnome-games-support'

license="GPL3, LGPL3"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky, Schrodinger72"

makedepends=(vala git autoconf-archive libgee gtk4)

name=libgnome-games-support
version=2.0.1
release=2

source=(https://gitlab.gnome.org/GNOME/libgnome-games-support/-/archive/$version/$name-$version.tar.gz)

build=meson

package() {
 install -Dm644 $name-$version/COPYING \
 $PKG/usr/share/licenses/$name/COPYING
 install -Dm644 $name-$version/COPYING.LESSER \
 $PKG/usr/share/licenses/$name/COPYING.LESSER
}

