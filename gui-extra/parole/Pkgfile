description="A modern media player based on the GStreamer framework"
url="http://goodies.xfce.org/projects/applications/parole"

license="GPL2"

packager="spiky <spiky@nutyx.org>"
contributors="Tyrry,Greg,Fabianwang,Tnut"

makedepends=(libxfce4ui libnotify dbus-glib libdvdcss libdvdnav libdvdread)
run=(startup-notification gstreamer-plugins-base gstreamer-plugins-good)

set=(xfce4-extra)

name=parole
version=4.20.0

source=(https://archive.xfce.org/src/apps/parole/${version:0:4}/parole-$version.tar.xz)

build() {
cd $name-$version

mkdir build
cd    build

meson setup .. \
     --prefix=/usr          \
     --buildtype=release

ninja

DESTDIR=$PKG ninja install

install -Dm644 ../COPYING $PKG/usr/share/licenses/$name/COPYING
}
