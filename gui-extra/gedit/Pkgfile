description="A text editor for GNOME"
url="https://gitlab.gnome.org/GNOME/gedit"

license="GPL2"

packager="spiky <spiky@nutyx.org>"
contributors="Jayce,Fanch,Tnut"

makedepends=(meson ninja libpeas yelp-xsl enchant iso-codes
             libgedit-gtksourceview gspell enchant git
             libsoup python-gobject python libgedit-tepl)
run=(gsettings-desktop-schemas desktop-file-utils gtk-update-icon-cache gvfs)

name=gedit
version=50.0
release=2


PKGMK_MESON_OPTIONS="-Dgtk_doc=false"

source=(https://gitlab.gnome.org/World/gedit/gedit.git)

prepare() {
  git clone https://gitlab.gnome.org/GNOME/libgd.git

  cd $name-$version
  git submodule init
  git submodule set-url subprojects/libgd $SRC/libgd
  git -c protocol.file.allow=always submodule update
}

build=meson

package() {

install -Dm644 $name-$version/COPYING $PKG/usr/share/licenses/$name/COPYING
}

