description="Mousepad is a simple GTK+ text editor for the Xfce desktop environment."
url="http://www.xfce.org/projects/mousepad/"

license="GPL2"

packager="spiky <spiky@nutyx.org>"
contributors="Tyrry,Fabienwang,Tnut"

makedepends=(dbus-glib xorg-libxrandr xorg-libxinerama
             xorg-libsm xfconf gspell libxfce4ui)
run=(gtk-update-icon-cache desktop-file-utils startup-notification gtksourceview4)

set=(xfce4)

name=mousepad
version=0.6.5

source=(http://archive.xfce.org/src/apps/$name/${version%.*}/$name-$version.tar.xz)

build() {
cd $name-$version

mkdir build
cd    build

meson setup .. \
     --prefix=/usr          \
     --buildtype=release

ninja

DESTDIR=$PKG ninja install

install -Dm644 ../COPYING $PKG/usr/share/licenses/$name/COPYING
}
