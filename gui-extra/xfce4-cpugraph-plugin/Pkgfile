description="monitor of charge CPU for Xfce"
url="http://goodies.xfce.org/projects/panel-plugins/xfce4-cpugraph-plugin"

license="GPL"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,B,Greg,Fabienwang,Tnut"

makedepends=(libxfce4util libxfce4ui xfce4-panel)

set=(xfce4-extra)

name=xfce4-cpugraph-plugin
version=1.3.0

source=(https://archive.xfce.org/src/panel-plugins/$name/${version:0:3}/$name-$version.tar.xz)

build() {

cd $name-$version

mkdir build
cd    build

meson setup .. \
     --prefix=/usr          \
     --buildtype=release

ninja

DESTDIR=$PKG ninja install

install -Dm644 ../COPYING $PKG/usr/share/licenses/$name/COPYING
install -Dm644 ../COPYING.GPLv2 $PKG/usr/share/licenses/$name/COPYING.GPLv2
}
