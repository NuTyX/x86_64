description="Simply a pdf document viewer"
url="https://mate-desktop.org/"

packager="tnut <tnut@nutyx.org>"
contributors="Fanch,Greg,Jayce,Spiky"

makedepends=(djvulibre libsecret libspectre
             poppler-glib poppler webkitgtk libsynctex)

set=(xfce4-extra)

name=atril
version=1.28.2
release=2

PKGMK_KEEP_SOURCES="no"

source=(mate-desktop.patch
        https://github.com/mate-desktop/atril/archive/refs/tags/v$version.tar.gz)

prepare() {
  cd $name-$version
  sed -i "/mate_desktop/d" meson.build

  patch -Np1 -i ../mate-desktop.patch
}

build=meson

package() {
  install -Dm644 $name-$version/COPYING $PKG/usr/share/licenses/$name/COPYING
}
