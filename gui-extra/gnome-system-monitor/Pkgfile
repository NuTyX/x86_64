description="A system monitor for GNOME"
url="https://apps.gnome.org/SystemMonitor"

license="GPL2"

packager="tnut <tnut@nutyx.org>"
contributors="Jayce,Remy,Fanch,Spiky"

makedepends=(meson adwaita-icon-theme itstool gtkmm4
             libgtop libwnck librsvg gnome-icon-theme catch2)
run=(gsettings-desktop-schemas desktop-file-utils libhandy libadwaita)

set=(gnome)

name=gnome-system-monitor
version=50.0
release=1

source=(https://gitlab.gnome.org/GNOME/gnome-system-monitor/-/archive/$version/$name-$version.tar.bz2)

build=meson

package() {
 install -Dm644 $name-$version/COPYING $PKG/usr/share/licenses/$name/COPYING
}
