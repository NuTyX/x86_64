description="A window switcher, application launcher and dmenu replacement"
url="https://github.com/DaveDavenport/rofi/"

packager="spiky <spiky@nutyx.org>"
contributors="Rocket"

makedepends=(check glib librsvg libxkbcommon pango xcb-util-keysyms
             xcb-util xcb-util-wm xcb-util-xrm xcb-util-cursor)
run=(startup-notification)

name=rofi
version=2.0.0

source=(https://github.com/DaveDavenport/rofi/releases/download/$version/$name-$version.tar.gz
        fix_xfce4-terminal_binary_name.patch)

prepare() {
cd  $name-$version
patch -Np1 -i ../fix_xfce4-terminal_binary_name.patch
}

build=meson
