description="The GNOME Scientific calculator"
url="https://apps.gnome.org/Calculator"

license="GPL3-or-later"

packager="spiky <spiky@nutyx.org>"
contributors="Jayce,Fanch,Remy,Tnut"

makedepends=(mpc libgee gtksourceview5 gtk4 itstool libsoup3 meson ninja vala libadwaita
             blueprint-compiler)
run=(gsettings-desktop-schemas desktop-file-utils gtk-update-icon-cache libhandy)

set=(gnome)

name=gnome-calculator
version=50.0
release=2

source=(https://gitlab.gnome.org/GNOME/$name/-/archive/$version/$name-$version.tar.bz2)

build=meson

package() {
 install -Dm644 $name-$version/COPYING \
 $PKG/usr/share/licenses/$name/COPYING
}
