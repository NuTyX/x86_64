description="Collection of graphical tools for Software to be used in the GNOME desktop"
url="https://apps.gnome.org/Software"

license="GPL-2.0-or-later"
set=(gnome)

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"

name=gnome-software
version=50.3

makedepends=(flatpak packagekit appstream gnome-online-accounts gtk4 libadwaita libsoup3)
run=(gsettings-desktop-schemas)

source=(https://download.gnome.org/sources/$name/${version::2}/$name-$version.tar.xz)

PKGMK_MESON_OPTIONS="-Dfwupd=false -Dmalcontent=false"
PKGMK_GROUPS=(devel doc man)

build=meson

package() {
 install -Dm633 $name-$version/COPYING $name-$version/usr/share/licenses/COPYING
}
