description="GNOME Maps is a map application for GNOME"
url="https://gitlab.gnome.org/GNOME/gnome-maps"

license="GPL2"

packager="spiky <spiky@nutyx.org>"
contributors="Jayce,Fanch,Remy,Fabienwang,Tnut"

makedepends=(meson clutter-gtk geocode-glib blueprint-compiler
             libgee folks libadwaita librest libshumate libportal)
run=(gsettings-desktop-schemas desktop-file-utils gtk-update-icon-cache
    gjs libhandy geoclue2 libgweather-4)

set=(gnome)

name=gnome-maps
version=50.4

source=($url.git)

build=meson

package() {
cd $name-$version
install -Dm644 COPYING $PKG/usr/share/licenses/$name/COPYING
}
