description="GNOME Maps is a map application for GNOME"
url="https://apps.gnome.org/Maps"

license="GPL2"

packager="tnut <tnut@nutyx.org>"
contributors="Jayce,Fanch,Remy,Fabienwang,Spiky"

makedepends=(libchamplain meson clutter-gtk geocode-glib
             libgee folks libadwaita librest libshumate libportal)
run=(gsettings-desktop-schemas desktop-file-utils gtk-update-icon-cache
    gjs libhandy geoclue2 libgweather-4)

set=(gnome)

name=gnome-maps
version=49.2

source=(https://gitlab.gnome.org/GNOME/$name/-/archive/$version/$name-$version.tar.bz2)

build=meson

package() {
cd $name-$version
install -Dm644 COPYING $PKG/usr/share/licenses/$name/COPYING
}
