description="start up the GNOME Desktop environment"
url="https://gitlab.gnome.org/GNOME/gnome-session"

license="GPL2-or-later"

packager="tnut <tnut@nutyx.org>"
contributors="Fanch,Rems,Spiky"

makedepends=(dconf dbus-glib docbook-xml docbook-xsl
             gnome-desktop json-glib libxslt mesa meson upower xmlto)

set=(gnome)

name=gnome-session
version=49.2

PKGMK_MESON_OPTIONS="-Dx11=True -Dman=False -Ddocbook=False"

source=($url/-/archive/$version/$name-$version.tar.bz2)

build=meson

package() {
# Uneeded duplicated entries
rm $PKG/usr/share/wayland-sessions/gnome.desktop

install -Dm644 $name-$version/COPYING $PKG/usr/share/licenses/$name/COPYING
}
