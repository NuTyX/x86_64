description="Extremely fast and lightweight file manager"
url="http://lxde.org/"

packager="spiky <spiky@nutyx.org>"
contributors="Greg,Fabien,Tnut"

run=(libfm lxde-menu-data)
makedepends=(gtk2 perl-xml-parser libfm intltool)

set=(lxde)

name=pcmanfm
version=1.4.0

source=(https://github.com/lxde/pcmanfm/archive/refs/tags/$version.tar.gz)

prepare() {
sed -i  "s@GNOME;XFCE;KDE;MATE;@GNOME;XFCE;KDE;MATE;JWM;@" \
$name-$version/data/pcmanfm-desktop-pref.desktop.in

}

build() {

cd $name-$version

autoreconf -fiv
./configure --sysconfdir=/etc --prefix=/usr \
--with-gtk=3

make
make DESTDIR=$PKG install
}
