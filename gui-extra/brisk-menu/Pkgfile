description="Brisk menu an efficient menu for the MATE"
url="https://github.com/solus-project/brisk-menu"

packager="spiky <spiky@nutyx.org>"
contributors="Jayce,Greg,Tnut"

makedepends=(mate-desktop mate-menus mate-panel meson ninja)
set=(mate)

name=brisk-menu
version=0.6.2

source=(https://github.com/getsolus/brisk-menu/releases/download/v$version/brisk-menu-v$version.tar.xz)

build() {

    meson setup --prefix /usr \
    --buildtype  plain        \
    $name-$version            builddir

    meson compile -C          builddir

DESTDIR=$PKG meson install -C builddir
}
