description="Ristretto is a fast and lightweight picture-viewer for the Xfce desktop environment."
url="http://goodies.xfce.org/projects/applications/ristretto"

license="GPL2"

packager="spiky <spiky@nutyx.org>"
contributors="Tyrry,Greg,Fabienwang,Tnut"

makedepends=(libxfce4util libxfce4ui xorg-libxinerama xorg-libxrandr
             xorg-libsm thunar libexif)
run=(tumbler)

set=(xfce4-extra)

name=ristretto
version=0.13.4

source=(https://archive.xfce.org/src/apps/$name/${version:0:4}/$name-$version.tar.xz)

build() {
cd $name-$version

mkdir build
cd    build

meson setup .. \
     --prefix=/usr          \
     --buildtype=plain

ninja

DESTDIR=$PKG ninja install

install -Dm644 ../COPYING $PKG/usr/share/licenses/$name/COPYING
}
