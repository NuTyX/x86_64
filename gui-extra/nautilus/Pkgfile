description="GNOME file manager"
url="https://apps.gnome.org/Nautilus"

license="GPL-3.0-or-later"

packager="tnut <tnut@nutyx.org>"
contributors="Fanch,Jayce,Remy,Fabienwang,Spiky"

run=(desktop-file-utils gtk-update-icon-cache
     shared-mime-info libportal gtk4 localsearch)
makedepends=(gnome-autoar libnotify gnome-desktop gvfs
             gobject-introspection exempi libexif libgexiv2
             libcloudproviders meson gtk-doc libhandy bubblewrap libadwaita)
set=(gnome)

name=nautilus
version=49.1

source=(https://gitlab.gnome.org/GNOME/nautilus/-/archive/$version/$name-$version.tar.gz)

build() {
  cd $name-$version

  mkdir -p build
  cd build
  meson setup .. \
        --prefix=/usr  \
        --sysconfdir=/etc \
        --libdir=/usr/lib \
        -Dpackagekit=false \
        -Dselinux=false

  ninja
  DESTDIR=$PKG ninja install

  install -Dm644 ../LICENSE $PKG/usr/share/licenses/$name/LICENSE
}
