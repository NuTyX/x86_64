description="Word processing similar to MS® Word, suitable for a wide variety of word processing tasks"
url="https://www.abisource.com/"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre.,Greg,Spiky"

makedepends=(icu boost cairo aspell fribidi enchant wv
             librsvg gtk2 redland
             rasqal gtk3 autoconf-archive)
run=(desktop-file-utils)

name=abiword
version=3.0.5
release=5

source=(http://sourceforge.net/projects/nutyx/files/sources/$name/$name-$version.tar.gz)
		
prepare() {

cd $name-$version
sed -e '/libxml/a #include <libxml/xmlmemory.h>' \
    -i src/af/util/xp/ut_stringbuf.cpp

sed -e "s/free_suggestions/free_string_list/" \
    -e "s/_to_personal//"                     \
    -e "s/in_session/added/"                  \
    -i src/af/xap/xp/enchant_checker.cpp
}

build() {

cd $name-$version

./configure --prefix=/usr \
    --disable-static
make DESTDIR=$PKG install

}
