description="Lightweight, advanced audio player focused simplicity and audio quality"
url="https://audacious-media-player.org"

license="BSD"

packager="tnut <tnut@nutyx.org>"
contributors="Greg,Spiky"

makedepends=(glib qt6-base qt6-svg gtk2 python xorg-libsm gnome-icon-theme)
run=(hicolor-icon-theme desktop-file-utils)

name=audacious
version=4.5.1

source=(https://distfiles.audacious-media-player.org/$name-$version.tar.bz2)

build() {

	cd $name-$version
	
	./configure --prefix=/usr \
          -Dgtk=false \
	--with-buildstamp="NuTyX Linux"
	make
	make DESTDIR=$PKG install
}
