description="Window manager for gnome."
url="https://gitlab.gnome.org/GNOME/mutter"

license="GPL2-or-later"

packager="tnut <tnut@nutyx.org>"
contributors="Jayce,Fanch,Remy,Fabienwang,Spiky"

makedepends=(meson ninja glib xorg-libsm graphene libdisplay-info
             gnome-desktop gnome-settings-daemon libwacom libxkbcommon upower
             gobject-introspection libcanberra startup-notification
             xorg-libxcursor xorg-libxcomposite wayland-protocols libei)

run=(xorg-server zenity pipewire xorg-xwayland)
set=(gnome)

name=mutter
version=49.1.1

source=($url/-/archive/$version/$name-$version.tar.bz2)

prepare() {
cd $name-$version

sed "/tests_c_args =/s/$/ + ['-U', 'G_DISABLE_ASSERT']/" -i src/tests/meson.build &&
sed "/c_args:/a '-U', 'G_DISABLE_ASSERT'," -i src/tests/cogl/unit/meson.build
}

build() {
cd $name-$version

mkdir build
cd    build

meson setup .. \
      --prefix=/usr \
      --buildtype=release \
      -D profiler=false   \
      -D bash_completion=false \
      -D tests=disabled

ninja

DESTDIR=$PKG ninja install

install -Dm644 ../COPYING $PKG/usr/share/licenses/$name/COPYING
}
