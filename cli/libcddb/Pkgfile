description="Implements the different protocols (CDDBP, HTTP, SMTP) to access data on a CDDB server"
url="http://sourceforge.net/projects/libcddb/"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre B, Spiky"

name=libcddb
version=1.3.2
release=2

source=(http://downloads.sourceforge.net/sourceforge/${name}/${name}-${version}.tar.bz2)
prepare() {
  sed -e '/DEFAULT_SERVER/s/freedb.org/gnudb.gnudb.org/' \
    -e '/DEFAULT_PORT/s/888/&0/'                         \
    -i $name-$version/include/cddb/cddb_ni.h

  sed '/^Genre:/s/Trip-Hop/Electronic/' -i \
  $name-$version/tests/testdata/920ef00b.txt

  sed '/DISCID/i# Revision: 42'         -i \
  $name-$version/tests/testcache/misc/12340000

  sed -i 's/size_t l;/socklen_t l;/' \
  $name-$version/lib/cddb_net.c
}
package() {
# Obsolet lib
rm $PKG/usr/lib/libcddb.la
}
