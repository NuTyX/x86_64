description="Manage user directories like ~/Desktop and ~/Music"
url="http://www.freedesktop.org/wiki/Software/xdg-user-dirs"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"
maintainer="Jan Alexander Steffens (heftig) <jan.steffens@gmail.com>"

makedepends=(meson libxslt docbook-xsl)

name=xdg-user-dirs
version=0.19
release=1

PKGMK_LOCALES=()

source=($name
        https://gitlab.freedesktop.org/xdg/$name/-/archive/v$version/$name-v$version.tar.bz2)

prepare() {
 mv $name-v$version $name-$version
}

build=meson

package() {
  install -D $name $PKG/etc/X11/xinit/xinitrc.d/xdg-user-dirs
}
