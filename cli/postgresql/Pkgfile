description="Advanced object-relational database management system (ORDBMS)."
url="https://www.postgresql.org/docs"

license="PostgreSQL"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre,Spiky"

makedepends=(systemd readline flex bison perl python libxml2 libxslt openldap pam kerberos
             icu docbook-xml docbook-xsl)
run=(shadow)

PKGMK_GROUPS=(lib doc man devel)

name=postgresql
version=17.6

scriptsversion=20250201

source=(https://sourceforge.net/projects/nutyx/files/sources/nutyx-scripts/nutyx-scripts-$scriptsversion.tar.xz
	https://ftp.postgresql.org/pub/source/v$version/$name-$version.tar.bz2)

prepare() {
groupadd -g 41 postgres
useradd -c "PostgreSQL Server" -g postgres -d /srv/pgsql/data \
 -u 41 postgres
}

build() {
cd $name-$version
# prepare
sed -i '/DEFAULT_PGSOCKET_DIR/s@/tmp@/run/postgresql@' \
src/include/pg_config_manual.h

# configure
./configure --prefix=/usr \
--docdir=/usr/share/doc/$name \
--enable-thread-safety \
--with-system-tzdata=/usr/share/zoneinfo \
--with-systemd \
--with-pam

# build
make

# install
make DESTDIR=$PKG install
#make DESTDIR=$PKG install-docs

# service
cd $SRC/nutyx-scripts-$scriptsversion
make DESTDIR=$PKG install-sysd-postgresql

}
