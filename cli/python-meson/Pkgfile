description='Meson PEP 517 Python build backend'
url='https://github.com/mesonbuild/meson-python'

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(meson python-setuptools python-packaging pyproject-metadata)
run=(patchelf)

name=python-meson
_name="meson-python"
alias=(${_name})

version=0.19.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/mesonbuild/${_name}/archive/refs/tags/$version.tar.gz)

build() {

  cd ${_name}-$version

  pip3 wheel -w dist \
    --no-build-isolation \
    --no-deps $PWD
  pip3 install --no-index \
    --find-links dist \
    --no-cache-dir    \
    --no-user         \
    --root=$PKG       \
    ${_name}

 find $PKG -type d -name vendor -o -name tests |xargs rm -rf 
}
