description="A library making programming with POSIX capabilities easier than traditional libcap."
url="https://people.redhat.com/sgrubb/libcap-ng/"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

name=libcap-ng
version=0.9.1

makedepends=(autoreconf libtool perl)

source=(https://github.com/stevegrubb/libcap-ng/archive/refs/tags/v${version}.tar.gz)

prepare() {
cd $name-$version
# make stupid autotools happy -_-
  touch NEWS
  autoreconf -fiv
}

build() {
cd $name-$version
./configure --prefix=/usr \
--disable-static \
--without-python
make
make DESTDIR=$PKG install

# Obsolet lib
rm $PKG/usr/lib/libcap-ng.la
}
