description="libisoburn is a frontend for libraries libburn and libisofs"
url="http://libburnia-project.org/"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Tnut"

makedepends=(libburn libisofs acl attr doxygen)

name=libisoburn
version=1.5.8.2
_version=1.5.8.pl02

source=(http://files.libburnia-project.org/releases/libisoburn-${_version}.tar.gz)

prepare() {
mv $name-1.5.8 $name-$version
}

build() {

cd $name-$version

   ./configure --prefix=/usr              \
            --disable-static           \
            --enable-pkg-check-modules

   make

   make DESTDIR=$PKG install
} 
