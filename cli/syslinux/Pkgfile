description="Bootloaders that can boot from FAT, ext2/3/4 or btrfs filesystems, from CDs and via PXE"
url="https://syslinux.org"

contributors="Pierre B, Greg"
packager="tnut <tnut@nutyx.org>"

makedepends=(nasm perl util-linux)
run=(mtools)

name=syslinux
version=6.03
release=5

source=(https://downloads.sourceforge.net/nutyx/splash-11.0.png
        $name-$version-consolidate-1.patch
        http://www.kernel.org/pub/linux/utils/boot/syslinux/$name-$version.tar.xz)

prepare() {
    cd $name-$version
    patch -Np1 -i ../$name-$version-consolidate-1.patch
}

build() {
    unset MAKEFLAGS
    cd $name-$version
    cp bios/core/isolinux.bin ../isolinux.bin

    sed 's|> /dev/null 2>&1||' -i efi/check-gnu-efi.sh
    sed -i "s|win32/syslinux.exe||g" Makefile

    make bios || true
    make SBINDIR=$PKG/usr/bin BINDIR=$PKG/usr/bin     \
    INCDIR=$PKG/usr/include MANDIR=$PKG/usr/share/man \
    AUXDIR=$PKG/usr/lib/syslinux install

    install -m644 ../splash-11.0.png $PKG/usr/lib/syslinux/splash.png
    install -m644 ../isolinux.bin $PKG/usr/lib/syslinux/isolinux.bin
}
