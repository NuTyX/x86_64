description='Library requirements of the OpenCL C programming language'
url='https://libclc.llvm.org/'

license="MIT"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(cmake ninja spirv-llvm-translator)

name=libclc
version=22.1.1

source=(https://github.com/llvm/llvm-project/releases/download/llvmorg-$version/llvm-project-$version.src.tar.xz)

build() {
cd llvm-project-$version.src/libclc

   mkdir build
   cd    build


cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      -G Ninja ..

ninja

DESTDIR=$PKG ninja install

install -Dm644 ../LICENSE.TXT $PKG/usr/share/licenses/$name/LICENSE.TXT

}
