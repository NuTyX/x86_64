description="Standalone logind fork"
url="https://github.com/elogind/elogind"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

name=elogind
version=255.5
release=1

PKGMK_GROUPS=(doc devel man)
makedepends=(gperf python-jinja shadow pam dbus meson ninja eudev glib)


source=(https://github.com/${name}/${name}/archive/v${version}/$name-$version.tar.gz)

prepare() {
sed -i '/Disable polkit/,+8 d'  $name-$version/meson.build
}

build() {
cd $name-$version
mkdir build
cd    build
meson --prefix=/usr                   \
      --buildtype=release             \
      -D man=auto                     \
      -D docdir=/usr/share/doc/$name-$version \
      -D cgroup-controller=elogind    \
      -D dev-kvm-mode=0660            \
      -D dbuspolicydir=/etc/dbus-1/system.d ..
ninja

DESTDIR=$PKG ninja install

ln -sfv  libelogind.pc $PKG/usr/lib/pkgconfig/libsystemd.pc
ln -sfvn elogind $PKG/usr/include/systemd

mkdir $PKG/etc/pam.d
cat > $PKG/etc/pam.d/elogind-user << "EOF"
# Begin /etc/pam.d/elogind-user

account  required    pam_access.so
account  include     system-account

session  required    pam_env.so
session  required    pam_limits.so
session  required    pam_unix.so
session  required    pam_loginuid.so
session  optional    pam_keyinit.so force revoke
session  optional    pam_elogind.so

auth     required    pam_deny.so
password required    pam_deny.so

# End /etc/pam.d/elogind-user
EOF

}
