description="A set of C++ libraries for multimedia streaming"
url="http://www.live555.com/liveMedia/"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre,Spiky"

name=live
version=2025.05.24
release=1

source=(https://download.videolan.org/contrib/live555/$name.$version.tar.gz)

prepare() {
 cd live
 find . -name Makefile.head | xargs sed -e 's|/local||g' -i # Fix prefix
}

build() {
cd live

  ./genMakefiles linux
  sed -E 's|(-DSOCKLEN_T=socklen_t)|\1 -fPIC -DRTSPCLIENT_SYNCHRONOUS_INTERFACE=1|g' -i config.linux-with-shared-libraries
  CXXFLAGS+=' -std=c++20' \
  make

   make DESTDIR=$PKG install

}
