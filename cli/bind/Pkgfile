description="The BIND package includes the client side programs nslookup, dig and host."
url="https://www.isc.org/downloads/bind/"

license="MPL2"

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"

makedepends=(systemd libuv kerberos libxml2 openssl libcap libnghttp2 liburcu)
run=(python-ply)


name=bind
version=9.20.7

source=(https://downloads.isc.org/isc/bind9/$version/$name-$version.tar.xz)

build(){
  cd $name-$version
  ./configure --prefix=/usr           \
                --sysconfdir=/etc/bind  \
                --disable-static        \
                --mandir=/usr/share/man \
                --localstatedir=/var    \
                --with-openssl

  make
  make DESTDIR=$PKG install

install -Dm644 LICENSE $PKG/usr/share/licenses/$name/LICENSE
install -Dm644 COPYING $PKG/usr/share/licenses/$name/COPYING
install -Dm644 COPYRIGHT $PKG/usr/share/licenses/$name/COPYRIGHT

}
