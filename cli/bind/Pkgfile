description="The BIND package includes the client side programs nslookup, dig and host."
url="http://www.isc.org/downloads/bind/"

license="MPL2"

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"


makedepends=(libuv kerberos libxml2 openssl libcap libnghttp2 liburcu)
run=(python-ply)


name=bind
version=9.20.4

runyx_version=20201011

source=(https://downloads.tuxfamily.org/nutyx/files/runyx-${runyx_version}.tar.xz
	https://downloads.isc.org/isc/bind9/$version/$name-$version.tar.xz)

build(){
  cd $name-$version
  ./configure --prefix=/usr           \
                --sysconfdir=/etc/bind  \
                --disable-static        \
                --mandir=/usr/share/man \
                --localstatedir=/var    \
                --with-openssl

  make
  make DESTDIR=$PKG install

install -Dm644 LICENSE $PKG/usr/share/licenses/$name/LICENSE
install -Dm644 COPYING $PKG/usr/share/licenses/$name/COPYING
install -Dm644 COPYRIGHT $PKG/usr/share/licenses/$name/COPYRIGHT

# Service
cd $SRC/runyx-${runyx_version}
make DESTDIR=$PKG install-sysv-bind
make DESTDIR=$PKG install-runyx-bind
}
service() {
bsdtar -cf \
$PKGMK_PACKAGE_DIR/$name.service${PKGMK_PACKAGE_EXT}$version-$release \
lib/init etc/{init,rc.d}

rm -r etc/{rc.d,init}
rm -r lib/init
}
