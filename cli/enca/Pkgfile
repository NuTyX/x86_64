description="Charset analyser and converter."
url="https://cihar.com/software/enca/"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Fanch,Tnut"

name=enca
version=1.21

source=(https://github.com/Project-OSS-Revival/enca/archive/refs/tags/$version.tar.gz)

PKGMK_KEEP_SOURCES="no"

build() {
cd $name-$version
./configure --prefix=/usr \
              --libexecdir=/usr/lib \
              --mandir=/usr/share/man \
              --with-librecode=/usr \
              --enable-external      
make
make DESTDIR=$PKG install

rm $PKG/usr/lib/libenca.la
}
