description="portmap replacement which supports RPC over various protocols"
url="https://rpcbind.sourceforge.net/"

license="BSD-3 Clause"

contributors="Alienus,Tnut"
packager="spiky <spiky@nutyx.org>"

makedepends=(libtirpc)

PKGMK_GROUPS=(man)

name=rpcbind
version=1.2.8

scriptsversion=20250201
source=(https://sourceforge.net/projects/nutyx/files/sources/nutyx-scripts/nutyx-scripts-$scriptsversion.tar.xz
	https://downloads.sourceforge.net/rpcbind/rpcbind-$version.tar.bz2)

build() {
    cd rpcbind-$version
    sed -i "/servname/s:rpcbind:sunrpc:" src/rpcbind.c

    ./configure --prefix=/usr       \
                --bindir=/sbin      \
		--sbindir=/sbin     \
                --with-rpcuser=root \
		--enable-warmstarts \
		--without-systemdsystemunitdir
    make
    make DESTDIR=$PKG install

    # service
    cd ../nutyx-scripts-$scriptsversion
    make DESTDIR=$PKG install-sysd-rpcbind
 
}

service() {
cd $PKG
bsdtar -r -f \
$PKGMK_PACKAGE_DIR/${name}.${group}${PKGMK_PACKAGE_EXT}$version-$release \
usr/lib/systemd
rm -r usr/lib/systemd
}
