description="portmap replacement which supports RPC over various protocols"
url="https://rpcbind.sourceforge.net/"

license="BSD-3 Clause"

contributors="Alienus,Spiky"
packager="tnut <tnut@nutyx.org>"

makedepends=(libtirpc systemd)

PKGMK_GROUPS=(man)

name=rpcbind
version=1.2.8
release=2

scriptsversion=20250201
source=(https://sourceforge.net/projects/nutyx/files/sources/nutyx-scripts/nutyx-scripts-$scriptsversion.tar.xz
	https://downloads.sourceforge.net/rpcbind/rpcbind-$version.tar.bz2)

prepare() {
groupadd -g 28 rpc &&
useradd -c "RPC Bind Daemon Owner" -d /dev/null -g rpc \
        -s /bin/false -u 28 rpc
}
build() {
    cd rpcbind-$version
    sed -i "/servname/s:rpcbind:sunrpc:" src/rpcbind.c

    ./configure --prefix=/usr       \
                --with-rpcuser=root \
                --bindir=/usr/sbin  \
                --enable-warmstarts
    make
    make DESTDIR=$PKG install
}
