description="Boost provides a set of free peer-reviewed portable C++ source libraries."
url="http://boost.sourceforge.net/"

packager="spiky <spiky@nutyx.org>"
contributors="Rems,Tnut"

makedepends=(icu python)

name=boost
version=1.89.0

source=(https://archives.boost.io/release/1.87.0/source/${name}_1_87_0.tar.gz
        https://archives.boost.io/release/$version/source/${name}_${version//./_}.tar.gz)

prepare() {
 sed -i '/#include.*phoenix.*tuple.hpp.*/d' \
 ${name}_${version//./_}/boost/phoenix/stl.hpp

 sed -i '/#include.*phoenix.*tuple.hpp.*/d' \
 ${name}_1_87_0/boost/phoenix/stl.hpp


}

build() {

cd ${name}_1_87_0
./bootstrap.sh --prefix=$PKG/usr/local --with-toolset=gcc --with-python=python3

./b2 stage -j8 variant=release threading=multi \
	link=shared,static debug-symbols=off -j ${JOBS-1}

./b2 install threading=multi link=shared


cd ../${name}_${version//./_}

./bootstrap.sh --prefix=$PKG/usr --with-toolset=gcc --with-python=python3

./b2 stage -j8 variant=release threading=multi \
	link=shared,static debug-symbols=off -j ${JOBS-1}

./b2 install threading=multi link=shared
ln -svf detail/sha1.hpp $PKG/usr/include/boost/uuid/sha1.hpp
}
package() {
cd $SRC
for lib in date_time filesystem atomic locale chrono thread program_options \
regex system
do
  cp -v $PKG/usr/local/lib/libboost_$lib.so.1.87.0 \
  $PKG/usr/lib/
done
rm -r $PKG/usr/local
}
