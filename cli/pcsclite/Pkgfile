description="PC/SC Architecture smartcard middleware library"
url="https://alioth.debian.org/projects/pcsclite/"

license="BSD"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Tnut"

makedepends=(python glib eudev pkgconf flex polkit)

name=pcsclite
version=2.3.0

PKGMK_KEEP_SOURCES="No"
source=(https://pcsclite.apdu.fr/files/pcsc-lite-$version.tar.xz
	pcscd)

build() {
  cd pcsc-lite-$version
  mkdir build
  cd    build

  meson setup .. \
        --prefix=/usr \
        --buildtype=plain  \
        -D polkit=true     \
        -D usb=true        \
        -D usbdropdir=/usr/lib/pcsc/drivers \
        -D ipcdir=/run/pcscd

  ninja
  DESTDIR=$PKG ninja install

  install -d $PKG/usr/lib/pcsc/drivers

  install -D -m0644 ../COPYING \
  $PKG/usr/share/licenses/$name/COPYING

  # Service
  mkdir -p $PKG/etc/rc.d/init.d
  install -m755 $SRC/pcscd $PKG/etc/rc.d/init.d/pcscd
  for i in 0 1 2 3 4 5 6
  do
   mkdir -p $PKG/etc/rc.d/rc${i}.d
  done
  for i in 3 4 5
  do
   ln -sf ../init.d/pcscd $PKG/etc/rc.d/rc${i}.d/S90pcscd
  done
  for i in 0 1 2 6
  do
   ln -sf ../init.d/pcscd$PKG/etc/rc.d/rc${i}.d/K01pcscd
  done
}
