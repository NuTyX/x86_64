description="The International Components for Unicode (ICU) package is \
a mature, widely used set of C/C++ libraries"
url="http://www.icu-project.org/"

license="UNICODE LICENSE V3"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Remy,Tnut"

makedepends=(llvm doxygen)

name=icu
version=78.2
release=2

PKGMK_GROUPS=(lib devel man)
PKGMK_IGNORE_UNPACK="yes"

source=(https://github.com/unicode-org/icu/releases/download/\
release-${version}/icu4c-${version}-sources.tgz
        https://github.com/unicode-org/icu/releases/download/\
release-77-1/icu4c-77_1-src.tgz LICENSE)
prepare () {
bsdtar xf icu4c-$version-sources.tgz
mv $name $name-$version
bsdtar xf icu4c-77_1-src.tgz
mv $name $name-77.1
}

build () {
cd $name-$version/source

./configure --prefix=/usr \
--sbindir=/usr/bin

make
make prefix=$PKG/usr install

cd ../..

cd $name-77.1/source

./configure --prefix=/usr/local

make
make prefix=$PKG/usr/local install



install -Dm644 ../LICENSE $PKG/usr/share/licenses/$name/LICENSE
}
package() {
cd $SRC
for lib in $PKG/usr/local/lib/*.so.77
do
    cp -v $lib.1 \
    $PKG/usr/lib/
    ln -sv $(basename $lib).1 $PKG/usr/lib/$(basename $lib)
done
rm -r $PKG/usr/local
}
lib() {
cd $PKG
bsdtar -cf \
$PKGMK_PACKAGE_DIR/$name.lib${PKGMK_PACKAGE_EXT}$version-$release \
usr/lib/libicu*

rm usr/lib/libicu*
rm -d usr/lib || true
}

devel() {
cd $PKG
bsdtar -cf \
$PKGMK_PACKAGE_DIR/$name.devel${PKGMK_PACKAGE_EXT}$version-$release \
usr/lib/icu usr/lib/pkgconfig usr/share/icu usr/include

rm -r usr/{lib/{icu,pkgconfig},share/icu,include}
rm -d usr/{lib,share} || true
}
