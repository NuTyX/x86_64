description="Fully feature complete YAML parser and emitter'"
url="https://pantoniou.github.io/libfyaml/"

license="MIT"

packager="tnut <tnut@nutyx.org>"
contributors=""

makedepends=(grep autoconf libtool)

name=libfyaml
version=0.9
release=1

source=(https://github.com/pantoniou/$name/archive/refs/tags/v$version.tar.gz)

PKGMK_KEEP_SOURCES="no"

prepare() {
 cd $name-$version
 autoreconf -fiv
}
build() {
 cd $name-$version

 ./configure --prefix=/usr
 make DESTDIR=$PKG install

 install -Dm644 LICENSE -t $PKG/usr/share/licenses/$name
} 
