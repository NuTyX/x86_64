INFO="\033[1;36m"
NORMAL="\033[0;39m"
FILE="no-ip2.conf"
if [ ! -f etc/$FILE ]; then
  usr/bin/noip2 -C -c tmp/$FILE
  if [ -f tmp/$FILE ];then
    mv tmp/$FILE /etc &&
    printf "${INFO} /etc/$FILE file created${NORNAL}\n"
  else
    printf "${INFO} No file /etc/$FILE created${NORNAL}\n"
    printf "${INFO} You should run: /usr/bin/noip2 -C -c /etc/$FILE again !!!${NORMAL}\n"
  fi
fi
