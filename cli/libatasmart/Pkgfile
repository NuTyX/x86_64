description="A disk reporting library. It only supports a subset of the ATA S.M.A.R.T. functionality."
url="http://0pointer.de/blog/projects/being-smart.html"

maintainer="Lennart"
packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Tnut"

name=libatasmart
version=0.19
release=8

makedepends=(systemd)

source=(https://0pointer.de/public/$name-$version.tar.xz)

build() {
cd $name-$version
./configure --prefix=/usr \
--sbindir=/usr/bin \
--disable-static

make

make DESTDIR=$PKG docdir=/usr/share/doc/libatasmart-$version install

# Obsolet libs

rm $PKG/usr/lib/libatasmart.la
}
