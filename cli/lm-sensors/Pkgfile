description="Collection of user space tools for general SMBus access and hardware monitoring"
url="https://dl.lm-sensors.org/lm-sensors/"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Tnut"

makedepends=(bison flex)
run=(perl)

name=lm-sensors
version=3.6.2
release=3

_version=${version//./-}

source=(https://github.com/hramrach/lm-sensors/archive/V${_version}/$name-${_version}.tar.gz)

build() {
	cd $name-${_version}
	make PREFIX=/usr DESTDIR=$PKG \
        SBINDIR=/usr/bin   \
	BUILD_STATIC_LIB=0 \
	MANDIR=/usr/share/man
	make PREFIX=/usr DESTDIR=$PKG \
        SBINDIR=/usr/bin   \
	BUILD_STATIC_LIB=0 \
	MANDIR=/usr/share/man install

	install -v -m755 -d $PKG/usr/share/doc/$name
	cp -rv README INSTALL doc/* \
	$PKG/usr/share/doc/$name
}
