description="GNU Compact Disc Input and Control Library"
url="http://www.gnu.org/software/libcdio/"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre B"

makedepends=(perl ncurses texinfo help2man)

name=libcdio
version=2.1.0
release=2

source=(version.texi
        https://sourceforge.net/projects/nutyx/files/sources/$name/$name-$version.tar.xz)

prepare() {
 cp version.texi $name-$version/doc
}
build() {
cd $name-$version

./configure --prefix=/usr  \
         --disable-static  \
        --disable-vcd-info \
        --enable-cpp-progs \
        --disable-cddb     \
        --enable-maintainer-mode
make
make DESTDIR=$PKG install

# Obsolets libs
rm $PKG/usr/lib/libcdio{,++}.la
rm $PKG/usr/lib/libiso9660{,++}.la
rm $PKG/usr/lib/libudf.la

sed -e "/define CDIO_LIBCDIO_SOURCE_PATH/s|.*|/* #undef CDIO_LIBCDIO_SOURCE_PATH */|" \
      -i $PKG/usr/include/cdio/cdio_config.h

}
