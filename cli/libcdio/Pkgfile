description="GNU Compact Disc Input and Control Library"
url="http://www.gnu.org/software/libcdio/"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Tnut"

makedepends=(libtool perl ncurses texinfo help2man)

name=libcdio
version=2.2.0

source=(version.texi
        https://github.com/$name/$name/releases/download/$version/$name-$version.tar.bz2)

prepare() {
 cp version.texi $name-$version/doc
}
build() {
cd $name-$version

autoreconf -fvi
./configure --prefix=/usr  \
         --disable-static  \
        --disable-vcd-info \
        --enable-cpp-progs \
        --disable-cddb     \
        --enable-maintainer-mode

sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
make
make DESTDIR=$PKG install

# Obsolets libs
rm $PKG/usr/lib/libcdio{,++}.la
rm $PKG/usr/lib/libiso9660{,++}.la
rm $PKG/usr/lib/libudf.la

sed -e "/define CDIO_LIBCDIO_SOURCE_PATH/s|.*|/* #undef CDIO_LIBCDIO_SOURCE_PATH */|" \
      -i $PKG/usr/include/cdio/cdio_config.h

}
