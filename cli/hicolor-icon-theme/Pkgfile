description="Freedesktop.org Hicolor icon theme"
url="http://icon-theme.freedesktop.org/wiki/HicolorTheme"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre,Spiky"

makedepends=(python meson ninja)

name=hicolor-icon-theme
version=0.18

source=(  http://icon-theme.freedesktop.org/releases/$name-$version.tar.xz)

build() {

    meson setup --prefix /usr \
    --buildtype  plain        \
    $name-$version            builddir

    meson compile -C          builddir

DESTDIR=$PKG meson install -C builddir
}
