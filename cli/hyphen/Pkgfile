description="High quality hyphenation and justification library based on the TeX hyphenation algorithm."
url="http://hunspell.sourceforge.net/"
packager="spiky <spiky@nutyx.org>"
contributors="Fanch,Tnut"

name=hyphen
version=2.8.9

makedepends=(perl)
source=(https://github.com/hunspell/hyphen/releases/download/v$version/hyphen-$version.tar.gz)

build() {
	cd $name-$version
        ./configure --prefix=/usr \
		    --disable-static 
        make
        make DESTDIR=$PKG install

        rm $PKG/usr/lib/libhyphen.la
}
