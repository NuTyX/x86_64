description='HTTP/2 State-Machine based protocol implementation'
url='https://pypi.org/project/h2/'

packager="spiky <spiky@nutyx.org>"
contributors=""

makedepends=(python-setuptools python-hyperframe python-hpack)

name=python-h2
_name="h2"
alias=(${_name})

version=4.2.0

source=(https://files.pythonhosted.org/packages/1b/38/d7f80fd13e6582fb8e0df8c9a653dcc02b03ca34f4d72f34869298c5baf8/h2-4.2.0.tar.gz)

build() {

      cd ${_name}-$version

  pip3 wheel -w dist \
    --no-build-isolation \
    --no-deps $PWD
  pip3 install --no-index \
    --find-links dist \
    --no-cache-dir    \
    --no-user         \
    --root=$PKG       \
    ${_name}

 find $PKG -type d -name vendor -o -name tests |xargs rm -rf 
}
