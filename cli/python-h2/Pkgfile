description='HTTP/2 State-Machine based protocol implementation'
url='https://hyper.rtfd.org'

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(git python-wheel python-installer python-setuptools
             python-hyperframe python-hpack)

name=python-h2
_name="h2"
alias=(${_name})

version=4.4.0
release=2
tag=v$version

source=(https://github.com/python-hyper/h2.git)

build() {

  cd $name-$version

  python -m build --wheel --no-isolation
  python -m installer --destdir=$PKG dist/*.whl

  install -Dm644 LICENSE -t $PKG/usr/share/licenses/$name
}
