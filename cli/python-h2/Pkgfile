description='HTTP/2 State-Machine based protocol implementation'
url='https://pypi.org/project/h2/'

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(python-wheel python-installer python-setuptools python-hyperframe python-hpack)

name=python-h2
_name="h2"
alias=(${_name})

version=4.3.0

source=(https://files.pythonhosted.org/packages/1d/17/afa56379f94ad0fe8defd37d6eb3f89a25404ffc71d4d848893d270325fc/h2-$version.tar.gz)

build() {

  cd ${_name}-$version

  python -m build --wheel --no-isolation
  python -m installer --destdir=$PKG dist/*.whl

  install -Dm644 LICENSE -t $PKG/usr/share/licenses/$name
}
