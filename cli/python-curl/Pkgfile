description="PycURL is a Python interface to libcurl"
url="http://pycurl.io/"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(python-setuptools python-wheel curl)

name=python-curl
_name="pycurl"
alias=(${_name})

version=7.45.7
release=1

_name=pycurl
source=(
https://files.pythonhosted.org/packages/e3/3d/01255f1cde24401f54bb3727d0e5d3396b67fc04964f287d5d473155f176/pycurl-$version.tar.gz)

build() {
  cd ${_name}-$version

  pip3 wheel -w dist \
    --no-build-isolation \
    --no-deps $PWD
  pip3 install --no-index \
    --find-links dist \
    --no-cache-dir    \
    --no-user         \
    --root=$PKG       \
    ${_name}

 find $PKG -type d -name vendor -o -name tests |xargs rm -rf 
}
