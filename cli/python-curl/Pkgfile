description="PycURL is a Python interface to libcurl"
url="http://pycurl.io/"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(python-setuptools python-wheel curl)

name=python-curl
_name="pycurl"
alias=(${_name})

version=7.46.0
release=2

_name=pycurl
source=(
https://files.pythonhosted.org/packages/95/23/cc07b16591af8ca373494d29aafc8df13e547077579e6779bb865a3f5a7f/pycurl-$version.tar.gz)

build() {
  cd ${_name}-$version

  pip3 wheel -w dist \
    --no-build-isolation \
    --no-deps $PWD
  pip3 install --no-index \
    --find-links dist \
    --no-cache-dir    \
    --no-user         \
    --root=$PKG       \
    ${_name}

 find $PKG -type d -name vendor -o -name tests |xargs rm -rf 
}
