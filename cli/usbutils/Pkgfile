description="USB Device Utilities"
url="http://downloads.sourceforge.net/linux-usb/"

license="GPL2 GPL3"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Tnut"

makedepends=(systemd python meson ninja libusb-compat)
run=(hwdata)

name=usbutils
version=019

source=(http://www.kernel.org/pub/linux/utils/usb/usbutils/usbutils-$version.tar.xz)

build() {

 meson setup --prefix /usr \
 --buildtype  plain        \
 $name-$version                builddir

 meson compile -C              builddir

mkdir -p $PKG/usr/share/hwdata

 DESTDIR=$PKG meson install -C builddir

install -Dm644 $SRC/$name-$version/LICENSES/GPL-2.0-only.txt $PKG/usr/share/licenses/$name/GPL-2.0-only.txt
install -Dm644 $SRC/$name-$version/LICENSES/GPL-3.0-only.txt $PKG/usr/share/licenses/$name/GPL-3.0-only.txt
}
