description='Swiss Army knife of Python web development'
url='https://pypi.org/project/Werkzeug/'

packager="spiky <spiky@nutyx.org>"
contributors=""

makedepends=(python-setuptools python-wheel python-flit-core python-markupsafe)

name=python-werkzeug
_name="werkzeug"
alias=(${_name})

version=3.1.3
release=3

source=(https://github.com/pallets/werkzeug/archive/$version/$name-$version.tar.gz)

build() {

      cd ${_name}-$version

  pip3 wheel -w dist \
    --no-build-isolation \
    --no-deps $PWD
  pip3 install --no-index \
    --find-links dist \
    --no-cache-dir    \
    --no-user         \
    --root=$PKG       \
    ${_name}

 find $PKG -type d -name vendor -o -name tests |xargs rm -rf 
}
