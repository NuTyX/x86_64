description="An object-oriented language for quick and easy programming"
url="http://ruby-lang.org"

license="BSD custom"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre,Minzord,Spiky"

makedepends=(doxygen openssl yaml libxcrypt)

name=ruby
version=4.0.5
release=1

source=(ruby-4.0.5-openssl4_fixes-1.patch
        https://cache.ruby-lang.org/pub/ruby/${version:0:3}/ruby-$version.tar.xz)

prepare() {
cd $name-$version
patch -Np1 -i ../ruby-4.0.5-openssl4_fixes-1.patch
}
build() {
cd ruby-$version
./configure --prefix=/usr --enable-shared \
--docdir=/usr/share/doc/$name
make
make capi
make DESTDIR=$PKG install

install -D -m644 COPYING  $PKG/usr/share/licenses/ruby/LICENSE
install -D -m644 BSDL $PKG/usr/share/licenses/ruby/BSDL 
}
