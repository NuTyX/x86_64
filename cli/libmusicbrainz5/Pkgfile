description="Library That Provides Access to the MusicBrainz Server"
url="https://musicbrainz.org/doc/libmusicbrainz"

license="LGPL-2.1-only"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Tnut"

makedepends=(libxml2 cmake expat neon doxygen)

name=libmusicbrainz5
version=5.1.0
release=5

source=(libmusicbrainz5-5.patch libmusicbrainz5-16.patch libmusicbrainz5-19.patch
        https://github.com/metabrainz/libmusicbrainz/releases/download/release-$version/libmusicbrainz-$version.tar.gz)

prepare() {
cd libmusicbrainz-$version
patch -Np1 -i ../libmusicbrainz5-5.patch
patch -Np1 -i ../libmusicbrainz5-16.patch
patch -Np1 -i ../libmusicbrainz5-19.patch
}
build() {
cmake -S libmusicbrainz-$version -B build -G Ninja \
-DCMAKE_INSTALL_PREFIX:PATH=/usr \
-DCMAKE_BUILD_TYPE=None \
-DCMAKE_POLICY_VERSION_MINIMUM=3.5

cmake --build build
cmake --build build --target docs

DESTDIR=$PKG cmake --install build

mkdir -p $PKG/usr/share/doc/$name-$version
cp -r build/docs/ $PKG/usr/share/doc/$name-$version
}
