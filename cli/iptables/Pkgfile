description="The principal firewall tool for Linux."
url="https://www.iptables.org/"

license="GPL2"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre,Spiky"

name=iptables
version=1.8.11
release=5

makedepends=(libmnl libnftnl)

scriptsversion=20260315

PKGMK_GROUPS=(man devel)
source=(https://sourceforge.net/projects/nutyx/files/sources/nutyx-scripts/nutyx-scripts-$scriptsversion.tar.xz
	     https://www.netfilter.org/projects/iptables/files/$name-$version.tar.xz)

build() {

cd $name-$version

./configure --prefix=/usr \
--sbindir=/usr/bin        \
--enable-libipq

make
make DESTDIR=$PKG install

# service
cd ../nutyx-scripts-$scriptsversion
make DESTDIR=$PKG install-sysd-$name


# Obsolet libs
rm $PKG/usr/lib/libip{{6,4}tc,q}.la
rm $PKG/usr/lib/libxtables.la
}

package() {
for f in {arp,eb,ip,ip6}tables{,-restore,-save} iptables-xml; do
  ln -sf xtables-nft-multi $PKG/usr/bin/$f
done
}
service() {
cd $PKG
bsdtar -r -f \
$PKGMK_PACKAGE_DIR/${name}.${group}${PKGMK_PACKAGE_EXT}$version-$release \
usr/lib/systemd
rm -r usr/lib/systemd
}
