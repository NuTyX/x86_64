description="Library to create an ISO-9660 filesystem with extensions like RockRidge or Joliet"
url="http://libburnia.pykix.org/"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Tnut"

makedepends=(acl)

name=libisofs
version=1.5.8.2
_version=1.5.8.pl02

source=(http://files.libburnia-project.org/releases/$name-${_version}.tar.gz)

prepare() {
mv $name-1.5.8 $name-$version
}

build() {
cd $name-$version
./configure --prefix=/usr --disable-static \
            --enable-libacl --enable-xattr
            
make
make DESTDIR=$PKG install
rm $PKG/usr/lib/$name.la
}
