description="An high dynamic-range image file format library"
url="https://www.openexr.org"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Rems,Tnut"

makedepends=(cmake boost imath)

name=openexr
version=3.4.15

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/openexr/openexr/archive/v$version.tar.gz)

build() {
mkdir build
cd    build

cmake -DCMAKE_INSTALL_PREFIX=/usr \
../$name-$version

make
make DESTDIR=$PKG install
}
