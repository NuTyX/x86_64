description="Application development toolkit for controlling system-wide privileges"
url="http://hal.freedesktop.org/docs/polkit"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Tnut"

name=polkit
version=125
release=3

makedepends=(pam gettext glib duktape gobject-introspection elogind
             patch autoconf intltool perl-xml-parser libxslt docbook-xsl)
source=(polkit-1
        https://github.com/$name-org/$name/archive/$version/$name-$version.tar.gz)

prepare() {
SN="polkitd"
IDN="27"
if ! (getent group $SN > /dev/null); then
   groupadd -g $IDN $SN
fi
if ! (getent passwd $SN > /dev/null); then
   useradd -c "PolicyKit Daemon Owner" -d /etc/polkit-1 \
   -u $IDN -g $SN -s /bin/false $SN
fi
}
build() {
cd $name-$version

mkdir build
cd    build

meson setup ..                     \
      --prefix=/usr                \
      --buildtype=plain            \
      -D man=false                 \
      -D session_tracking=elogind  \
      -D systemdsystemunitdir=/tmp \
      -D tests=true                \
      -D js_engine=duktape
ninja

DESTDIR=$PKG ninja install

rm -r $PKG/tmp
rm -rf $PKG/usr/lib/{sysusers,tmpfiles}.d

install -D -m644 ../../polkit-1 $PKG/etc/pam.d/polkit-1
}
