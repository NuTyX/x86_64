description="Utilities for use with the Reiser file system."
url="https://www.kernel.org/pub/linux/utils/fs/reiserfs/"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(libtool e2fsprogs)

name=reiserfsprogs
version=3.6.27
release=5

source=(https://www.kernel.org/pub/linux/kernel/people/jeffm/reiserfsprogs/v${version}/$name-$version.tar.xz
        reiserfsprogs-3.6.27-loff_t.patch)


build() {
        cd $name-$version
	patch -p1 -i ../reiserfsprogs-3.6.27-loff_t.patch
	autoreconf -fiv

        CFLAGS+=' -fgnu89-inline'

        ./configure --prefix=/usr \
                --sbindir=/usr/bin

        make
        make DESTDIR=$PKG install

        ln -sf reiserfsck $PKG/usr/bin/fsck.reiserfs
        ln -sf mkreiserfs $PKG/usr/bin/mkfs.reiserfs

	rm $PKG/usr/lib/libreiserfscore.la
}
