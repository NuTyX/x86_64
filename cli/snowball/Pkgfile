description='String processing language for creating stemming algorithms'
url='https://snowballstem.org/'

license="BSD"

packager="spiky <spiky@nutyx.org>"
contributors="Tnut"

name=snowball
version=3.1.1

makedepends=(perl)

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/snowballstem/snowball/archive/refs/tags/v${version}.tar.gz
        Make-libstemmer-a-shared-library.patch)

prepare() {

cd $name-$version
  patch -Np1 -i ../Make-libstemmer-a-shared-library.patch
}

build() {
 cd $name-$version
 make
 install -d $PKG/usr/{bin,lib}
  install -t $PKG/usr/bin snowball stemwords
  install -Dt $PKG/usr/share/licenses/$name -m644 COPYING
  install -Dm644 {.,$PKG/usr}/include/libstemmer.h

  install -Dm644 libstemmer.so.0 $PKG/usr/lib/libstemmer.so.0.0.0
  ln -s libstemmer.so.0.0.0 $PKG/usr/lib/libstemmer.so.0
  ln -s libstemmer.so.0 $PKG/usr/lib/libstemmer.so
}
