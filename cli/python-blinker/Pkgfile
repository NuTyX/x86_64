description='Fast, simple object-to-object and broadcast signaling'
url='https://pypi.org/project/blinker/'

packager="spiky <spiky@nutyx.org>"
contributors=""

makedepends=(python-setuptools python-flit-core)

name=python-blinker
_name="blinker"
alias=(${_name})

version=1.9.0
release=4

source=(https://files.pythonhosted.org/packages/source/b/blinker/blinker-$version.tar.gz)

build() {

  cd ${_name}-$version

  pip3 wheel -w dist \
    --no-build-isolation \
    --no-deps $PWD
  pip3 install --no-index \
    --find-links dist \
    --no-cache-dir    \
    --no-user         \
    --root=$PKG       \
    ${_name}

 find $PKG -type d -name vendor -o -name tests |xargs rm -rf 
}
