description="General Purpose Mouse: mouse server for the console and xterm."
url="https://unix.schottelius.org/gpm"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre,Spiky"

makedepends=(autoconf automake m4 libtool sed grep bison)
name=gpm
version=1.20.7
release=11

scriptsversion=20241218

source=(https://sourceforge.net/projects/nutyx/files/sources/nutyx-scripts/nutyx-scripts-${scriptsversion}.tar.xz
        gpm-1.20.7-consolidated-1.patch
        https://www.nico.schottelius.org/software/$name/archives/$name-$version.tar.bz2)

build() {
	cd $name-$version

	patch -Np1 -i ../gpm-1.20.7-consolidated-1.patch

	./autogen.sh
	./configure --prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make
	make ROOT=$PKG install
	ln -sv libgpm.so.2.1.0 $PKG/usr/lib/libgpm.so.1
	ln -sv libgpm.so.2.1.0 $PKG/usr/lib/libgpm.so
	install -v -m644 conf/gpm-root.conf $PKG/etc

	cd ../nutyx-scripts-${scriptsversion}
	make DESTDIR=$PKG install-sysv-gpm
}
