. lib/lsb/init-functions

if [ ! -L etc/systemd/system/multi-user.target.wants/gpm.service ];then
  mkdir -p etc/systemd/system/multi-user.target.wants
  ln -sf /usr/lib/systemd/system/gpm.service etc/systemd/system/multi-user.target.wants/gpm.service && \
  log_success_msg2  \
  "${INFO} Created symlink /etc/systemd/system/multi-user.target.wants/gpm.service -> /usr/lib/systemd/system/gpm.service${NORMAL}"
fi
