description="Utilities for configuring the Linux Ethernet bridge"
url="http://sourceforge.net/projects/bridge/"

contributors="Pierre B, tnut"
packager="spiky <spiky@nutyx.org>"

makedepends=(autoconf)
 
name=bridge-utils
version=1.7.1
release=3

runyx_version=20201011

source=(https://mirrors.edge.kernel.org/pub/linux/utils/net/$name/$name-$version.tar.xz)

build() {
cd $name-$version

autoconf

./configure --prefix=/usr \
            --sbindir=/usr/bin

make

make DESTDIR=$PKG install

}
