description="Small and modern C++ library for Filezilla" 
url="https://lib.filezilla-project.org/"

license="GPL2"

packager="tnut <tnut@nutyx.org>"
contributors="Greg,Rémy,Spiky"

makedepends=(libidn2 gettext nettle gnutls libxcrypt)

name=libfilezilla
version=0.51.1

source=(https://sources.archlinux.org/other/libfilezilla/$name-$version.tar.xz)

build() {

cd $name-$version
./configure --prefix=/usr \
--disable-static
make
make DESTDIR=$PKG install
# Obsolets libs
rm $PKG/usr/lib/libfilezilla.la

install -Dm644 COPYING $PKG/usr/share/licenses/$name/COPYING
}
