description='Micro webdevelopment framework for Python'
url='https://pypi.org/project/Flask/'

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(python-setuptools python-wheel python-flit-core python-click python-blinker
             python-werkzeug python-jinja python-itsdangerous)

name=python-flask
_name="flask"
alias=(${_name})

version=3.1.3

source=(https://github.com/pallets/flask/archive/$version/$name-$version.tar.gz)

build() {

  cd ${_name}-$version

  pip3 wheel -w dist \
    --no-build-isolation \
    --no-deps $PWD
  pip3 install --no-index \
    --find-links dist \
    --no-cache-dir    \
    --no-user         \
    --root=$PKG       \
    ${_name}

 find $PKG -type d -name vendor -o -name tests |xargs rm -rf 
}
