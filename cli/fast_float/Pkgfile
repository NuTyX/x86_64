description='Fast and exact implementation of the C++ from_chars functions for float and double types'
url='https://github.com/fastfloat/fast_float'

license="Apache, Boost, MIT"

packager="spiky <spiky@nutyx.org>"
contributors=""

makedepends=(cmake git)

name=fast_float
version=8.0.2

source=(https://github.com/fastfloat/fast_float/archive/v${version}/$name-$version.tar.gz)

build() {
cd $name-$version

mkdir build
cd    build

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      -G Ninja ..

ninja
DESTDIR=$PKG ninja install

install -Dm644 ../LICENSE-APACHE $PKG/usr/share/licenses/$name/LICENSE-APACHE
install -Dm644 ../LICENSE-BOOST $PKG/usr/share/licenses/$name/LICENSE-BOOST
install -Dm644 ../LICENSE-MIT $PKG/usr/share/licenses/$name/LICENSE-MIT
}
