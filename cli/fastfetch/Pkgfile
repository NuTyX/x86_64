description="Fastfetch is a maintained, feature-rich and performance oriented system information tool."
name=fastfetch

license="MIT"

version=2.61.0
release=4

packager="tnut <tnut@nutyx.org>"
contributors="Spiky,Alexis"

url="https://github.com/fastfetch-cli/fastfetch/"
source=(https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/$version.tar.gz
        fastfetch.patch)

makedepends=(cmake)

prepare() {
cd $name-$version
patch -Np1 -i ../fastfetch.patch
}

build() { 
cd $name-$version

mkdir build
cd build

cmake -D CMAKE_INSTALL_PREFIX=/usr    \
      -D CMAKE_BUILD_TYPE=Release     \
      -D BUILD_FLASHFETCH=OFF         \
      -D PACKAGES_DISABLE_CHOCO=ON    \
      -D PACKAGES_DISABLE_MACPORTS=ON \
      -D PACKAGES_DISABLE_SCOOP=ON    \
      -D PACKAGES_DISABLE_WINGET=ON   \
      .. 
make 
make DESTDIR=$PKG install

}
