description="Connect your computer to a network which uses DHCP to assign network addresses."
url="http://roy.marples.name/projects/dhcpcd"

license="BSD-2-Clause"

maintainer="Roy Marples"
packager="spiky <spiky@nutyx.org>"

name=dhcpcd
version=10.1.0
release=2

makedepends=(shadow)

scriptsversion=20250125
source=(https://sourceforge.net/projects/nutyx/files/sources/nutyx-scripts/nutyx-scripts-$scriptsversion.tar.xz
	    https://github.com/NetworkConfiguration/dhcpcd/releases/download/v${version}/$name-$version.tar.xz)

prepare() {
groupadd -g 52 $name
useradd -c 'dhcpcd PrivSep' -d /var/lib/$name \
-g $name -s /bin/false -u 52 $name
}
build() {
install -v m700 -d $PKG/var/lib/$name
cd $name-$version
./configure \
--libexecdir=/lib/$name \
--dbdir=/var/lib/$name \
--privsepuser=dhcpcd
make
make DESTDIR=$PKG install

#
## service
cd ../nutyx-scripts-$scriptsversion
make DESTDIR=$PKG install-sysd-dhcpcd
sed -i "s@^Before@# Before@" $PKG/usr/lib/systemd/system/dhcpcd@.service

install -Dm644 $SRC/$name-$version/LICENSE $PKG/usr/share/licenses/$name/LICENSE
}
