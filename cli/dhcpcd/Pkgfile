description="Connect your computer to a network which uses DHCP to assign network addresses."
url="https://roy.marples.name/projects/dhcpcd"

license="BSD-2-Clause"

maintainer="Roy Marples"
packager="spiky <spiky@nutyx.org>"

name=dhcpcd
version=10.1.0
release=3

makedepends=(shadow)

scripts_version=20250201
source=(https://sourceforge.net/projects/nutyx/files/sources/nutyx-scripts/nutyx-scripts-${scripts_version}.tar.xz
        https://github.com/NetworkConfiguration/dhcpcd/releases/download/v${version}/$name-$version.tar.xz)

prepare() {
groupadd -g 52 $name
useradd -c 'dhcpcd PrivSep' -d /var/lib/$name \
-g $name -s /bin/false -u 52 $name
}
build() {
install -v m700 -d $PKG/var/lib/$name
cd $name-$version
./configure --prefix=/usr   \
--libexecdir=/usr/lib/$name \
--dbdir=/var/lib/$name      \
--runstatedir=/run          \
--privsepuser=dhcpcd
make
make DESTDIR=$PKG install
mkdir $PKG/sbin
ln -sv ../usr/sbin/dhcpcd $PKG/sbin/dhcpcd
#
## service
cd ../nutyx-scripts-${scripts_version}
make DESTDIR=$PKG -C services/sysv install-service-dhcpcd

install -Dm644 $SRC/$name-$version/LICENSE $PKG/usr/share/licenses/$name/LICENSE
}
