description="Xapian is an open source search engine library."
url="https://www.xapian.org/"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

license="GPL-2.0-or-later"

name=xapian
version=1.4.29
release=2

source=(https://oligarchy.co.uk/xapian/$version/xapian-core-$version.tar.xz)

build() {
cd $name-core-$version
./configure --prefix=/usr \
--disable-static \
--docdir=/usr/share/doc/xapian-core
make
make DESTDIR=$PKG install

rm $PKG/usr/lib/libxapian.la
}
