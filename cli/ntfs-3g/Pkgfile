description="The Ntfs-3g package contains a stable, read-write open source driver for NTFS partitions."
url="https://www.ntfs-3g.org"

packager="spiky <spiky@nutyx.org>"
contributors="Pierre,Tnut"

makedepends=(libtool autoconf automake libgcrypt)

name=ntfs-3g
version=2022.10.3
release=4

source=(https://github.com/tuxera/ntfs-3g/archive/$version/$name-$version.tar.gz)

build() {

cd ${name}-$version
./autogen.sh
./configure --prefix=/usr \
--disable-static    \
--libdir=/usr/lib   \
--bindir=/usr/bin   \
--sbindir=/usr/bin \
--with-fuse-internal

make

mkdir $PKG/lib
make DESTDIR=$PKG install
ln -s ../bin/ntfs-3g $PKG/usr/bin/mount.ntfs
ln -s ntfs-3g.8 $PKG/usr/share/man/man8/mount.ntfs.8
rm $PKG/usr/lib/lib$name.la
}
package() {
 rm $PKG/usr/lib/libntfs-3g.so
 rm -d $PKG/usr/lib/ntfs-3g
 mv $PKG/bin/* $PKG/usr/bin
 rm -d $PKG/bin
 mv $PKG/lib/* $PKG/usr/lib
 rm -d $PKG/lib
 ln -sv ../bin/lowntfs-3g $PKG/usr/bin/mount.lowntfs-3g
 ln -sv ../bin/ntfs-3g $PKG/usr/bin/mount.ntfs-3g
}
