description="The Ntfs-3g package contains a stable, read-write open source driver for NTFS partitions."
url="https://www.ntfs-3g.org"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre,Spiky"

makedepends=(libtool autoconf automake libgcrypt)

name=ntfs-3g
version=2022.10.3
release=5

source=(https://github.com/tuxera/ntfs-3g/archive/$version/$name-$version.tar.gz)

prepare() {
 cd $name-$version
 autoreconf -fiv
 sed 's|$(DESTDIR)/sbin|$(DESTDIR)/usr/bin|' -i {ntfsprogs,src}/Makefile.in
}

build() {

cd $name-$version

./configure --prefix=/usr \
--disable-static    \
--libdir=/usr/lib   \
--bindir=/usr/bin   \
--sbindir=/usr/bin  \
--with-fuse=internal

make

make DESTDIR=$PKG rootbindir=/usr/bin \
rootsbindir=/usr/bin rootlibdir=/usr/lib install
ln -s /usr/bin/ntfs-3g $PKG/usr/bin/mount.ntfs
ln -s ntfs-3g.8 $PKG/usr/share/man/man8/mount.ntfs.8

rm $PKG/usr/lib/lib$name.la
}
