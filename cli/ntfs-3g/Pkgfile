description="The Ntfs-3g package contains a stable, read-write open source driver for NTFS partitions."
url="https://www.ntfs-3g.org"

packager="tnut <tnut@nutyx.org>"
contributors="Pierre,Spiky"

name=ntfs-3g
version=2022.10.3
release=3

source=(http://tuxera.com/opensource/${name}_ntfsprogs-$version.tgz)
build() {
cd ${name}_ntfsprogs-$version
./configure --prefix=/usr \
--disable-static    \
--libdir=/usr/lib   \
--bindir=/usr/bin   \
--sbindir=/usr/sbin \
--with-fuse-internal
make
mkdir $PKG/lib
make DESTDIR=$PKG install
ln -s ../bin/ntfs-3g $PKG/usr/sbin/mount.ntfs
ln -s ntfs-3g.8 $PKG/usr/share/man/man8/mount.ntfs.8
rm $PKG/usr/lib/lib$name.la
}
package() {
 rm $PKG/usr/lib/libntfs-3g.so
 rm -d $PKG/usr/lib/ntfs-3g
 rm -r $PKG/sbin
 mv $PKG/bin/* $PKG/usr/bin
 rm -d $PKG/bin
 mv $PKG/lib/* $PKG/usr/lib
 rm -d $PKG/lib
 ln -sv ../bin/lowntfs-3g $PKG/usr/sbin/mount.lowntfs-3g
 ln -sv ../bin/ntfs-3g $PKG/usr/sbin/mount.ntfs-3g
}
