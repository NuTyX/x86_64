description='iAPI and commands for processing SPIR-V modules'
url='https://www.khronos.org/vulkan/'

license="APACHE"

packager="spiky <spiky@nutyx.org>"
contributors=""

makedepends=(cmake spirv-headers)

name=spirv-tools
version=1.4.304.0

source=(https://github.com/KhronosGroup/SPIRV-Tools/archive/vulkan-sdk-$version/SPIRV-Tools-$version.tar.gz)



prepare() {
mv SPIRV-Tools-vulkan-sdk-$version $name-$version
}


build() {
cd $name-$version
mkdir build
cd    build

cmake -GNinja \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_BUILD_TYPE=Release \
      -DSPIRV_WERROR=Off \
      -DBUILD_SHARED_LIBS=ON \
      -DSPIRV_TOOLS_BUILD_STATIC=OFF \
      -D SPIRV-Headers_SOURCE_DIR=/usr \
      ..

ninja
DESTDIR="${PKG}" ninja install

install -Dm644 ../LICENSE $PKG/usr/share/licenses/$name/LICENSE
}
