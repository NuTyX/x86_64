description='Automatically generates Rust FFI bindings to C (and some C++) libraries'
url='https://github.com/rust-lang/rust-bindgen'

packager="spiky <spiky@nutyx.org>"
contributors=""

makedepends=(rustc llvm)

name=rust-bindgen
version=0.71.0
release=2

source=(https://github.com/rust-lang/rust-bindgen/archive/v$version/$name-$version.tar.gz
        0001-Unbreak-shell-completion-and-version-without-header.patch)

prepare() {
cd $name-$version
patch -Np1 -i ../0001-Unbreak-shell-completion-and-version-without-header.patch

}

build() {
cd $name-$version

cargo build --release

install -Dt $PKG/usr/bin target/release/bindgen
}
